@{
    ViewData["Title"] = "Tableau de bord";
    var recents        = ViewBag.CollaborateursRecents as List<dynamic> ?? new List<dynamic>();
    var formations     = ViewBag.FormationsEnCours     as List<dynamic> ?? new List<dynamic>();
    var certifications = ViewBag.Certifications as List<SIRH.EY.Models.Inscription>
                         ?? new List<SIRH.EY.Models.Inscription>();

    /* Talent badge mapping — unchanged labels, replaced inline styles with ds-badge classes */
    string[] bCls = { "ds-badge-green", "ds-badge-amber", "ds-badge-blue", "ds-badge-red", "ds-badge-gray" };
    string[] bLbl = { "Haut potentiel", "En progression", "Expert", "Prioritaire", "Stable" };
    int ri = 0;
}

@section Styles {
<style>
/* ── Dashboard · page-scoped supplement ─────────────────────────────────
   Only patterns not covered by ds-* design system classes.              */

/* Cascade fix: ds-kpi sets border shorthand (Section 8) after
   ds-card-accent-* sets border-top (Section 6) in the design system.
   Double-class specificity wins regardless of order.                    */
.ds-kpi.ds-card-accent-yellow { border-top: 3px solid var(--ey-yellow); }
.ds-kpi.ds-card-accent-green  { border-top: 3px solid var(--green-600); }
.ds-kpi.ds-card-accent-amber  { border-top: 3px solid var(--amber-600); }
.ds-kpi.ds-card-accent-red    { border-top: 3px solid var(--red-600);   }

/* Quick action cells — solid surface + visible border so they read as
   pressable buttons rather than faint placeholders. */
.db-action {
    display: flex; flex-direction: column; align-items: center; justify-content: center;
    gap: var(--sp-2); padding: var(--sp-5) var(--sp-4);
    text-decoration: none; text-align: center; cursor: pointer;
    background: #ffffff; border: 1px solid var(--ds-border);
    border-radius: var(--radius-lg);
    box-shadow: 0 1px 2px rgba(15, 23, 42, 0.04);
    transition:
        background   var(--dur-fast) var(--ease-out),
        border-color var(--dur-fast) var(--ease-out),
        box-shadow   var(--dur-fast) var(--ease-out);
}
.db-action:hover {
    background: var(--ey-yellow-subtle);
    border-color: var(--ey-yellow);
    box-shadow: var(--shadow-2);
    text-decoration: none;
}
.db-action:focus-visible {
    outline: 2px solid var(--ey-yellow); outline-offset: 2px;
}
.db-action i {
    font-size: 20px; color: var(--ey-navy);
    transition: transform var(--dur-normal) var(--ease-spring);
}
.db-action:hover i { transform: scale(1.12); }
.db-action-lbl {
    font-size: var(--text-sm); font-weight: var(--fw-semibold);
    color: var(--ds-text); line-height: var(--leading-snug);
}
.db-action-disabled {
    cursor: not-allowed; opacity: 0.55;
}
.db-action-disabled:hover {
    background: #ffffff; border-color: var(--ds-border); box-shadow: 0 1px 2px rgba(15, 23, 42, 0.04);
}
.db-action-disabled:hover i { transform: none; }

/* Table-like card rows (talent list, deadlines, certifications) */
.db-row {
    display: flex; align-items: center; gap: var(--sp-3);
    padding: 11px var(--sp-5);
    border-bottom: 1px solid var(--ds-border);
    transition: background var(--dur-fast);
}
.db-row:last-child { border-bottom: none; }
.db-row:hover { background: var(--ds-bg); }

/* Insight block sub-headings */
.db-insight-label {
    font-size: var(--text-xs); font-weight: var(--fw-bold);
    letter-spacing: var(--tracking-wider); text-transform: uppercase;
    margin-bottom: var(--sp-3);
    display: flex; align-items: center; gap: var(--sp-2);
}

/* Department bar rows */
.db-bar-row { display: flex; flex-direction: column; gap: var(--sp-2); }
.db-bar-head {
    display: flex; justify-content: space-between;
    font-size: var(--text-base); font-weight: var(--fw-semibold); color: var(--ds-text);
}
</style>
}

<div>

<!-- ══ PAGE HEADER ═══════════════════════════════════════════════════════ -->
<div class="ds-page-bar">
    <div style="flex:1;min-width:0">
        <div class="ds-h3">Bonjour, @(ViewBag.PrenomConnecte ?? "Collaborateur")</div>
        <div class="ds-caption" style="margin-top:var(--sp-1)">
            Bienvenue dans votre hub de croissance. Connectez vos compétences, pilotez vos ambitions et façonnez l'avenir de vos projets chez EY —
            <span style="text-transform:capitalize">@DateTime.Now.ToString("dddd dd MMMM yyyy", new System.Globalization.CultureInfo("fr-FR"))</span>
        </div>
    </div>
    <div class="ds-page-bar-right">
        <button class="ds-btn ds-btn-primary ds-btn-lg"
                onclick="document.getElementById('chatbot-launcher')?.click()" type="button">
            <i class="fas fa-robot"></i> Consulter l'assistant EY SIRH
        </button>
    </div>
</div>

<!-- ══ KPI ROW ════════════════════════════════════════════════════════════ -->
<div class="row g-3 mb-4">
    <div class="col-6 col-md-3">
        <div class="ds-kpi ds-card-accent-yellow" data-ds-animate="ds-animate-fade-up" style="animation-delay:0ms">
            <div class="ds-kpi-head">
                <span class="ds-kpi-icon-badge"><i class="fas fa-users"></i></span>
                <div class="ds-kpi-label">Collaborateurs actifs</div>
            </div>
            <div class="ds-kpi-value" data-ds-counter="@ViewBag.NbCollaborateursActifs">0</div>
            <div class="ds-kpi-trend ds-kpi-trend-up">
                <i class="fas fa-arrow-up"></i> 12% vs mois dernier
            </div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="ds-kpi ds-card-accent-green" data-ds-animate="ds-animate-fade-up" style="animation-delay:60ms">
            <div class="ds-kpi-head">
                <span class="ds-kpi-icon-badge"><i class="fas fa-graduation-cap"></i></span>
                <div class="ds-kpi-label">Formations suivies</div>
            </div>
            <div class="ds-kpi-value" data-ds-counter="@ViewBag.NbFormationsSuivies">0</div>
            <div class="ds-kpi-trend ds-kpi-trend-flat">
                <i class="fas fa-minus"></i> Stable
            </div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="ds-kpi ds-card-accent-amber" data-ds-animate="ds-animate-fade-up" style="animation-delay:120ms">
            <div class="ds-kpi-head">
                <span class="ds-kpi-icon-badge"><i class="fas fa-percent"></i></span>
                <div class="ds-kpi-label">Taux de complétion</div>
            </div>
            <div class="ds-kpi-value"
                 data-ds-counter="@ViewBag.TauxCompletion"
                 data-ds-counter-suffix="%">0</div>
            <div class="ds-kpi-trend ds-kpi-trend-up">
                <i class="fas fa-arrow-up"></i> 5% ce trimestre
            </div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="ds-kpi ds-card-accent-red" data-ds-animate="ds-animate-fade-up" style="animation-delay:180ms">
            <div class="ds-kpi-head">
                <span class="ds-kpi-icon-badge"><i class="fas fa-certificate"></i></span>
                <div class="ds-kpi-label">Certifications</div>
            </div>
            <div class="ds-kpi-value" data-ds-counter="@certifications.Count">0</div>
            <div class="ds-kpi-trend ds-kpi-trend-up">
                <i class="fas fa-arrow-up"></i> Nouvelles ce mois
            </div>
        </div>
    </div>
</div>

<!-- ══ MAIN GRID ══════════════════════════════════════════════════════════ -->
<div class="row g-3">

    <!-- ── Left column ─────────────────────────────────────────────────── -->
    <div class="col-lg-8">

        <!-- AI Insights -->
        <div class="ds-card mb-3" data-ds-animate="ds-animate-fade-up" style="animation-delay:80ms">
            <div class="ds-card-header">
                <div class="ds-ai-pulse">Analyse &amp; recommandations</div>
            </div>
            <div class="ds-card-body ds-card-body-sm">
                <div class="row g-3">
                    <div class="col-md-6">
                        <div class="ds-ai-card">
                            <div class="db-insight-label" style="color:var(--amber-600)">
                                <i class="fas fa-exclamation-triangle"></i> Risques RH
                            </div>
                            <div id="si-talent" class="ds-ai-card-body">Analyse en cours…</div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="ds-ai-card">
                            <div class="db-insight-label" style="color:var(--green-600)">
                                <i class="fas fa-lightbulb"></i> Recommandation clé
                            </div>
                            <div id="si-formations" class="ds-ai-card-body">
                                Complétez <strong>« Leadership Avancé »</strong> pour renforcer votre score d'évolution de carrière.
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Collaborateurs récents -->
        <div class="ds-card mb-3" data-ds-animate="ds-animate-fade-up" style="animation-delay:140ms">
            <div class="ds-card-header">
                <span class="ds-overline">Collaborateurs récents</span>
                <a asp-controller="Collaborateurs" asp-action="Index" class="ds-link" style="font-size:var(--text-sm)">
                    Voir tous <i class="fas fa-arrow-right ms-1" style="font-size:9px"></i>
                </a>
            </div>
            @if (!recents.Any())
            {
                <div class="ds-empty ds-empty-sm">
                    <div class="ds-empty-body">Aucun collaborateur récent.</div>
                </div>
            }
            @foreach (var r in recents.Take(5))
            {
                string fn  = Convert.ToString(r.Prenom) ?? "";
                string ln  = Convert.ToString(r.Nom)    ?? "";
                string av  = (fn.Length > 0 ? fn[0].ToString() : "") + (ln.Length > 0 ? ln[0].ToString() : "");
                string po  = Convert.ToString(r.Poste)  ?? "";
                int    idx = ri % 5;
                <div class="db-row">
                    <div class="ds-avatar ds-avatar-circle">@av.ToUpper()</div>
                    <div class="ds-flex-1 ds-min-0">
                        <div style="font-size:var(--text-base);font-weight:var(--fw-semibold);color:var(--ds-text);line-height:var(--leading-snug)">@fn @ln</div>
                        <div class="ds-caption ds-truncate">@po</div>
                    </div>
                    <span class="ds-badge @bCls[idx]">@bLbl[idx]</span>
                </div>
                ri++;
            }
        </div>

        <!-- Quick Actions -->
        <div class="ds-card mb-3" data-ds-animate="ds-animate-fade-up" style="animation-delay:200ms">
            <div class="ds-card-header">
                <span class="ds-overline">Actions rapides</span>
            </div>
            <div class="ds-card-body ds-card-body-sm">
                <div class="row g-2">
                    <div class="col-4">
                        <a asp-controller="Collaborateurs" asp-action="Index" class="db-action">
                            <i class="fas fa-users"></i>
                            <span class="db-action-lbl">Voir mon équipe</span>
                        </a>
                    </div>
                    <div class="col-4">
                        <a asp-controller="Formations" asp-action="Index" class="db-action">
                            <i class="fas fa-graduation-cap"></i>
                            <span class="db-action-lbl">Mes formations</span>
                        </a>
                    </div>
                    <div class="col-4">
                        <a asp-controller="Competences" asp-action="Index" class="db-action">
                            <i class="fas fa-chart-bar"></i>
                            <span class="db-action-lbl">Mes compétences</span>
                        </a>
                    </div>
                    <div class="col-4">
                        @if (ViewBag.OwnCollaborateurId != null)
                        {
                            <a asp-controller="Formations" asp-action="ParcoursCarriere" asp-route-collaborateurId="@ViewBag.OwnCollaborateurId" class="db-action">
                                <i class="fas fa-tachometer-alt"></i>
                                <span class="db-action-lbl">Mon évolution</span>
                            </a>
                        }
                        else
                        {
                            <span class="db-action db-action-disabled" title="Profil collaborateur non lié à ce compte">
                                <i class="fas fa-tachometer-alt"></i>
                                <span class="db-action-lbl">Mon évolution</span>
                            </span>
                        }
                    </div>
                    <div class="col-4">
                        <a asp-controller="Talent" asp-action="MyOKRs" class="db-action">
                            <i class="fas fa-bullseye"></i>
                            <span class="db-action-lbl">Mes objectifs RH</span>
                        </a>
                    </div>
                    <div class="col-4">
                        <a asp-controller="Reporting" asp-action="ExecutiveDashboard" class="db-action">
                            <i class="fas fa-chart-line"></i>
                            <span class="db-action-lbl">Reporting</span>
                        </a>
                    </div>
                </div>
            </div>
        </div>

    </div>

    <!-- ── Right column ────────────────────────────────────────────────── -->
    <div class="col-lg-4">

        <!-- Échéances -->
        <div class="ds-card mb-3" data-ds-animate="ds-animate-fade-up" style="animation-delay:100ms">
            <div class="ds-card-header">
                <span class="ds-overline">Échéances à venir</span>
            </div>

            <div class="db-row">
                <span style="width:8px;height:8px;border-radius:50%;background:var(--red-600);flex-shrink:0;display:inline-block"></span>
                <div class="ds-flex-1 ds-min-0">
                    <div style="font-size:var(--text-base);font-weight:var(--fw-semibold);color:var(--ds-text)">Bilan de mi-année</div>
                    <div class="ds-caption">15 Juin @DateTime.Now.Year</div>
                </div>
                <span class="ds-badge ds-badge-red">Dans 5 j</span>
            </div>

            <div class="db-row">
                <span style="width:8px;height:8px;border-radius:50%;background:var(--amber-500);flex-shrink:0;display:inline-block"></span>
                <div class="ds-flex-1 ds-min-0">
                    <div style="font-size:var(--text-base);font-weight:var(--fw-semibold);color:var(--ds-text)">Formations à venir</div>
                    <div class="ds-caption">23 Juin @DateTime.Now.Year</div>
                </div>
                <span class="ds-badge ds-badge-amber">Dans 12 j</span>
            </div>

            @foreach (var f in formations.Take(2))
            {
                <div class="db-row">
                    <span style="width:8px;height:8px;border-radius:50%;background:var(--green-600);flex-shrink:0;display:inline-block"></span>
                    <div class="ds-flex-1 ds-min-0">
                        <div class="ds-truncate" style="font-size:var(--text-base);font-weight:var(--fw-semibold);color:var(--ds-text)">@f.Titre</div>
                        <div class="ds-caption">Reste @f.JoursRestants jours</div>
                    </div>
                    <span class="ds-badge ds-badge-green">@f.Progression%</span>
                </div>
            }
        </div>

        <!-- Répartition par département -->
        <div class="ds-card mb-3" data-ds-animate="ds-animate-fade-up" style="animation-delay:160ms">
            <div class="ds-card-header">
                <span class="ds-overline">Répartition par département</span>
            </div>
            <div class="ds-card-body ds-card-body-sm">
                <div style="display:flex;flex-direction:column;gap:var(--sp-4)">

                    <div class="db-bar-row">
                        <div class="db-bar-head">
                            <span>Audit</span>
                            <span class="ds-caption">38</span>
                        </div>
                        <div class="ds-progress">
                            <div class="ds-progress-bar ds-progress-bar-yellow"
                                 data-ds-progress="75" style="width:0%"></div>
                        </div>
                    </div>

                    <div class="db-bar-row">
                        <div class="db-bar-head">
                            <span>Conseil</span>
                            <span class="ds-caption">29</span>
                        </div>
                        <div class="ds-progress">
                            <div class="ds-progress-bar ds-progress-bar-green"
                                 data-ds-progress="58" style="width:0%"></div>
                        </div>
                    </div>

                    <div class="db-bar-row">
                        <div class="db-bar-head">
                            <span>Fiscalité</span>
                            <span class="ds-caption">21</span>
                        </div>
                        <div class="ds-progress">
                            <div class="ds-progress-bar"
                                 data-ds-progress="42" style="width:0%"></div>
                        </div>
                    </div>

                    <div class="db-bar-row">
                        <div class="db-bar-head">
                            <span>Transaction</span>
                            <span class="ds-caption">17</span>
                        </div>
                        <div class="ds-progress">
                            <div class="ds-progress-bar ds-progress-bar-amber"
                                 data-ds-progress="34" style="width:0%"></div>
                        </div>
                    </div>

                    <div class="db-bar-row">
                        <div class="db-bar-head">
                            <span>Technologie</span>
                            <span class="ds-caption">12</span>
                        </div>
                        <div class="ds-progress">
                            <div class="ds-progress-bar ds-progress-bar-red"
                                 data-ds-progress="24" style="width:0%"></div>
                        </div>
                    </div>

                </div>
            </div>
        </div>

        <!-- Certifications obtenues -->
        <div class="ds-card" data-ds-animate="ds-animate-fade-up" style="animation-delay:220ms">
            <div class="ds-card-header">
                <span class="ds-overline">Certifications obtenues</span>
                <a asp-controller="Formations" asp-action="Index" class="ds-link" style="font-size:var(--text-sm)">
                    Voir <i class="fas fa-arrow-right ms-1" style="font-size:9px"></i>
                </a>
            </div>
            @if (!certifications.Any())
            {
                <div class="ds-empty ds-empty-sm">
                    <div class="ds-empty-body">Aucune certification pour le moment.</div>
                </div>
            }
            @foreach (var c in certifications.Take(4))
            {
                <div class="db-row">
                    <span style="width:7px;height:7px;border-radius:50%;background:var(--ey-yellow);flex-shrink:0;display:inline-block"></span>
                    <span class="ds-truncate" style="font-size:var(--text-base);color:var(--ds-text-2)">@c.Formation?.Titre</span>
                </div>
            }
        </div>

    </div>

</div><!-- /row -->
</div><!-- /root -->

@section Scripts {
<script>
(function () {
    'use strict';

    function setText(id, txt) {
        var el = document.getElementById(id);
        if (el) el.textContent = txt;
    }

    // Stats endpoint — updates insights blocks
    fetch('/api/chatbot/stats')
        .then(function (r) { return r.ok ? r.json() : null; })
        .then(function (s) {
            if (!s) return;
            var fec = s.formationsEnCours || 0;
            setText('si-formations',
                fec + ' formation' + (fec > 1 ? 's' : '') +
                ' en attente de clôture. Complétez « Leadership Avancé » pour renforcer votre score d\'évolution.');
        })
        .catch(function () {});

    // Talent endpoint — updates risk block
    fetch('/api/chatbot/hr-talent')
        .then(function (r) { return r.ok ? r.json() : null; })
        .then(function (data) {
            if (!data || !Array.isArray(data)) {
                setText('si-talent', 'Analyse talent indisponible.');
                return;
            }
            var n = data.length;
            setText('si-talent',
                n + ' talent' + (n > 1 ? 's' : '') +
                ' à fort potentiel identifié' + (n > 1 ? 's' : '') + ' dans votre organisation.');
        })
        .catch(function () { setText('si-talent', 'Analyse talent indisponible.'); });
})();
</script>
}
