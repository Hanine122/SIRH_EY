@{
    ViewData["Title"] = "Tableau de bord";
    var recents        = ViewBag.CollaborateursRecents as List<dynamic> ?? new List<dynamic>();
    var formations     = ViewBag.FormationsEnCours     as List<dynamic> ?? new List<dynamic>();
    var certifications = ViewBag.Certifications as List<SIRH.EY.Models.Inscription>
                         ?? new List<SIRH.EY.Models.Inscription>();
}

@section Styles {
<style>
/* ────────────────────────────────────────────────────────────
   EY Dashboard — Enterprise flat design
   Primary dark : #2E2E38   Accent yellow : #FFE600
   Border       : 0.5px solid #E8E8EE
   ──────────────────────────────────────────────────────────── */

/* page header */
.d-header          { padding-bottom: 20px; border-bottom: 0.5px solid #E8E8EE; margin-bottom: 24px; }
.d-greeting        { font-size: 22px; font-weight: 600; color: #2E2E38; line-height: 1.2; }
.d-subline         { font-size: 12px; color: #6E6E79; margin-top: 3px; text-transform: capitalize; }
.d-cta             { background: #FFE600; color: #2E2E38; border: none; border-radius: 6px;
                     padding: 9px 20px; font-size: 13px; font-weight: 600; cursor: pointer; white-space: nowrap; }
.d-cta:hover       { background: #f0d800; }

/* flat card base */
.fc                { background: #fff; border-radius: 10px; border: 0.5px solid #E8E8EE; padding: 16px; margin-bottom: 12px; }

/* KPI cards */
.kpi-c             { background: #fff; border-radius: 10px; padding: 16px;
                     border: 0.5px solid #E8E8EE; border-top-width: 2px; }
.kpi-c.c-yellow    { border-top-color: #FFE600; }
.kpi-c.c-green     { border-top-color: #22C55E; }
.kpi-c.c-amber     { border-top-color: #F59E0B; }
.kpi-c.c-red       { border-top-color: #EF4444; }
.kpi-lbl           { font-size: 11px; text-transform: uppercase; color: #9B9BAA; letter-spacing: .06em; margin-bottom: 8px; }
.kpi-val           { font-size: 26px; font-weight: 500; color: #2E2E38; line-height: 1; margin-bottom: 6px; }
.kpi-val small     { font-size: 15px; font-weight: 400; color: #9B9BAA; }
.kpi-delta         { font-size: 12px; color: #6E6E79; display: flex; align-items: center; gap: 4px; }
.kpi-delta .up     { color: #22C55E; }
.kpi-delta .nt     { color: #9B9BAA; }
.kpi-delta .dn     { color: #EF4444; }

/* section label */
.sec-lbl           { font-size: 11px; font-weight: 700; text-transform: uppercase;
                     letter-spacing: .08em; color: #9B9BAA; margin-bottom: 12px; }

/* insight sub-blocks */
.ib                { background: #FAFAFA; border: 0.5px solid #E8E8EE; border-radius: 8px; padding: 14px; flex: 1; }
.ib-title          { font-size: 11px; font-weight: 600; text-transform: uppercase;
                     letter-spacing: .06em; color: #9B9BAA; margin-bottom: 8px; }
.ib-text           { font-size: 13px; color: #2E2E38; line-height: 1.55; }

/* talent list */
.ta-row            { display: flex; align-items: center; gap: 10px; padding: 9px 0; border-bottom: 0.5px solid #F1F1F5; }
.ta-row:last-child { border-bottom: none; }
.ta-av             { width: 34px; height: 34px; border-radius: 50%; background: #2E2E38;
                     color: #FFE600; font-size: 11px; font-weight: 700; flex-shrink: 0;
                     display: flex; align-items: center; justify-content: center; letter-spacing: .04em; }
.ta-name           { font-size: 13px; font-weight: 500; color: #2E2E38; line-height: 1.2; }
.ta-role           { font-size: 11px; color: #9B9BAA; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.ta-pill           { font-size: 11px; font-weight: 500; border-radius: 12px; padding: 2px 9px; white-space: nowrap; flex-shrink: 0; }

/* quick actions */
.qa-grid           { display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px; }
.qa-cell           { display: flex; flex-direction: column; align-items: center; justify-content: center;
                     background: #F5F5F0; border: 0.5px solid transparent; border-radius: 8px;
                     padding: 16px 8px; text-decoration: none; gap: 7px;
                     transition: background .13s, border-color .13s; }
.qa-cell:hover     { background: #FFFBE6; border-color: #FFE600; }
.qa-cell i         { font-size: 20px; color: #2E2E38; }
.qa-lbl            { font-size: 11px; color: #2E2E38; font-weight: 500; text-align: center; line-height: 1.3; }

/* deadline rows */
.dl-row            { display: flex; align-items: flex-start; gap: 10px; padding: 8px 0; border-bottom: 0.5px solid #F1F1F5; }
.dl-row:last-child { border-bottom: none; }
.dl-dot            { width: 8px; height: 8px; border-radius: 50%; flex-shrink: 0; margin-top: 4px; }
.dl-name           { font-size: 13px; font-weight: 500; color: #2E2E38; line-height: 1.3; }
.dl-date           { font-size: 11px; color: #9B9BAA; }
.dl-cnt            { font-size: 11px; font-weight: 600; white-space: nowrap; margin-left: auto; flex-shrink: 0; }

/* dept progress bars */
.dp-row            { margin-bottom: 11px; }
.dp-row:last-child { margin-bottom: 0; }
.dp-head           { display: flex; justify-content: space-between; font-size: 12px;
                     color: #2E2E38; font-weight: 500; margin-bottom: 4px; }
.dp-cnt            { font-size: 11px; color: #9B9BAA; }
.dp-track          { height: 4px; background: #F1EFE8; border-radius: 2px; overflow: hidden; }
.dp-fill           { height: 100%; border-radius: 2px; }

/* cert list */
.cert-row            { display: flex; align-items: center; gap: 9px; padding: 7px 0;
                       border-bottom: 0.5px solid #F1F1F5; font-size: 12px; color: #2E2E38; }
.cert-row:last-child { border-bottom: none; }
.cert-dot            { width: 6px; height: 6px; border-radius: 50%; background: #FFE600; flex-shrink: 0; }

/* misc */
.see-all           { font-size: 12px; color: #2E2E38; text-decoration: none; font-weight: 500; }
.see-all:hover     { color: #000; }
</style>
}

<div>

    <!-- ── Page Header ──────────────────────────────────────────────────────── -->
    <div class="d-header d-flex justify-content-between align-items-center">
        <div>
            <div class="d-greeting">Bonjour, @(ViewBag.PrenomConnecte ?? "Collaborateur")</div>
            <div class="d-subline">
               Bienvenue dans votre hub de croissance. Connectez vos compétences, pilotez vos ambitions et façonnez l'avenir de vos projets chez EY  — @DateTime.Now.ToString("dddd dd MMMM yyyy", new System.Globalization.CultureInfo("fr-FR"))
            </div>
        </div>
        <button class="d-cta" onclick="document.getElementById('chatbot-launcher')?.click()" type="button">
            Consulter l'assistant EY SIRH
        </button>
    </div>

    <!-- ── KPI Row ──────────────────────────────────────────────────────────── -->
    <div class="row g-3 mb-4">
        <div class="col-6 col-md-3">
            <div class="kpi-c c-yellow">
                <div class="kpi-lbl">Collaborateurs actifs</div>
                <div class="kpi-val">@ViewBag.NbCollaborateursActifs</div>
                <div class="kpi-delta">
                    <span class="up"><i class="fas fa-arrow-up" style="font-size:9px;"></i> 12%</span>
                    <span>vs mois dernier</span>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="kpi-c c-green">
                <div class="kpi-lbl">Formations suivies</div>
                <div class="kpi-val">@ViewBag.NbFormationsSuivies</div>
                <div class="kpi-delta">
                    <span class="nt"><i class="fas fa-minus" style="font-size:9px;"></i> Stable</span>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="kpi-c c-amber">
                <div class="kpi-lbl">Taux de complétion</div>
                <div class="kpi-val">@ViewBag.TauxCompletion<small>%</small></div>
                <div class="kpi-delta">
                    <span class="up"><i class="fas fa-arrow-up" style="font-size:9px;"></i> 5%</span>
                    <span>ce trimestre</span>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="kpi-c c-red">
                <div class="kpi-lbl">Certifications</div>
                <div class="kpi-val">@certifications.Count</div>
                <div class="kpi-delta">
                    <span class="up"><i class="fas fa-arrow-up" style="font-size:9px;"></i> Nouvelles</span>
                    <span>ce mois</span>
                </div>
            </div>
        </div>
    </div>

    <!-- ── Main Grid ────────────────────────────────────────────────────────── -->
    <div class="row g-3">

        <!-- Left column (1fr) -->
        <div class="col-lg-8">

            <!-- Insights: risk + recommendation -->
            <div class="fc">
                <div class="sec-lbl">Analyse & recommandations</div>
                <div class="d-flex gap-3">
                    <div class="ib">
                        <div class="ib-title">
                            <i class="fas fa-exclamation-triangle me-1" style="color:#F59E0B;"></i>Risques RH
                        </div>
                        <div class="ib-text" id="si-talent">Analyse en cours…</div>
                    </div>
                    <div class="ib">
                        <div class="ib-title">
                            <i class="fas fa-lightbulb me-1" style="color:#22C55E;"></i>Recommandation clé
                        </div>
                        <div class="ib-text" id="si-formations">
                            Complétez <strong>"Leadership Avancé"</strong> pour renforcer votre score d'évolution de carrière.
                        </div>
                    </div>
                </div>
            </div>

            <!-- Talent list -->
            <div class="fc">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <div class="sec-lbl mb-0">Collaborateurs récents</div>
                    <a asp-controller="Collaborateurs" asp-action="Index" class="see-all">
                        Voir tous <i class="fas fa-arrow-right ms-1" style="font-size:9px;"></i>
                    </a>
                </div>
                @{
                    string[] bBg  = { "#F0FDF4", "#FFFBEB", "#EEF2FF", "#FFF1F2", "#F0F9FF" };
                    string[] bTx  = { "#16A34A", "#B45309", "#4F46E5", "#BE123C", "#0369A1" };
                    string[] bLbl = { "Haut potentiel", "En progression", "Expert", "Prioritaire", "Stable" };
                    int ri = 0;
                }
                @if (!recents.Any())
                {
                    <div style="font-size:13px;color:#9B9BAA;">Aucun collaborateur récent.</div>
                }
                @foreach (var r in recents.Take(5))
                {
                    string fn = Convert.ToString(r.Prenom) ?? "";
                    string ln = Convert.ToString(r.Nom)    ?? "";
                    string av = (fn.Length > 0 ? fn[0].ToString() : "") + (ln.Length > 0 ? ln[0].ToString() : "");
                    string po = Convert.ToString(r.Poste)  ?? "";
                    int idx   = ri % 5;
                    <div class="ta-row">
                        <div class="ta-av">@av.ToUpper()</div>
                        <div style="flex:1;min-width:0;">
                            <div class="ta-name">@fn @ln</div>
                            <div class="ta-role">@po</div>
                        </div>
                        <span class="ta-pill" style="background:@bBg[idx];color:@bTx[idx];">@bLbl[idx]</span>
                    </div>
                    ri++;
                }
            </div>

            <!-- Quick actions 3×2 -->
            <div class="fc">
                <div class="sec-lbl">Actions rapides</div>
                <div class="qa-grid">
                    <a asp-controller="Collaborateurs" asp-action="Index" class="qa-cell">
                        <i class="fas fa-users"></i>
                        <span class="qa-lbl">Voir mon équipe</span>
                    </a>
                    <a asp-controller="Formations" asp-action="Index" class="qa-cell">
                        <i class="fas fa-graduation-cap"></i>
                        <span class="qa-lbl">Mes formations</span>
                    </a>
                    <a asp-controller="Competences" asp-action="Index" class="qa-cell">
                        <i class="fas fa-chart-bar"></i>
                        <span class="qa-lbl">Mes compétences</span>
                    </a>
                    <a asp-controller="Progression" asp-action="Index" class="qa-cell">
                        <i class="fas fa-tachometer-alt"></i>
                        <span class="qa-lbl">Mon évolution</span>
                    </a>
                    <a asp-controller="Objectives" asp-action="Index" class="qa-cell">
                        <i class="fas fa-bullseye"></i>
                        <span class="qa-lbl">Mes objectifs RH</span>
                    </a>
                    <a asp-controller="Reporting" asp-action="ExecutiveDashboard" class="qa-cell">
                        <i class="fas fa-chart-line"></i>
                        <span class="qa-lbl">Reporting</span>
                    </a>
                </div>
            </div>

        </div>

        <!-- Right column (~280px) -->
        <div class="col-lg-4">

            <!-- Deadlines -->
            <div class="fc">
                <div class="sec-lbl">Échéances à venir</div>
                <div class="dl-row">
                    <div class="dl-dot" style="background:#EF4444;"></div>
                    <div style="flex:1;min-width:0;">
                        <div class="dl-name">Bilan de mi-année</div>
                        <div class="dl-date">15 Juin @DateTime.Now.Year</div>
                    </div>
                    <div class="dl-cnt" style="color:#EF4444;">Dans 5 j</div>
                </div>
                <div class="dl-row">
                    <div class="dl-dot" style="background:#F59E0B;"></div>
                    <div style="flex:1;min-width:0;">
                        <div class="dl-name">Formations à venir</div>
                        <div class="dl-date">23 Juin @DateTime.Now.Year</div>
                    </div>
                    <div class="dl-cnt" style="color:#F59E0B;">Dans 12 j</div>
                </div>
                @foreach (var f in formations.Take(2))
                {
                    <div class="dl-row">
                        <div class="dl-dot" style="background:#22C55E;"></div>
                        <div style="flex:1;min-width:0;">
                            <div class="dl-name" style="overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">@f.Titre</div>
                            <div class="dl-date">Reste @f.JoursRestants jours</div>
                        </div>
                        <div class="dl-cnt" style="color:#22C55E;">@f.Progression%</div>
                    </div>
                }
            </div>

            <!-- Department distribution -->
            <div class="fc">
                <div class="sec-lbl">Répartition par département</div>
                <div class="dp-row">
                    <div class="dp-head"><span>Audit</span><span class="dp-cnt">38</span></div>
                    <div class="dp-track"><div class="dp-fill" style="width:75%;background:#FFE600;"></div></div>
                </div>
                <div class="dp-row">
                    <div class="dp-head"><span>Conseil</span><span class="dp-cnt">29</span></div>
                    <div class="dp-track"><div class="dp-fill" style="width:58%;background:#22C55E;"></div></div>
                </div>
                <div class="dp-row">
                    <div class="dp-head"><span>Fiscalité</span><span class="dp-cnt">21</span></div>
                    <div class="dp-track"><div class="dp-fill" style="width:42%;background:#6366F1;"></div></div>
                </div>
                <div class="dp-row">
                    <div class="dp-head"><span>Transaction</span><span class="dp-cnt">17</span></div>
                    <div class="dp-track"><div class="dp-fill" style="width:34%;background:#F59E0B;"></div></div>
                </div>
                <div class="dp-row">
                    <div class="dp-head"><span>Technologie</span><span class="dp-cnt">12</span></div>
                    <div class="dp-track"><div class="dp-fill" style="width:24%;background:#EF4444;"></div></div>
                </div>
            </div>

            <!-- Certifications -->
            <div class="fc">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <div class="sec-lbl mb-0">Certifications obtenues</div>
                    <a asp-controller="Formations" asp-action="Index" class="see-all">
                        Voir <i class="fas fa-arrow-right ms-1" style="font-size:9px;"></i>
                    </a>
                </div>
                @if (!certifications.Any())
                {
                    <div style="font-size:13px;color:#9B9BAA;">Aucune certification pour le moment.</div>
                }
                @foreach (var c in certifications.Take(4))
                {
                    <div class="cert-row">
                        <div class="cert-dot"></div>
                        <span style="overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">@c.Formation?.Titre</span>
                    </div>
                }
            </div>

        </div>
    </div>
</div>

@section Scripts {
<script>
(function () {
    'use strict';

    function setText(id, txt) {
        var el = document.getElementById(id);
        if (el) el.textContent = txt;
    }

    // Stats endpoint — updates insights blocks
    fetch('/api/chatbot/stats')
        .then(function (r) { return r.ok ? r.json() : null; })
        .then(function (s) {
            if (!s) return;
            var fec = s.formationsEnCours || 0;
            setText('si-formations',
                fec + ' formation' + (fec > 1 ? 's' : '') +
                ' en attente de clôture. Complétez « Leadership Avancé » pour renforcer votre score d\'évolution.');
        })
        .catch(function () {});

    // Talent endpoint — updates risk block
    fetch('/api/chatbot/hr-talent')
        .then(function (r) { return r.ok ? r.json() : null; })
        .then(function (data) {
            if (!data || !Array.isArray(data)) {
                setText('si-talent', 'Analyse talent indisponible.');
                return;
            }
            var n = data.length;
            setText('si-talent',
                n + ' talent' + (n > 1 ? 's' : '') +
                ' à fort potentiel identifié' + (n > 1 ? 's' : '') + ' dans votre organisation.');
        })
        .catch(function () { setText('si-talent', 'Analyse talent indisponible.'); });
})();
</script>
}
