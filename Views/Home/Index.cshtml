@{
    ViewData["Title"] = "Tableau de bord";
    var recents = ViewBag.CollaborateursRecents as List<dynamic> ?? new List<dynamic>();
    var formations = ViewBag.FormationsEnCours as List<dynamic> ?? new List<dynamic>();
    var certifications = ViewBag.Certifications as List<SIRH.EY.Models.Inscription> ?? new List<SIRH.EY.Models.Inscription>();
}

<div class="row portal-wrapper g-4">
    <!-- LEFT COLUMN: Workspace -->
    <div class="col-lg-8 portal-left">
        
        <!-- 1. Smart Welcome Banner -->
        <div class="hero-banner glass-panel p-4 mb-2">
            <div class="hero-content">
                <div class="d-flex flex-column flex-sm-row justify-content-between align-items-start gap-2 mb-3">
                    <div>
                        <div class="ai-hero-kicker">
                            <span class="ai-status-dot"></span>Assistant RH Intelligent actif
                        </div>
                        <h1 class="h2 fw-bold mb-0"> Bonjour, @(ViewBag.PrenomConnecte ?? "Collaborateur")</h1>
                    </div>
                    <div class="small text-muted flex-shrink-0 d-none d-sm-block" style="padding-top:2px;text-transform:capitalize;">
                        @DateTime.Now.ToString("dddd dd MMMM", new System.Globalization.CultureInfo("fr-FR"))
                    </div>
                </div>
                <div class="d-flex flex-wrap gap-2 mb-4">
                    <span class="ai-insight-chip ai-insight-chip--green">
                        <i class="fas fa-graduation-cap"></i>
                        <strong>@formations.Count</strong>&thinsp;formation@(formations.Count != 1 ? "s" : "") en cours
                    </span>
                    <span class="ai-insight-chip ai-insight-chip--amber">
                        <i class="fas fa-star"></i>
                        <span id="hero-chip-talent-txt" class="ai-chip-loading">Talents…</span>
                    </span>
                    <span class="ai-insight-chip ai-insight-chip--blue">
                        <i class="fas fa-chart-line"></i>
                        <span id="hero-chip-perf-txt" class="ai-chip-loading">Performance…</span>
                    </span>
                </div>
                <button class="ai-hero-cta-btn" onclick="document.getElementById('chatbot-launcher')?.click()" type="button">
                    ✨ Consulter l'assistant IA
                </button>
            </div>
        </div>

        <!-- 2. KPI Cards -->
        <div class="row g-3 mb-2">
            <div class="col-md-4">
                <div class="glass-panel kpi-card kpi-card-actives">
                    <i class="fas fa-users kpi-icon"></i>
                    <div class="kpi-label mb-1">COLLABORATEURS ACTIFS</div>
                    <div class="kpi-value">@ViewBag.NbCollaborateursActifs</div>
                    <div class="d-flex justify-content-between align-items-center mb-1">
                        <span class="small text-success fw-semibold"><i class="fas fa-arrow-up"></i> 12%</span>
                    </div>
                    <div class="progress-animated mt-2"><div class="progress-bar" style="width: 78%"></div></div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="glass-panel kpi-card kpi-card-trainings">
                    <i class="fas fa-graduation-cap kpi-icon"></i>
                    <div class="kpi-label mb-1">FORMATIONS SUIVIES</div>
                    <div class="kpi-value">@ViewBag.NbFormationsSuivies</div>
                    <div class="d-flex justify-content-between align-items-center mb-1">
                        <span class="small text-muted fw-semibold">Stable</span>
                    </div>
                    <div class="progress-animated mt-2"><div class="progress-bar" style="width: 46%"></div></div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="glass-panel kpi-card kpi-card-completion">
                    <i class="fas fa-chart-pie kpi-icon"></i>
                    <div class="kpi-label mb-1">TAUX DE COMPLÉTION</div>
                    <div class="kpi-value">@ViewBag.TauxCompletion%</div>
                    <div class="d-flex justify-content-between align-items-center mb-1">
                        <span class="small text-success fw-semibold"><i class="fas fa-arrow-up"></i> 5%</span>
                    </div>
                    <div class="progress-animated mt-2"><div class="progress-bar" style="width: @ViewBag.TauxCompletion%"></div></div>
                </div>
            </div>
        </div>

        <!-- 3. Quick Actions -->
        <h5 class="fw-bold mb-3 mt-2">Actions rapides</h5>
        <div class="row g-3">
            <div class="col-6 col-sm-4 col-md-2 flex-grow-1">
                <a asp-controller="Collaborateurs" asp-action="Index" class="glass-panel quick-action-card">
                    <div class="icon-bubble"><i class="fas fa-users"></i></div>
                    <h6>Voir mon équipe</h6>
                    <small>Annuaire et infos</small>
                </a>
            </div>
            <div class="col-6 col-sm-4 col-md-2 flex-grow-1">
                <a asp-controller="Formations" asp-action="Index" class="glass-panel quick-action-card">
                    <div class="icon-bubble"><i class="fas fa-graduation-cap"></i></div>
                    <h6>Mes formations</h6>
                    <small>Catalogue et suivi</small>
                </a>
            </div>
            <div class="col-6 col-sm-4 col-md-2 flex-grow-1">
                <a asp-controller="Competences" asp-action="Index" class="glass-panel quick-action-card">
                    <div class="icon-bubble"><i class="fas fa-chart-bar"></i></div>
                    <h6>Mes compétences</h6>
                    <small>Cartographie</small>
                </a>
            </div>
            <div class="col-6 col-sm-4 col-md-2 flex-grow-1">
                <a asp-controller="Progression" asp-action="Index" class="glass-panel quick-action-card">
                    <div class="icon-bubble"><i class="fas fa-tachometer-alt"></i></div>
                    <h6>Mon évolution</h6>
                    <small>Entretiens et KPI</small>
                </a>
            </div>
            <div class="col-6 col-sm-4 col-md-2 flex-grow-1">
                <a asp-controller="Objectives" asp-action="Index" class="glass-panel quick-action-card">
                    <div class="icon-bubble"><i class="fas fa-bullseye"></i></div>
                    <h6>Mes objectifs RH</h6>
                    <small>Suivi annuel</small>
                </a>
            </div>
        </div>
    </div>

    <!-- RIGHT COLUMN: Activity Panel -->
    <div class="col-lg-4 portal-right">
        <div class="portal-right-panel p-4 h-100">
            <h5 class="panel-title">Mon espace</h5>

            <!-- AI Smart Insights Widget -->
            <div class="ai-smart-card mb-3">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <span class="fw-bold" style="font-size:.88rem;">🤖 AI Smart Insights</span>
                    <span class="ai-analyse-badge">Analyse IA</span>
                </div>
                <div>
                    <div class="ai-smart-item">
                        <span class="ai-smart-dot ai-smart-dot--green"></span>
                        <span id="si-talent" class="ai-chip-loading">Analyse talent…</span>
                    </div>
                    <div class="ai-smart-item">
                        <span class="ai-smart-dot ai-smart-dot--yellow"></span>
                        <span id="si-formations" class="ai-chip-loading">Analyse formations…</span>
                    </div>
                    <div class="ai-smart-item">
                        <span class="ai-smart-dot ai-smart-dot--red"></span>
                        <span id="si-skills" class="ai-chip-loading">Analyse compétences…</span>
                    </div>
                </div>
            </div>

            <!-- AI Widget -->
            <div class="ai-insight-card mb-4">
                <div class="ai-pulse-border"></div>
                <div class="d-flex justify-content-between align-items-start mb-3">
                    <div class="ai-icon-bubble">
                        <i class="fas fa-magic"></i>
                    </div>
                    <span class="confidence-badge">Impact estimé +15%</span>
                </div>
                <h6 class="fw-bold text-white mb-2">Recommandation personnalisée</h6>
                <p class="small text-white-50 mb-0">
                    Excellente progression ce trimestre ! En complétant la certification <strong>"Leadership Avancé"</strong>, vous augmenterez significativement votre score d'évolution.
                </p>
            </div>

            <!-- Deadlines Timeline -->
            <div class="mb-4">
                <h6 class="panel-section-title">Échéances à venir</h6>
                <div class="timeline-container">
                    <div class="timeline-item">
                        <div class="timeline-dot dot-high"></div>
                        <div class="timeline-card">
                            <h6 class="mb-1 text-white" style="font-size: 0.85rem;">Bilan de mi-année</h6>
                            <div class="small text-danger fw-semibold"><i class="fas fa-exclamation-circle me-1"></i>Dans 5 jours (15 Juin)</div>
                        </div>
                    </div>
                    <div class="timeline-item">
                        <div class="timeline-dot dot-med"></div>
                        <div class="timeline-card">
                            <h6 class="mb-1 text-white" style="font-size: 0.85rem;">Formations à venir</h6>
                            <div class="small text-warning"><i class="far fa-clock me-1"></i>Dans 12 jours</div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Recent Formations (reusing ViewBag data) -->
            <div class="mb-4">
                <h6 class="panel-section-title">Formations en cours</h6>
                @if (!formations.Any())
                {
                    <div class="text-white-50 small">Aucune formation en cours.</div>
                }
                else
                {
                    @foreach (var formation in formations.Take(3))
                    {
                        <div class="mini-training-card">
                            <div class="circular-progress-wrap" style="--p: @formation.Progression%;">
                                <div class="circular-progress-inner">@formation.Progression%</div>
                            </div>
                            <div class="flex-grow-1 min-width-0">
                                <h6 class="mb-1 text-white text-truncate" style="font-size: 0.85rem;">@formation.Titre</h6>
                                <div class="small text-white-50">Reste @formation.JoursRestants jours</div>
                            </div>
                        </div>
                    }
                }
            </div>

            <!-- Certifications -->
            <div class="mb-4">
                <h6 class="panel-section-title">Dernières certifications</h6>
                <div>
                    @if (!certifications.Any())
                    {
                        <span class="text-muted small">Aucune certification obtenue pour le moment.</span>
                    }
                    else
                    {
                        @foreach (var certif in certifications.Take(4))
                        {
                            <span class="cert-chip"><i class="fas fa-medal text-warning"></i> @certif.Formation?.Titre</span>
                        }
                    }
                </div>
            </div>

            <!-- Manager Feedback -->
            <div class="mb-2">
                <h6 class="panel-section-title">Retour Manager</h6>
                <div class="quote-card">
                    <div class="fst-italic text-white-50 small mb-2">"Très bonne implication sur la formation Leadership."</div>
                    <div class="d-flex align-items-center gap-2">
                        <div class="manager-avatar">SD</div>
                        <div class="small text-white fw-semibold">Ibtissem B., Manager</div>
                    </div>
                </div>
            </div>

        </div>
    </div>
</div>

@section Scripts {
<script>
(function () {
    'use strict';

    function setText(id, txt, removeLoading) {
        var el = document.getElementById(id);
        if (!el) return;
        el.textContent = txt;
        if (removeLoading !== false) el.classList.remove('ai-chip-loading');
    }

    // ── Stats endpoint (Q1 + Q2 insights) ────────────────────────────────────
    fetch('/api/chatbot/stats')
        .then(function (r) { return r.ok ? r.json() : null; })
        .then(function (s) {
            if (!s) return;

            // Hero chip 2: collaborateurs actifs
            var actifs = s.collaborateursActifs || 0;
            setText('hero-chip-talent-txt',
                actifs + ' collaborateur' + (actifs > 1 ? 's' : '') + ' actif' + (actifs > 1 ? 's' : ''));

            // Hero chip 3: taux de complétion
            var tc = s.tauxCompletion || 0;
            setText('hero-chip-perf-txt', tc + '% taux de complétion global');

            // Smart insight 2: formations en cours
            var fec = s.formationsEnCours || 0;
            setText('si-formations',
                fec + ' formation' + (fec > 1 ? 's' : '') + ' en attente de clôture');

            // Smart insight 3: compétence clé
            if (s.topCompetences && s.topCompetences.length > 0) {
                var top = s.topCompetences[0];
                setText('si-skills',
                    '"' + top.nom + '" — compétence clé (' + top.niveauMoyen + '/5 moy.)');
            } else {
                setText('si-skills', 'Aucune donnée compétence disponible');
            }
        })
        .catch(function () {
            setText('hero-chip-perf-txt', 'Données RH disponibles');
        });

    // ── Talent endpoint (Smart insight 1) ────────────────────────────────────
    fetch('/api/chatbot/hr-talent')
        .then(function (r) { return r.ok ? r.json() : null; })
        .then(function (data) {
            if (!data || !Array.isArray(data)) {
                setText('si-talent', 'Analyse talent indisponible');
                return;
            }
            var n = data.length;
            setText('si-talent',
                n + ' talent' + (n > 1 ? 's' : '') +
                ' à fort potentiel identifié' + (n > 1 ? 's' : ''));

            // Also update hero chip 2 with talent count if available
            if (n > 0) {
                var talentEl = document.getElementById('hero-chip-talent-txt');
                if (talentEl && !talentEl.classList.contains('ai-chip-loading')) return;
                setText('hero-chip-talent-txt',
                    n + ' talent' + (n > 1 ? 's' : '') + ' à fort potentiel');
            }
        })
        .catch(function () {
            setText('si-talent', 'Analyse talent indisponible');
        });
})();
</script>
}
 
