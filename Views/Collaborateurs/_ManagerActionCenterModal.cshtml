@using SIRH.EY.Services
@model HrInboxSummary

@{
    // Presentation-only normalization: merge the 3 typed lists into common display rows and
    // bucket by urgency. No new business rule — reuses DecisionEngine.ClassifyPendingUrgency /
    // ClassifyCertificationUrgency, which already exist.
    var rows = new List<(string Icon, string TypeLabel, string Titre, string SousTitre, string Bucket, string ActionUrl)>();

    foreach (var v in Model.PendingValidations)
    {
        rows.Add((
            "🟡", "Auto-évaluation", v.CollaborateurNom, $"Auto-évaluation \"{v.CompetenceNom}\" — en attente depuis {v.JoursEnAttente} jour{(v.JoursEnAttente > 1 ? "s" : "")}.",
            DecisionEngine.ClassifyPendingUrgency(v.JoursEnAttente),
            Url.Action("ValidationManager", "Competences", new { id = v.CompetenceId }) ?? "#"
        ));
    }

    foreach (var p in Model.PendingDevelopmentPlans)
    {
        rows.Add((
            "📘", "Plan de développement", p.CollaborateurNom, $"Formation \"{p.FormationTitre}\" — en attente de démarrage depuis {p.JoursEnAttente} jour{(p.JoursEnAttente > 1 ? "s" : "")}.",
            DecisionEngine.ClassifyPendingUrgency(p.JoursEnAttente),
            Url.Action("Details", "Collaborateurs", new { id = p.CollaborateurId }) ?? "#"
        ));
    }

    foreach (var i in Model.PendingInscriptionApprovals)
    {
        rows.Add((
            "🎓", "Demande de formation", i.CollaborateurNom, $"Inscription \"{i.FormationTitre}\" — en attente depuis {i.JoursEnAttente} jour{(i.JoursEnAttente > 1 ? "s" : "")}.",
            DecisionEngine.ClassifyPendingUrgency(i.JoursEnAttente),
            Url.Action("ApprobationsFormation", "Formations") ?? "#"
        ));
    }

    foreach (var c in Model.ExpiringCertifications)
    {
        var bucket = c.Urgence == "Critique" ? "Overdue" : c.Urgence == "Urgent" ? "DueSoon" : "Recent";
        rows.Add((
            "📜", "Certification", c.CollaborateurNom, $"Certification \"{c.CertificationNom}\" expire dans {c.JoursRestants} jour{(c.JoursRestants > 1 ? "s" : "")}.",
            bucket,
            Url.Action("Details", "Collaborateurs", new { id = c.CollaborateurId }) ?? "#"
        ));
    }

    var overdue = rows.Where(r => r.Bucket == "Overdue").ToList();
    var dueSoon = rows.Where(r => r.Bucket == "DueSoon").ToList();
    var recent  = rows.Where(r => r.Bucket == "Recent").ToList();
}

@if (rows.Any())
{
    <div class="modal fade" id="managerActionCenterModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-lg">
            <div class="modal-content" style="border-radius:16px;border:none;overflow:hidden;">
                <div class="modal-header" style="background:var(--ey-navy,#1E293B);color:#fff;border-bottom:3px solid var(--ey-yellow,#FFE600);">
                    <div>
                        <h5 class="modal-title mb-1">Bonjour @(ViewBag.CurrentUserPrenom as string)</h5>
                        <div class="small" style="opacity:.85;">
                            Vous avez <strong>@Model.TotalCount</strong> action@(Model.TotalCount > 1 ? "s" : "") en attente.
                        </div>
                    </div>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Fermer"></button>
                </div>
                <div class="modal-body" style="max-height:65vh;overflow-y:auto;padding:1.25rem;">

                    @{
                        void RenderSection(string emoji, string title, string accentClass, string dotColorVar, List<(string Icon, string TypeLabel, string Titre, string SousTitre, string Bucket, string ActionUrl)> items)
                        {
                            if (!items.Any()) return;
                            <div class="mb-3">
                                <div class="fw-semibold small text-uppercase text-muted mb-2">@emoji @title (@items.Count)</div>
                                @foreach (var item in items)
                                {
                                    <div class="@accentClass" style="background:#fff;border:1px solid #E5E7EB;border-radius:12px;padding:0.85rem 1rem;margin-bottom:0.6rem;display:flex;align-items:center;justify-content:space-between;gap:1rem;">
                                        <div style="display:flex;align-items:flex-start;gap:0.75rem;">
                                            <span style="display:inline-block;width:10px;height:10px;border-radius:50%;background:@dotColorVar;margin-top:6px;flex:none;"></span>
                                            <div>
                                                <div class="fw-semibold">@item.Icon @item.Titre <span class="text-muted fw-normal small">— @item.TypeLabel</span></div>
                                                <div class="text-muted small">@item.SousTitre</div>
                                            </div>
                                        </div>
                                        <a href="@item.ActionUrl" class="btn btn-sm flex-shrink-0" style="background:var(--ey-yellow,#FFE600);color:var(--ey-navy,#1E293B);font-weight:600;">
                                            @(item.TypeLabel == "Auto-évaluation" || item.TypeLabel == "Demande de formation" ? "Valider" : "Voir")
                                        </a>
                                    </div>
                                }
                            </div>
                        }

                        RenderSection("🔴", "En retard", "ds-card-accent-red", "var(--red-600)", overdue);
                        RenderSection("🟠", "À traiter bientôt", "ds-card-accent-amber", "var(--amber-600)", dueSoon);
                        RenderSection("🟢", "Récent", "ds-card-accent-green", "var(--green-600)", recent);
                    }

                </div>
                <div class="modal-footer" style="border-top:1px solid #E5E7EB;">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Fermer</button>
                </div>
            </div>
        </div>
    </div>
}
