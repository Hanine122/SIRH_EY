@model IEnumerable<SIRH.EY.Models.Collaborateur>
@using SIRH.EY.Services

@{
    ViewData["Title"] = "Répertoire";
    var total    = Model.Count();
    var actifs   = Model.Count(c => c.Actif);
    var inactifs = total - actifs;
    var managers = Model.Count(c =>
        c.Grade == "Manager" || (c.Poste ?? "").Contains("Manager", StringComparison.OrdinalIgnoreCase));
    var seniors  = Model.Count(c => c.Grade == "Senior");
    var juniors  = Model.Count(c => c.Grade == "Junior");
    var filtered = !string.IsNullOrEmpty(ViewBag.Search as string)
                   || !string.IsNullOrEmpty(ViewBag.DepartementFilter as string);

    // EY Copilot suggestions — reuses the same "Smart HR Inbox" data already
    // computed for this page by ManagerActionCenterService (no new query),
    // gated by the same isManagerView flag the controller uses for the inbox.
    var isManagerView = ViewBag.IsManagerView as bool? ?? false;
    var hrInbox        = ViewBag.HrInbox as HrInboxSummary;
    var pendingValidations = hrInbox?.PendingValidations ?? Array.Empty<PendingValidationItem>();
    var pendingByCollaborateur = pendingValidations
        .GroupBy(p => p.CollaborateurId)
        .ToDictionary(g => g.Key, g => g.ToList());
}

@section Styles {
    <link rel="stylesheet" href="~/css/ceb-evaluation-status.css" asp-append-version="true" />
    <style>
        .copilot-banner {
            background: #0B0F1A; border-radius: var(--ey-radius-lg, 16px); padding: 1rem 1.25rem;
            color: #fff; margin-bottom: 1.5rem; position: relative; overflow: hidden;
        }
        .copilot-banner::before {
            content: ''; position: absolute; inset: 0;
            background: radial-gradient(600px circle at 0% 0%, rgba(255,230,0,.14), transparent 55%);
            pointer-events: none;
        }
        .copilot-banner-head {
            display: flex; align-items: center; gap: 8px; font-size: 11px; font-weight: 700;
            letter-spacing: .08em; text-transform: uppercase; color: var(--ey-yellow, #FFE600);
            margin-bottom: 10px; position: relative;
        }
        .copilot-item {
            display: flex; align-items: center; justify-content: space-between; gap: 12px;
            background: rgba(255,255,255,.06); border: 1px solid rgba(255,255,255,.1);
            border-radius: 10px; padding: 10px 14px; margin-bottom: 8px; position: relative;
        }
        .copilot-item:last-child { margin-bottom: 0; }
        .copilot-item-text { font-size: 13.5px; line-height: 1.4; }
        .copilot-item-text strong { color: var(--ey-yellow, #FFE600); }
        .copilot-open-btn {
            flex-shrink: 0; font-size: 12px; font-weight: 700; padding: 6px 14px; border-radius: 8px;
            background: var(--ey-yellow, #FFE600); color: #1A1A24; text-decoration: none;
            transition: background .15s ease, transform .15s ease;
        }
        .copilot-open-btn:hover { background: #E6CE00; color: #1A1A24; transform: translateY(-1px); }

        /* Card treatment for a collaborator with a pending validation */
        @@keyframes ceb-pulse-ring {
            0%, 100% { box-shadow: 0 0 0 3px rgba(250,204,21,.55); }
            50%      { box-shadow: 0 0 0 6px rgba(250,204,21,.22); }
        }
        .directory-card.ceb-pending-ring {
            animation: ceb-pulse-ring 2.2s ease-in-out infinite;
        }
        @@media (prefers-reduced-motion: reduce) {
            .directory-card.ceb-pending-ring { animation: none; box-shadow: 0 0 0 3px rgba(250,204,21,.55); }
        }
        .ceb-floating-badge {
            position: absolute; top: -8px; right: 10px; font-size: 10px; font-weight: 700;
            background: var(--ey-yellow, #FFE600); color: #1A1A24; padding: 3px 9px; border-radius: 99px;
            box-shadow: 0 2px 6px rgba(0,0,0,.18); display: inline-flex; align-items: center; gap: 4px;
        }
        .ceb-quick-validate-btn {
            background: var(--ey-yellow, #FFE600); border-color: var(--ey-yellow, #FFE600); color: #1A1A24 !important;
        }
        .ceb-quick-validate-btn:hover { background: #E6CE00; border-color: #E6CE00; }
    </style>
}

@* Jeton anti-CSRF pour les boutons de validation rapide (bandeau Copilot + modal) *@
@Html.AntiForgeryToken()

@if (TempData["Success"] != null)
{
    <div class="alert alert-success"><i class="fas fa-check-circle me-1"></i> @TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger"><i class="fas fa-exclamation-triangle me-1"></i> @TempData["Error"]</div>
}

@* ── Page header ─────────────────────────────────────────────────────────── *@
<div class="directory-page-header d-flex flex-column flex-lg-row justify-content-between align-items-lg-start gap-3">
    <div>
        <div class="ey-page-kicker">Gestion des collaborateurs</div>
        <h1 class="ey-page-title">Répertoire EY</h1>
        <p class="ey-page-lead mb-0">
            @if (filtered)
            {
                <span>
                    <strong>@total</strong> résultat@(total > 1 ? "s" : "")
                    <span class="text-muted">sur @(actifs + inactifs) collaborateur@(actifs + inactifs > 1 ? "s" : "") — filtre actif</span>
                </span>
            }
            else
            {
                <span>
                    <strong>@total</strong> collaborateur@(total > 1 ? "s" : "") EY
                </span>
            }
        </p>
    </div>
    <a asp-action="Create" class="ey-btn-main text-decoration-none align-self-lg-start flex-shrink-0">
        <i class="fas fa-plus me-1"></i>Ajouter un collaborateur
    </a>
</div>

@* ── EY Copilot suggestions (Manager only, auto-évaluations en attente) ─────── *@
@if (isManagerView && pendingValidations.Any())
{
    <div class="copilot-banner">
        <div class="copilot-banner-head"><i class="fas fa-robot"></i> Suggestions EY Copilot</div>
        @foreach (var item in pendingValidations)
        {
            <div class="copilot-item">
                <div class="copilot-item-text">
                    <i class="fas fa-wand-magic-sparkles me-1" style="color: var(--ey-yellow, #FFE600);"></i>
                    Copilot : <strong>@item.CollaborateurNom</strong> a complété son auto-évaluation
                    (<em>@item.CompetenceNom</em>). Validez ses compétences en 1 clic.
                </div>
                <a asp-controller="Competences" asp-action="ValidationManager" asp-route-id="@item.CompetenceId"
                   class="copilot-open-btn">
                    Ouvrir l'évaluation
                </a>
            </div>
        }
    </div>
}

@* ── Manager action center trigger — reuses the existing HrInboxSummary already
   computed by ManagerActionCenterService (approbations de formation, plans de
   développement, certifications expirantes, auto-évaluations) and renders it via
   the existing _ManagerActionCenterModal partial. *@
@if (isManagerView && hrInbox != null && hrInbox.TotalCount > 0)
{
    <div class="d-flex justify-content-end mb-3">
        <button type="button" class="ey-btn-main text-decoration-none" data-bs-toggle="modal" data-bs-target="#managerActionCenterModal">
            <i class="fas fa-inbox me-2"></i>Centre d'actions manager
            <span class="badge bg-danger rounded-pill ms-2">@hrInbox.TotalCount</span>
        </button>
    </div>
}

@* ── Team composition KPIs ──────────────────────────────────────────────────── *@
<div class="row g-3 mb-4">
    <div class="col-6 col-md-3 col-xl-2">
        <div class="ey-card p-3 text-center h-100">
            <div class="report-kpi-icon report-kpi-icon--dark mx-auto mb-2">
                <i class="fas fa-users"></i>
            </div>
            <div class="report-kpi-value">@total</div>
            <div class="report-kpi-label">Total</div>
        </div>
    </div>
    <div class="col-6 col-md-3 col-xl-2">
        <div class="ey-card p-3 text-center h-100">
            <div class="report-kpi-icon report-kpi-icon--green mx-auto mb-2">
                <i class="fas fa-check-circle"></i>
            </div>
            <div class="report-kpi-value text-success">@actifs</div>
            <div class="report-kpi-label">Actifs</div>
        </div>
    </div>
    <div class="col-6 col-md-3 col-xl-2">
        <div class="ey-card p-3 text-center h-100">
            <div class="report-kpi-icon report-kpi-icon--yellow mx-auto mb-2">
                <i class="fas fa-user-tie"></i>
            </div>
            <div class="report-kpi-value">@managers</div>
            <div class="report-kpi-label">Managers</div>
        </div>
    </div>
    <div class="col-6 col-md-3 col-xl-2">
        <div class="ey-card p-3 text-center h-100">
            <div class="report-kpi-icon mx-auto mb-2" style="background:#f0f4ff;border:1px solid #c7d7ff;">
                <i class="fas fa-star" style="color:#4f6fff;"></i>
            </div>
            <div class="report-kpi-value">@seniors</div>
            <div class="report-kpi-label">Seniors</div>
        </div>
    </div>
    <div class="col-6 col-md-3 col-xl-2">
        <div class="ey-card p-3 text-center h-100">
            <div class="report-kpi-icon mx-auto mb-2" style="background:#f3f4f6;border:1px solid #e5e7eb;">
                <i class="fas fa-user-graduate text-muted"></i>
            </div>
            <div class="report-kpi-value text-muted">@juniors</div>
            <div class="report-kpi-label">Juniors</div>
        </div>
    </div>
    @if (inactifs > 0)
    {
        <div class="col-6 col-md-3 col-xl-2">
            <div class="ey-card p-3 text-center h-100">
                <div class="report-kpi-icon report-kpi-icon--red mx-auto mb-2">
                    <i class="fas fa-user-slash"></i>
                </div>
                <div class="report-kpi-value text-danger">@inactifs</div>
                <div class="report-kpi-label">Inactifs</div>
            </div>
        </div>
    }
</div>

@* ── Filter toolbar ─────────────────────────────────────────────────────────── *@
<div class="ey-card p-3 p-md-4 mb-4 directory-toolbar">
    <form method="get" class="row g-3 align-items-end">
        <div class="col-lg-4 col-md-6">
            <label class="form-label small mb-1 text-muted fw-semibold">Recherche</label>
            <input type="text" name="searchString" class="form-control" placeholder="Rechercher par nom, email ou poste..." value="@ViewBag.Search" />
        </div>
        <div class="col-lg-3 col-md-6">
            <label class="form-label small mb-1 text-muted fw-semibold">Département</label>
            <select name="departement" class="form-select">
    <option value="">Tous les départements</option>

    @if (ViewBag.Departements != null)
    {
        foreach (var dep in ViewBag.Departements)
        {
            if (dep == ViewBag.DepartementFilter)
            {
                <option value="@dep" selected>@dep</option>
            }
            else
            {
                <option value="@dep">@dep</option>
            }
        }
    }
</select>
        </div>
        <div class="col-lg-2 col-md-4">
            <label class="form-label small mb-1 text-muted fw-semibold">Tri</label>
            <select name="sortOrder" class="form-select">
                <option value="name_asc" selected="@(ViewBag.CurrentSort == "name_asc")">A → Z</option>
                <option value="name_desc" selected="@(ViewBag.CurrentSort == "name_desc")">Z → A</option>
            </select>
        </div>
        <div class="col-lg-1 col-md-4">
            <button type="button" class="directory-filters-btn w-100" title="Filtres avancés"><i class="fas fa-sliders-h me-1"></i>Filtres</button>
        </div>
        <div class="col-lg-2 col-md-4">
            <button type="submit" class="ey-btn-main w-100">Appliquer</button>
        </div>
    </form>
</div>

<div class="row g-3 g-xl-4">
    @foreach (var item in Model)
    {
        var statut = !item.Actif ? "INACTIF" : (item.Id % 7 == 0 ? "CONGÉ" : "ACTIF");
        var statutClass = statut == "ACTIF" ? "active" : (statut == "CONGÉ" ? "leave" : "inactive");
        var initials = $"{(string.IsNullOrWhiteSpace(item.Prenom) ? "?" : item.Prenom[0])}{(string.IsNullOrWhiteSpace(item.Nom) ? "?" : item.Nom[0])}";
        var tone = item.Id % 6;
        var avatarState = statut == "CONGÉ" ? "is-conge" : (statut == "INACTIF" ? "is-inactif" : "");
        var pendingForItem = pendingByCollaborateur.TryGetValue(item.Id, out var pv) ? pv : null;
        var hasPending = isManagerView && pendingForItem != null && pendingForItem.Any();
        <div class="col-sm-6 col-lg-4 col-xl-3">
            <div class="directory-card directory-card-modern @(hasPending ? "ceb-pending-ring" : "")" style="position:relative;">
                @if (hasPending)
                {
                    <span class="ceb-floating-badge"><i class="fas fa-inbox"></i> Auto-éval reçue</span>
                }
                <span class="ey-pill @statutClass directory-status-pill">@statut</span>
                <div class="d-flex justify-content-center">
                    <div class="directory-avatar directory-avatar--tone-@tone @avatarState">@initials.ToUpperInvariant()</div>
                </div>
                <div class="text-center mt-3">
                    <div class="fw-bold fs-5" style="line-height:1.2;">@item.Prenom @item.Nom</div>
                    <div class="text-muted mt-1 small">@(item.Poste ?? "Consultant")</div>
                    <div class="directory-grade mt-2">@((item.Grade ?? "Junior").ToUpperInvariant())</div>
                </div>

                <div class="small text-muted mt-3 directory-meta">
                    <div class="mb-2 text-truncate" title="@item.Email"><i class="far fa-envelope me-2"></i>@item.Email</div>
                    <div class="text-truncate" title="@(item.Departement ?? "")"><i class="fas fa-map-marker-alt me-2"></i>@(item.Departement ?? "Non renseigné")</div>
                </div>

                <div class="mt-4 d-flex flex-column gap-2">
                    <a asp-action="Details" asp-route-id="@item.Id" class="directory-btn-profile text-decoration-none w-100 text-center">Consulter le profil <i class="fas fa-arrow-right ms-1"></i></a>
                    @if (hasPending)
                    {
                        <button type="button" class="btn btn-sm w-100 rounded-pill ceb-quick-validate-btn ceb-quick-validate-trigger"
                                data-bs-toggle="modal" data-bs-target="#ceb-quick-validate-modal"
                                data-collab-id="@item.Id" data-collab-nom="@($"{item.Prenom} {item.Nom}")">
                            <i class="fas fa-bolt me-1"></i>Valider ses compétences
                        </button>
                    }
                    else if (item.Actif)
                    {
                        <a asp-action="ChoisirRemplacant" asp-route-id="@item.Id"
                           class="btn btn-sm btn-dark w-100 rounded-pill text-decoration-none text-center text-warning border-warning border-opacity-50">
                            <i class="fas fa-people-arrows me-1"></i>Départ / remplaçant
                        </a>
                    }
                </div>
            </div>
        </div>
    }

    <div class="col-sm-6 col-lg-4 col-xl-3">
        <a asp-action="Create" class="text-decoration-none text-reset h-100 d-block">
            <div class="directory-card d-flex flex-column justify-content-center align-items-center text-muted" style="border-style:dashed;border-top-color:#cbd5e1;padding:2rem 1rem;">
                <i class="fas fa-plus fs-2 mb-2"></i>
                <div class="fw-semibold small">NOUVEL ENREGISTREMENT</div>
            </div>
        </a>
    </div>
</div>

@if (!Model.Any())
{
    <div class="alert alert-info mt-3">Aucun collaborateur trouvé.</div>
}

@if (isManagerView && hrInbox != null)
{
    @* ── Unified manager inbox modal — pré-existant, jamais inclus dans une vue
       jusqu'ici ; réutilisé tel quel, aucune nouvelle logique métier. *@
    <partial name="_ManagerActionCenterModal" model="hrInbox" />
}

@if (isManagerView)
{
    @* ── Modal d'évaluation rapide — mêmes boutons .ceb-validate-btn / même
       endpoint /Competences/ValiderCompetence que Competences/Index.cshtml,
       remplis à l'ouverture depuis les données déjà chargées ci-dessous. *@
    <div class="modal fade" id="ceb-quick-validate-modal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content rounded-4 border-0 shadow-lg">
                <div class="modal-header border-0 pb-0">
                    <div>
                        <div class="ey-page-kicker mb-0">Validation rapide</div>
                        <h5 class="modal-title fw-bold" id="ceb-quick-validate-title">Compétences</h5>
                    </div>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fermer"></button>
                </div>
                <div class="modal-body pt-2" id="ceb-quick-validate-body">
                    <div class="text-muted small">Aucune compétence en attente.</div>
                </div>
            </div>
        </div>
    </div>

    <script>
        var cebPendingByCollaborateur = @Html.Raw(Json.Serialize(pendingByCollaborateur));
    </script>
}

@section Scripts {
    <script src="~/js/ceb-evaluation-status.js" asp-append-version="true"></script>
    @if (isManagerView)
    {
        <script>
            (function () {
                'use strict';

                function cebOpenQuickValidate(collaborateurId, nomComplet) {
                    document.getElementById('ceb-quick-validate-title').textContent = nomComplet;
                    var body = document.getElementById('ceb-quick-validate-body');
                    var items = (cebPendingByCollaborateur && cebPendingByCollaborateur[collaborateurId]) || [];

                    if (!items.length) {
                        body.innerHTML = '<div class="text-muted small">Aucune compétence en attente.</div>';
                        return;
                    }

                    body.innerHTML = items.map(function (it) {
                        var targetScore = it.niveauCible * 20;
                        return '' +
                            '<div class="d-flex align-items-center justify-content-between py-2 border-bottom">' +
                                '<div>' +
                                    '<div class="fw-semibold small">' + it.competenceNom + '</div>' +
                                    '<span class="ceb-badge ceb-badge-pending">En attente</span>' +
                                '</div>' +
                                '<button type="button" class="ceb-validate-btn" data-comp-id="' + it.competenceId + '" data-target-score="' + targetScore + '">' +
                                    'Valider à ' + it.niveauCible + '/5' +
                                '</button>' +
                            '</div>';
                    }).join('');
                }

                document.addEventListener('click', function (e) {
                    var trigger = e.target.closest('.ceb-quick-validate-trigger');
                    if (!trigger) return;
                    cebOpenQuickValidate(trigger.getAttribute('data-collab-id'), trigger.getAttribute('data-collab-nom'));
                });
            })();
        </script>
    }
}
