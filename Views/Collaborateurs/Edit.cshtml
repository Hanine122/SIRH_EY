@model SIRH.EY.Models.Collaborateur
@using SIRH.EY.Models
@{
    ViewData["Title"] = "Modifier collaborateur";
    var managers         = ViewBag.Managers          as List<Collaborateur>        ?? new();
    var departments      = ViewBag.Departments       as List<Department>           ?? new();
    var subDepartments   = ViewBag.SubDepartments    as List<SubDepartment>        ?? new();
    var positions        = ViewBag.Positions         as List<Position>             ?? new();
    var gradeEntities    = ViewBag.GradeEntities     as List<GradeEntity>          ?? new();
    var buEntities       = ViewBag.BusinessUnitEntities as List<BusinessUnitEntity> ?? new();
    var locationEntities = ViewBag.LocationEntities  as List<LocationEntity>       ?? new();
    var contractTypes    = ViewBag.ContractTypes     as List<ContractType>         ?? new();
    var genres           = ViewBag.Genres            as string[] ?? Array.Empty<string>();
    var etatsCivils      = ViewBag.EtatsCivils       as string[] ?? Array.Empty<string>();
    var niveauxH         = ViewBag.NiveauxHierarchiques as string[] ?? Array.Empty<string>();
    var potentiels       = ViewBag.PotentielsCarriere   as string[] ?? Array.Empty<string>();
}

@section Styles {
    <link rel="stylesheet" href="~/css/ey-forms-premium.css" asp-append-version="true" />
}

<div class="ey-premium-card">
    <div class="ey-card-header-premium">
        <div class="d-flex justify-content-between align-items-start">
            <div>
                <div class="ey-header-icon"><i class="fas fa-user-edit"></i></div>
                <h1 class="ey-header-title">Modifier le profil</h1>
                <p class="ey-header-subtitle">@Model.Prenom @Model.Nom - fiche collaborateur RH.</p>
            </div>
            <a asp-action="Details" asp-route-id="@Model.Id" class="ey-back-link"><i class="fas fa-arrow-left"></i> Retour</a>
        </div>
    </div>

    <div class="ey-form-body">
        <form asp-action="Edit" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" />
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <!-- Informations personnelles -->
            <div class="ey-form-section">
                <div class="ey-section-title">Informations personnelles</div>
                <div class="row g-3">
                    <div class="col-md-6"><label asp-for="Nom" class="ey-label"></label><input asp-for="Nom" class="ey-input" /></div>
                    <div class="col-md-6"><label asp-for="Prenom" class="ey-label"></label><input asp-for="Prenom" class="ey-input" /></div>
                    <div class="col-md-6"><label asp-for="Email" class="ey-label"></label><input asp-for="Email" class="ey-input" /></div>
                    <div class="col-md-6"><label asp-for="DateNaissance" class="ey-label">Date de naissance</label><input asp-for="DateNaissance" class="ey-input" type="date" /></div>
                    <div class="col-md-4"><label asp-for="Genre" class="ey-label">Genre</label><select asp-for="Genre" class="ey-input"><option value="">Non renseigne</option>@foreach (var g in genres) { <option value="@g">@g</option> }</select></div>
                    <div class="col-md-4"><label asp-for="Nationalite" class="ey-label">Nationalite</label><input asp-for="Nationalite" class="ey-input" /></div>
                    <div class="col-md-4"><label asp-for="EtatCivil" class="ey-label">Etat civil</label><select asp-for="EtatCivil" class="ey-input"><option value="">Selectionnez</option>@foreach (var e in etatsCivils) { <option value="@e">@e</option> }</select></div>
                    <div class="col-md-8"><label asp-for="Adresse" class="ey-label">Adresse</label><input asp-for="Adresse" class="ey-input" /></div>
                    <div class="col-md-4"><label asp-for="Ville" class="ey-label">Ville</label><input asp-for="Ville" class="ey-input" /></div>
                    <div class="col-md-4"><label asp-for="Pays" class="ey-label">Pays</label><input asp-for="Pays" class="ey-input" /></div>
                    <div class="col-md-4"><label asp-for="TelephonePersonnel" class="ey-label">Telephone personnel</label><input asp-for="TelephonePersonnel" class="ey-input" /></div>
                    <div class="col-md-4"><label asp-for="ContactUrgence" class="ey-label">Contact d'urgence</label><input asp-for="ContactUrgence" class="ey-input" /></div>
                </div>
            </div>

            <!-- Informations professionnelles (master data FK) -->
            <div class="ey-form-section">
                <div class="ey-section-title">Informations professionnelles</div>
                <div class="row g-3">
                    <div class="col-md-4"><label asp-for="Matricule" class="ey-label">Matricule</label><input asp-for="Matricule" class="ey-input" /></div>

                    <div class="col-md-4">
                        <label asp-for="DepartmentId" class="ey-label">Département</label>
                        <select asp-for="DepartmentId" class="ey-input" id="DepartmentId">
                            <option value="">Selectionnez</option>
                            @foreach (var d in departments) {
                                <option value="@d.Id" selected="@(Model.DepartmentId == d.Id)">@d.Name</option>
                            }
                        </select>
                    </div>

                    <div class="col-md-4">
                        <label asp-for="SubDepartmentId" class="ey-label">Sous-département <span class="text-danger">*</span></label>
                        <select asp-for="SubDepartmentId" class="ey-input" id="SubDepartmentId" required>
                            <option value="">Selectionnez</option>
                            @foreach (var s in subDepartments) {
                                <option value="@s.Id" data-dept="@s.DepartmentId"
                                        selected="@(Model.SubDepartmentId == s.Id)">@s.Department?.Name / @s.Name</option>
                            }
                        </select>
                    </div>

                    <div class="col-md-4">
                        <label asp-for="PositionId" class="ey-label">Poste</label>
                        <select asp-for="PositionId" class="ey-input">
                            <option value="">Selectionnez</option>
                            @foreach (var p in positions) {
                                <option value="@p.Id" selected="@(Model.PositionId == p.Id)">@p.Name</option>
                            }
                        </select>
                    </div>

                    <div class="col-md-4">
                        <label asp-for="GradeId" class="ey-label">Grade</label>
                        <select asp-for="GradeId" class="ey-input">
                            <option value="">Selectionnez</option>
                            @foreach (var g in gradeEntities) {
                                <option value="@g.Id" selected="@(Model.GradeId == g.Id)">@g.Name</option>
                            }
                        </select>
                    </div>

                    <div class="col-md-4">
                        <label asp-for="BusinessUnitId" class="ey-label">Business Unit</label>
                        <select asp-for="BusinessUnitId" class="ey-input" id="BusinessUnitId">
                            <option value="">Selectionnez</option>
                            @foreach (var b in buEntities) {
                                <option value="@b.Id" selected="@(Model.BusinessUnitId == b.Id)">@b.Name</option>
                            }
                        </select>
                    </div>

                    <div class="col-md-4">
                        <label asp-for="ManagerId" class="ey-label">Manager direct <span class="text-danger">*</span></label>
                        <select asp-for="ManagerId" class="ey-input" id="ManagerId">
                            <option value="">Aucun manager</option>
                            @foreach (var m in managers) {
                                <option value="@m.Id" selected="@(Model.ManagerId == m.Id)">@m.Prenom @m.Nom</option>
                            }
                        </select>
                        <small class="text-muted">Requis, sauf pour le sommet de la hiérarchie (Grade = Partner).</small>
                    </div>

                    <div class="col-md-4">
                        <label asp-for="NiveauHierarchique" class="ey-label">Niveau hierarchique</label>
                        <select asp-for="NiveauHierarchique" class="ey-input">
                            <option value="">Selectionnez</option>
                            @foreach (var n in niveauxH) { <option value="@n">@n</option> }
                        </select>
                    </div>

                    <div class="col-md-4">
                        <label asp-for="LocationId" class="ey-label">Localisation</label>
                        <select asp-for="LocationId" class="ey-input">
                            <option value="">Selectionnez</option>
                            @foreach (var l in locationEntities) {
                                <option value="@l.Id" selected="@(Model.LocationId == l.Id)">@l.Name</option>
                            }
                        </select>
                    </div>

                    <div class="col-md-4"><label asp-for="DatePrisePoste" class="ey-label">Date de prise de poste</label><input asp-for="DatePrisePoste" class="ey-input" type="date" /></div>
                </div>
            </div>

            <!-- Contrat et données RH -->
            <div class="ey-form-section">
                <div class="ey-section-title">Contrat et donnees RH</div>
                <div class="row g-3">
                    <div class="col-md-4">
                        <label asp-for="ContractTypeId" class="ey-label">Type de contrat</label>
                        <select asp-for="ContractTypeId" class="ey-input">
                            <option value="">Selectionnez</option>
                            @foreach (var ct in contractTypes) {
                                <option value="@ct.Id" selected="@(Model.ContractTypeId == ct.Id)">@ct.Name</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-4"><label asp-for="DateEmbauche" class="ey-label">Date d'embauche</label><input asp-for="DateEmbauche" class="ey-input" type="date" /></div>
                    <div class="col-md-4"><label asp-for="Statut" class="ey-label">Statut employe</label><select asp-for="Statut" asp-items="Html.GetEnumSelectList<StatutCollaborateur>()" class="ey-input"></select></div>
                    <div class="col-md-4"><label asp-for="NiveauPreparationSuccession" class="ey-label">Preparation succession (%)</label><input asp-for="NiveauPreparationSuccession" class="ey-input" type="number" min="0" max="100" /></div>
                    <div class="col-md-4"><label asp-for="PotentielCarriere" class="ey-label">Potentiel carriere</label><select asp-for="PotentielCarriere" class="ey-input"><option value="">Selectionnez</option>@foreach (var p in potentiels) { <option value="@p">@p</option> }</select></div>
                    <div class="col-md-4"><label class="ey-checkbox-modern ey-mt-4"><input asp-for="Actif" type="checkbox" /><span class="ey-checkbox-label">Collaborateur actif</span></label></div>
                    <div class="col-12"><label asp-for="FormationsObligatoires" class="ey-label">Formations obligatoires</label><textarea asp-for="FormationsObligatoires" class="ey-input" rows="2"></textarea></div>
                </div>
            </div>

            <div class="ey-actions-bar">
                <a asp-action="Details" asp-route-id="@Model.Id" class="ey-btn-premium ey-btn-ghost"><i class="fas fa-times"></i> Annuler</a>
                <button type="submit" class="ey-btn-premium ey-btn-primary"><i class="fas fa-save"></i> Enregistrer</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (function () {
            const deptSel = document.getElementById('DepartmentId');
            const subSel  = document.getElementById('SubDepartmentId');
            if (!deptSel || !subSel) return;

            const allOpts = Array.from(subSel.options).filter(o => o.value);
            const selected = subSel.value;

            function filter() {
                const deptId = deptSel.value;
                subSel.innerHTML = '<option value="">Selectionnez</option>';
                allOpts.filter(o => !deptId || o.dataset.dept === deptId)
                       .forEach(o => {
                           const cl = o.cloneNode(true);
                           if (cl.value === selected) cl.selected = true;
                           subSel.appendChild(cl);
                       });
            }

            deptSel.addEventListener('change', filter);
            filter();
        })();

        // Business Unit : auto-suggestion (pas de redondance exacte avec le
        // Departement -- CBS n'a pas d'equivalent -- donc le champ reste
        // visible/modifiable ; on se contente de pre-selectionner la BU dont
        // le nom correspond au departement choisi, tant que l'utilisateur n'a
        // pas lui-meme modifie manuellement ce champ).
        (function () {
            const deptSel = document.getElementById('DepartmentId');
            const buSel   = document.getElementById('BusinessUnitId');
            if (!deptSel || !buSel) return;

            let userTouchedBU = false;
            buSel.addEventListener('change', function () { userTouchedBU = true; });

            function syncBusinessUnit() {
                if (userTouchedBU) return;
                const deptText = deptSel.selectedOptions[0]?.textContent?.trim();
                if (!deptText) return;
                const match = Array.from(buSel.options).find(o => o.textContent.trim() === deptText);
                if (match) buSel.value = match.value;
            }

            deptSel.addEventListener('change', syncBusinessUnit);
        })();

        // Manager direct : requis, sauf pour le sommet de la hierarchie (Partner)
        (function () {
            const gradeSel   = document.getElementById('GradeId');
            const managerSel = document.getElementById('ManagerId');
            if (!gradeSel || !managerSel) return;

            function syncRequired() {
                const isPartner = /partner/i.test(gradeSel.selectedOptions[0]?.textContent || '');
                managerSel.required = !isPartner;
            }

            gradeSel.addEventListener('change', syncRequired);
            syncRequired();
        })();
    </script>
}
