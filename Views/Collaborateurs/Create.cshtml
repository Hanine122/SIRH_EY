@model SIRH.EY.Models.Collaborateur
@{
    ViewData["Title"] = "Nouveau collaborateur";
    var managers = ViewBag.Managers as List<SIRH.EY.Models.Collaborateur> ?? new List<SIRH.EY.Models.Collaborateur>();
    var departements = ViewBag.Departements as IReadOnlyList<string> ?? Array.Empty<string>();
    var postes = ViewBag.Postes as IReadOnlyList<string> ?? Array.Empty<string>();
    var genres = ViewBag.Genres as IReadOnlyList<string> ?? Array.Empty<string>();
    var etatsCivils = ViewBag.EtatsCivils as IReadOnlyList<string> ?? Array.Empty<string>();
    var typesContrat = ViewBag.TypesContrat as IReadOnlyList<string> ?? Array.Empty<string>();
    var localisations = ViewBag.Localisations as IReadOnlyList<string> ?? Array.Empty<string>();
    var businessUnits = ViewBag.BusinessUnits as IReadOnlyList<string> ?? Array.Empty<string>();
    var niveauxHierarchiques = ViewBag.NiveauxHierarchiques as IReadOnlyList<string> ?? Array.Empty<string>();
    var potentielsCarriere = ViewBag.PotentielsCarriere as IReadOnlyList<string> ?? Array.Empty<string>();
}

@section Styles {
    <link rel="stylesheet" href="~/css/ey-forms-premium.css" asp-append-version="true" />
}

<div class="ey-premium-card">
    <div class="ey-card-header-premium">
        <div class="d-flex justify-content-between align-items-start">
            <div>
                <div class="ey-header-icon"><i class="fas fa-user-plus"></i></div>
                <h1 class="ey-header-title">Ajouter un collaborateur</h1>
                <p class="ey-header-subtitle">Creez un profil RH complet dans le referentiel EY.</p>
            </div>
            <a asp-action="Index" class="ey-back-link"><i class="fas fa-arrow-left"></i> Retour</a>
        </div>
    </div>

    <div class="ey-form-body">
        <form asp-action="Create" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="ey-form-section">
                <div class="ey-section-title">Informations personnelles</div>
                <div class="row g-3">
                    <div class="col-md-6"><label asp-for="Nom" class="ey-label"></label><input asp-for="Nom" class="ey-input" /></div>
                    <div class="col-md-6"><label asp-for="Prenom" class="ey-label"></label><input asp-for="Prenom" class="ey-input" /></div>
                    <div class="col-md-6"><label asp-for="Email" class="ey-label"></label><input asp-for="Email" class="ey-input" placeholder="prenom.nom@ey.com" /></div>
                    <div class="col-md-6"><label asp-for="DateNaissance" class="ey-label">Date de naissance</label><input asp-for="DateNaissance" class="ey-input" type="date" /></div>
                    <div class="col-md-4">
                        <label asp-for="Genre" class="ey-label">Genre</label>
                        <select asp-for="Genre" class="ey-input"><option value="">Non renseigne</option>@foreach (var item in genres) { <option value="@item">@item</option> }</select>
                    </div>
                    <div class="col-md-4"><label asp-for="Nationalite" class="ey-label">Nationalite</label><input asp-for="Nationalite" class="ey-input" /></div>
                    <div class="col-md-4">
                        <label asp-for="EtatCivil" class="ey-label">Etat civil</label>
                        <select asp-for="EtatCivil" class="ey-input"><option value="">Selectionnez</option>@foreach (var item in etatsCivils) { <option value="@item">@item</option> }</select>
                    </div>
                    <div class="col-md-8"><label asp-for="Adresse" class="ey-label">Adresse</label><input asp-for="Adresse" class="ey-input" /></div>
                    <div class="col-md-4"><label asp-for="Ville" class="ey-label">Ville</label><input asp-for="Ville" class="ey-input" /></div>
                    <div class="col-md-4"><label asp-for="Pays" class="ey-label">Pays</label><input asp-for="Pays" class="ey-input" /></div>
                    <div class="col-md-4"><label asp-for="TelephonePersonnel" class="ey-label">Telephone personnel</label><input asp-for="TelephonePersonnel" class="ey-input" /></div>
                    <div class="col-md-4"><label asp-for="ContactUrgence" class="ey-label">Contact d'urgence</label><input asp-for="ContactUrgence" class="ey-input" /></div>
                </div>
            </div>

            <div class="ey-form-section">
                <div class="ey-section-title">Informations professionnelles</div>
                <div class="row g-3">
                    <div class="col-md-4"><label asp-for="Matricule" class="ey-label">Matricule</label><input asp-for="Matricule" class="ey-input" placeholder="EY-0001" /></div>
                    <div class="col-md-4">
                        <label asp-for="Departement" class="ey-label">Departement</label>
                        <select asp-for="Departement" class="ey-input js-departement-select" data-poste-target="#Poste">
                            <option value="">Selectionnez un departement</option>
                            @foreach (var item in departements) { <option value="@item">@item</option> }
                        </select>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="Poste" class="ey-label">Poste</label>
                        <select asp-for="Poste" class="ey-input js-poste-select">
                            <option value="">Selectionnez d'abord un departement</option>
                            @foreach (var item in postes) { <option value="@item">@item</option> }
                        </select>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="Grade" class="ey-label">Grade</label>
                        <select asp-for="Grade" class="ey-input"><option value="">Selectionnez</option><option>Junior</option><option>Senior</option><option>Manager</option><option>Senior Manager</option><option>Director</option><option>Partner</option></select>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="BusinessUnit" class="ey-label">Business Unit</label>
                        <select asp-for="BusinessUnit" class="ey-input"><option value="">Selectionnez</option>@foreach (var item in businessUnits) { <option value="@item">@item</option> }</select>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="ManagerId" class="ey-label">Manager direct</label>
                        <select asp-for="ManagerId" class="ey-input"><option value="">Aucun manager</option>@foreach (var manager in managers) { <option value="@manager.Id">@manager.Prenom @manager.Nom</option> }</select>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="NiveauHierarchique" class="ey-label">Niveau hierarchique</label>
                        <select asp-for="NiveauHierarchique" class="ey-input"><option value="">Selectionnez</option>@foreach (var item in niveauxHierarchiques) { <option value="@item">@item</option> }</select>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="Localisation" class="ey-label">Localisation</label>
                        <select asp-for="Localisation" class="ey-input"><option value="">Selectionnez</option>@foreach (var item in localisations) { <option value="@item">@item</option> }</select>
                    </div>
                    <div class="col-md-4"><label asp-for="DatePrisePoste" class="ey-label">Date de prise de poste</label><input asp-for="DatePrisePoste" class="ey-input" type="date" /></div>
                </div>
            </div>

            <div class="ey-form-section">
                <div class="ey-section-title">Contrat et donnees RH</div>
                <div class="row g-3">
                    <div class="col-md-4">
                        <label asp-for="TypeContrat" class="ey-label">Type de contrat</label>
                        <select asp-for="TypeContrat" class="ey-input"><option value="">Selectionnez</option>@foreach (var item in typesContrat) { <option value="@item">@item</option> }</select>
                    </div>
                    <div class="col-md-4"><label asp-for="DateEmbauche" class="ey-label">Date d'embauche</label><input asp-for="DateEmbauche" class="ey-input" type="date" /></div>
                    <div class="col-md-4">
                        <label asp-for="Statut" class="ey-label">Statut employe</label>
                        <select asp-for="Statut" asp-items="Html.GetEnumSelectList<SIRH.EY.Models.StatutCollaborateur>()" class="ey-input"></select>
                    </div>
                    <div class="col-md-4"><label asp-for="NiveauPreparationSuccession" class="ey-label">Preparation succession (%)</label><input asp-for="NiveauPreparationSuccession" class="ey-input" type="number" min="0" max="100" /></div>
                    <div class="col-md-4">
                        <label asp-for="PotentielCarriere" class="ey-label">Potentiel carriere</label>
                        <select asp-for="PotentielCarriere" class="ey-input"><option value="">Selectionnez</option>@foreach (var item in potentielsCarriere) { <option value="@item">@item</option> }</select>
                    </div>
                    <div class="col-md-4">
                        <label class="ey-checkbox-modern ey-mt-4">
                            <input asp-for="Actif" type="checkbox" checked />
                            <span class="ey-checkbox-label">Collaborateur actif</span>
                        </label>
                    </div>
                    <div class="col-12"><label asp-for="FormationsObligatoires" class="ey-label">Formations obligatoires</label><textarea asp-for="FormationsObligatoires" class="ey-input" rows="2"></textarea></div>
                </div>
            </div>

            <div class="ey-actions-bar">
                <a asp-action="Index" class="ey-btn-premium ey-btn-ghost"><i class="fas fa-times"></i> Annuler</a>
                <div class="ey-actions-right">
                    <button type="submit" class="ey-btn-premium ey-btn-primary"><i class="fas fa-check"></i> Creer le collaborateur</button>
                </div>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script src="~/js/rh-dynamic-forms.js" asp-append-version="true"></script>
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
