@model SIRH.EY.Models.Formation

@{
    ViewData["Title"] = "Modifier une formation";
    var departements = ViewBag.Departements as IReadOnlyList<string> ?? Array.Empty<string>();
    var postes = ViewBag.Postes as IReadOnlyList<string> ?? Array.Empty<string>();
    var niveaux = ViewBag.NiveauxDifficulte as IReadOnlyList<string> ?? Array.Empty<string>();
    var domaines = ViewBag.DomainesCompetence as IReadOnlyList<string> ?? Array.Empty<string>();
}

<div class="card border-0 shadow-sm">
    <div class="card-header bg-white">
        <h5 class="mb-0"><i class="fas fa-edit text-warning me-1"></i> Modifier la formation</h5>
    </div>
    <div class="card-body">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="Id" />

            <div class="row g-3">
                <div class="col-md-6"><label asp-for="Titre" class="form-label"></label><input asp-for="Titre" class="form-control" /><span asp-validation-for="Titre" class="text-danger"></span></div>
                <div class="col-md-6"><label asp-for="Formateur" class="form-label"></label><input asp-for="Formateur" class="form-control" /></div>
                <div class="col-md-3"><label asp-for="DureeHeures" class="form-label">Duree heures</label><input asp-for="DureeHeures" class="form-control" /></div>
                <div class="col-md-3"><label asp-for="CapaciteMax" class="form-label">Capacite max</label><input asp-for="CapaciteMax" class="form-control" /></div>
                <div class="col-md-3"><label asp-for="PlacesPrises" class="form-label">Places prises</label><input asp-for="PlacesPrises" class="form-control" /></div>
                <div class="col-md-3"><label asp-for="Categorie" class="form-label">Categorie</label><input asp-for="Categorie" class="form-control" /></div>
                <div class="col-md-4"><label asp-for="Organisme" class="form-label"></label><select asp-for="Organisme" class="form-select"><option value="">Selectionnez</option><option value="Interne">Interne (EY Academy)</option><option value="Externe">Externe (partenaire)</option></select></div>
                <div class="col-md-4"><label asp-for="DateDebut" class="form-label">Date debut</label><input asp-for="DateDebut" class="form-control" type="date" /></div>
                <div class="col-md-4"><label asp-for="NiveauDifficulte" class="form-label">Difficulte</label><select asp-for="NiveauDifficulte" class="form-select"><option value="">Selectionnez</option>@foreach (var item in niveaux) { <option value="@item">@item</option> }</select></div>
            </div>

            <hr />
            <h6 class="fw-bold mb-3">Ciblage RH</h6>
            <div class="row g-3">
                <div class="col-md-3"><label asp-for="DepartementCible" class="form-label">Departement cible</label><select asp-for="DepartementCible" class="form-select"><option value="">Tous</option>@foreach (var item in departements) { <option value="@item">@item</option> }</select></div>
                <div class="col-md-3"><label asp-for="MetierCible" class="form-label">Metier cible</label><input asp-for="MetierCible" class="form-control" /></div>
                <div class="col-md-3"><label asp-for="PosteCible" class="form-label">Poste cible</label><select asp-for="PosteCible" class="form-select"><option value="">Tous</option>@foreach (var item in postes) { <option value="@item">@item</option> }</select></div>
                <div class="col-md-3"><label asp-for="DomaineCompetence" class="form-label">Domaine competence</label><select asp-for="DomaineCompetence" class="form-select"><option value="">Selectionnez</option>@foreach (var item in domaines) { <option value="@item">@item</option> }</select></div>
                <div class="col-md-8"><label asp-for="CompetenceVisee" class="form-label">Competence developpee</label><input asp-for="CompetenceVisee" class="form-control" /></div>
                <div class="col-md-4 d-flex align-items-end"><div class="form-check form-switch"><input asp-for="EstCertifiante" class="form-check-input" /><label asp-for="EstCertifiante" class="form-check-label">Formation certifiante</label></div></div>
            </div>

            <hr />
            <h6 class="fw-bold mb-3"><i class="fas fa-globe me-2 text-primary"></i>Plateforme externe & contenu</h6>
            <div class="row g-3">
                <div class="col-md-4">
                    <label asp-for="Plateforme" class="form-label">Plateforme</label>
                    <select asp-for="Plateforme" class="form-select">
                        <option value="">EY Learning (interne)</option>
                        <option value="Udemy">Udemy Business</option>
                        <option value="Microsoft Learn">Microsoft Learn</option>
                        <option value="Coursera">Coursera</option>
                        <option value="AWS Skill Builder">AWS Skill Builder</option>
                        <option value="LinkedIn Learning">LinkedIn Learning</option>
                        <option value="Google Cloud">Google Cloud</option>
                    </select>
                </div>
                <div class="col-md-8">
                    <label asp-for="ExternalUrl" class="form-label">URL externe</label>
                    <input asp-for="ExternalUrl" class="form-control" placeholder="https://www.udemy.com/course/..." />
                </div>
                <div class="col-12">
                    <label asp-for="Description" class="form-label">Description détaillée</label>
                    <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                </div>
                <div class="col-md-6">
                    <label asp-for="CompetencesRequises" class="form-label">Prérequis (séparés par virgule)</label>
                    <input asp-for="CompetencesRequises" class="form-control" />
                </div>
                <div class="col-md-6">
                    <label asp-for="CertificationNom" class="form-label">Nom de la certification</label>
                    <input asp-for="CertificationNom" class="form-control" />
                </div>
                <div class="col-md-6">
                    <label asp-for="SupportPdfUrl" class="form-label">Support PDF (URL)</label>
                    <input asp-for="SupportPdfUrl" class="form-control" />
                </div>
                <div class="col-md-6">
                    <label asp-for="MentorEmail" class="form-label">Email du mentor</label>
                    <input asp-for="MentorEmail" class="form-control" />
                </div>
                <div class="col-md-6 d-flex align-items-end gap-4">
                    <div class="form-check form-switch">
                        <input asp-for="EstStrategique" class="form-check-input" />
                        <label asp-for="EstStrategique" class="form-check-label">Stratégique</label>
                    </div>
                    <div class="form-check form-switch">
                        <input asp-for="EstForteDemande" class="form-check-input" />
                        <label asp-for="EstForteDemande" class="form-check-label">Forte demande</label>
                    </div>
                </div>
            </div>

            <div class="mt-4 d-flex gap-2">
                <button type="submit" class="btn btn-dark"><i class="fas fa-save"></i> Enregistrer</button>
                <a asp-action="Index" class="btn btn-secondary">Annuler</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
