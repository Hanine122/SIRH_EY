@{
    ViewData["Title"] = "Centre de formation EY";
    var collaborateurId = ViewBag.CollaborateurId;
    var collaborateur = ViewBag.Collaborateur as SIRH.EY.Models.Collaborateur;
    var inscriptions = ViewBag.Inscriptions as List<SIRH.EY.Models.Inscription> ?? new List<SIRH.EY.Models.Inscription>();
    var catalogue = ViewBag.Catalogue as List<SIRH.EY.Models.Formation> ?? new List<SIRH.EY.Models.Formation>();
    var toutesFormations = ViewBag.ToutesFormations as List<SIRH.EY.Models.Formation> ?? catalogue;
    var idsInscrits = ViewBag.FormationsInscritesIds as List<int> ?? new List<int>();
    var certifications = ViewBag.Certifications as List<SIRH.EY.Models.Inscription> ?? new List<SIRH.EY.Models.Inscription>();
    var departementsFormation = ViewBag.DepartementsFormation as List<string> ?? new List<string>();
    var postesFormation = ViewBag.PostesFormation as List<string> ?? new List<string>();
    var domainesFormation = ViewBag.DomainesFormation as List<string> ?? new List<string>();
    var enCours = inscriptions.Count(i => !i.Terminee);
    var premInscriptionEncours = inscriptions.FirstOrDefault(i => !i.Terminee);
    var plans = ViewBag.PlansDeveloppement as List<SIRH.EY.Models.PlanDeveloppement> ?? new List<SIRH.EY.Models.PlanDeveloppement>();

    // C# Helper to compute compatibility score
    int GetCompatibilityScore(SIRH.EY.Models.Formation f, SIRH.EY.Models.Collaborateur? c)
    {
        if (c == null) return 50;
        int score = 45; // baseline
        
        // Match job/poste
        if (!string.IsNullOrEmpty(f.PosteCible) && f.PosteCible.Equals(c.Poste, StringComparison.OrdinalIgnoreCase))
        {
            score += 35;
        }
        else if (!string.IsNullOrEmpty(f.MetierCible) && f.MetierCible.Equals(c.Poste, StringComparison.OrdinalIgnoreCase))
        {
            score += 25;
        }

        // Match department
        if (!string.IsNullOrEmpty(f.DepartementCible) && f.DepartementCible.Equals(c.Departement, StringComparison.OrdinalIgnoreCase))
        {
            score += 15;
        }

        // Match recommended plan
        if (plans.Any(p => p.FormationId == f.Id))
        {
            score += 10;
        }

        if (score > 98) score = 98; // keep realistic limit
        return score;
    }
}

@section Styles {
    <link rel="stylesheet" href="~/css/ey-formations-catalogue.css" asp-append-version="true" />
}

@if (TempData["Success"] != null)
{
    <div class="alert alert-success border-0 shadow-sm rounded-3 mb-3"><i class="fas fa-check-circle me-2"></i> @TempData["Success"]</div>
}
@if (TempData["Message"] != null)
{
    <div class="alert alert-info border-0 shadow-sm rounded-3 mb-3"><i class="fas fa-info-circle me-2"></i> @TempData["Message"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger border-0 shadow-sm rounded-3 mb-3"><i class="fas fa-exclamation-triangle me-2"></i> @TempData["Error"]</div>
}
@if (TempData["Erreur"] != null)
{
    <div class="alert alert-danger border-0 shadow-sm rounded-3 mb-3"><i class="fas fa-exclamation-triangle me-2"></i> @TempData["Erreur"]</div>
}

<div class="formations-container container-fluid px-0">
    @{
        var totalInscriptions = inscriptions.Count;
        var terminees         = inscriptions.Count(i => i.Terminee);
        var actives           = inscriptions.Count(i => !i.Terminee);
        var progress          = totalInscriptions == 0 ? 0 : (int)((double)terminees / totalInscriptions * 100);

        // Urgency: nearest upcoming exam
        var prochaineEchéance = inscriptions
            .Where(i => !i.Terminee && i.DateExamen.HasValue && i.DateExamen.Value >= DateTime.Today)
            .OrderBy(i => i.DateExamen)
            .FirstOrDefault();
        var joursAvantExamen  = prochaineEchéance != null
            ? (int)(prochaineEchéance.DateExamen!.Value - DateTime.Today).TotalDays
            : (int?)null;

        // Urgency: formation starting soon (within 7 days)
        var prochaineFormation = inscriptions
            .Where(i => !i.Terminee && i.Formation != null && i.Formation.DateDebut >= DateTime.Today)
            .OrderBy(i => i.Formation!.DateDebut)
            .FirstOrDefault();
    }

    <!-- ── Formation Dashboard Hero ────────────────────────────────────────── -->
    <div class="mes-formations-hero p-4 mb-4">
        <div class="row g-4 align-items-center">

            <!-- Left: identity + master progress -->
            <div class="col-lg-6">
                <div class="mb-1" style="font-size:10px;font-weight:700;letter-spacing:.12em;text-transform:uppercase;color:rgba(255,230,0,.7);">
                    CENTRE DE FORMATION EY
                </div>
                <h2 class="fw-bold text-white mb-1 lh-sm">
                    @(collaborateur != null ? $"{collaborateur.Prenom} {collaborateur.Nom}" : "Mon parcours de formation")
                </h2>
                @if (collaborateur != null)
                {
                    <div class="mb-3">
                        <span class="badge text-dark fw-bold" style="background:var(--ey-yellow);">
                            @((collaborateur.Grade ?? "Junior").ToUpperInvariant())
                        </span>
                        <span class="text-white-50 small ms-2">@(collaborateur.Poste ?? "")</span>
                    </div>
                }
                else
                {
                    <div class="mb-3"></div>
                }

                <!-- Urgency banner -->
                @if (joursAvantExamen.HasValue)
                {
                    <div class="d-flex align-items-center gap-2 mb-3 px-3 py-2 rounded-3"
                         style="background:@(joursAvantExamen <= 7 ? "rgba(229,72,77,.25)" : "rgba(255,230,0,.15)");
                                border:1px solid @(joursAvantExamen <= 7 ? "rgba(229,72,77,.4)" : "rgba(255,230,0,.3)");">
                        <i class="@(joursAvantExamen <= 7 ? "fas fa-exclamation-triangle text-danger" : "far fa-calendar-check text-warning")"></i>
                        <span class="@(joursAvantExamen <= 7 ? "text-danger" : "text-warning") fw-semibold small">
                            Examen dans <strong>@joursAvantExamen jour@(joursAvantExamen != 1 ? "s" : "")</strong>
                            — @prochaineEchéance?.Formation?.Titre
                        </span>
                    </div>
                }
                else if (actives > 0)
                {
                    <div class="d-flex align-items-center gap-2 mb-3 px-3 py-2 rounded-3"
                         style="background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.1);">
                        <i class="fas fa-info-circle text-white-50"></i>
                        <span class="text-white-50 small">
                            @actives formation@(actives > 1 ? "s" : "") active@(actives > 1 ? "s" : "") — aucun examen planifié
                        </span>
                    </div>
                }

                <!-- Master progress bar -->
                <div class="d-flex justify-content-between align-items-center mb-1">
                    <span class="text-white-50 small fw-semibold" style="letter-spacing:.05em;">
                        TAUX DE COMPLÉTION ANNUEL
                    </span>
                    <span class="fw-black text-white">@progress%</span>
                </div>
                <div class="progress rounded-pill" style="height:8px;background:rgba(255,255,255,.12);">
                    <div class="progress-bar rounded-pill" role="progressbar"
                         style="width:@progress%;background:linear-gradient(90deg,#d4c000,var(--ey-yellow));"
                         aria-valuenow="@progress" aria-valuemin="0" aria-valuemax="100"></div>
                </div>
            </div>

            <!-- Right: 4 KPIs -->
            <div class="col-lg-6">
                <div class="row g-2">
                    <div class="col-6">
                        <div class="rounded-3 p-3 text-center" style="background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.1);">
                            <div class="fw-black text-white" style="font-size:1.9rem;line-height:1.1;">
                                @totalInscriptions
                            </div>
                            <div class="text-white-50 small fw-semibold">Inscriptions</div>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="rounded-3 p-3 text-center" style="background:rgba(18,185,129,.14);border:1px solid rgba(18,185,129,.3);">
                            <div class="fw-black text-success" style="font-size:1.9rem;line-height:1.1;">
                                @terminees
                            </div>
                            <div class="text-white-50 small fw-semibold">Terminées</div>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="rounded-3 p-3 text-center" style="background:rgba(255,230,0,.1);border:1px solid rgba(255,230,0,.2);">
                            <div class="fw-black text-warning" style="font-size:1.9rem;line-height:1.1;">
                                @actives
                            </div>
                            <div class="text-white-50 small fw-semibold">En cours</div>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="rounded-3 p-3 text-center"
                             style="background:rgba(251,191,36,.1);border:1px solid rgba(251,191,36,.2);">
                            <div class="fw-black" style="font-size:1.9rem;line-height:1.1;color:#fbbf24;">
                                @certifications.Count
                            </div>
                            <div class="text-white-50 small fw-semibold">Certifications</div>
                            <button type="button" class="btn btn-link p-0 text-warning small fw-semibold text-decoration-none"
                                    id="btn-feuille-route" style="font-size:.7rem;">
                                Voir →
                            </button>
                        </div>
                    </div>
                </div>
            </div>

        </div>
    </div>

    <!-- Navigation Tabs -->
    <ul class="nav ey-tab mb-4" id="formationTab" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link active fw-bold border-0 px-3 py-2" id="mes-formations-tab" data-bs-toggle="tab" data-bs-target="#mes-formations" type="button" role="tab">
                <i class="fas fa-book-reader me-2"></i>Mon parcours actif
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link fw-bold border-0 px-3 py-2" id="catalogue-tab" data-bs-toggle="tab" data-bs-target="#catalogue" type="button" role="tab">
                <i class="fas fa-compass me-2"></i>Catalogue des formations
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link fw-bold border-0 px-3 py-2" id="certifications-tab" data-bs-toggle="tab" data-bs-target="#certifications" type="button" role="tab">
                <i class="fas fa-certificate me-2"></i>Mes certifications
            </button>
        </li>
        <li class="nav-item ms-auto" role="presentation">
            <a asp-action="Recommandations" asp-route-collaborateurId="@collaborateurId"
               class="nav-link fw-bold border-0 px-3 py-2 text-decoration-none">
                <i class="fas fa-rocket me-2 text-success"></i>Recommandations 
            </a>
        </li>
        <li class="nav-item" role="presentation">
            <a asp-action="ParcoursCarriere" asp-route-collaborateurId="@collaborateurId"
               class="nav-link fw-bold border-0 px-3 py-2 text-decoration-none">
                <i class="fas fa-road me-2 text-primary"></i>Parcours carrière
            </a>
        </li>
    </ul>

    <!-- Tabs Content -->
    <div class="tab-content">
        
        <!-- Tab 1: Mes Formations -->
        <div class="tab-pane fade show active" id="mes-formations" role="tabpanel">
            <div class="row g-4 align-items-start">
                <div class="col-lg-8">
                    <!-- Search -->
                    <div class="ey-form-shell p-3 mb-3">
                        <div class="input-group">
                            <span class="input-group-text border-0 bg-transparent">
                                <i class="fas fa-search text-muted"></i>
                            </span>
                            <input id="formationSearchInput"
                                   class="form-control border-0 bg-transparent"
                                   placeholder="Rechercher dans mes parcours actifs..." />
                        </div>
                    </div>

                    @if (!inscriptions.Any())
                    {
                        <div class="alert alert-light border text-center p-5 rounded-3">
                            <i class="fas fa-graduation-cap fa-3x text-muted mb-3"></i>
                            <h5 class="fw-bold text-dark">Aucune inscription active</h5>
                            <p class="text-muted small">Parcourez notre catalogue pour vous inscrire à des formations.</p>
                            <button type="button" class="ey-btn-premium-gold px-4 py-2 mt-2 border-0" onclick="document.getElementById('catalogue-tab').click();">
                                Ouvrir le catalogue
                            </button>
                        </div>
                    }
                    else
                    {
                        @foreach (var insc in inscriptions)
                        {
                            var formation = insc.Formation;
                            if (formation == null) continue;
                            var isPendingApproval = insc.Statut == SIRH.EY.Models.StatutInscription.PendingApproval;
                            var isRejected = insc.Statut == SIRH.EY.Models.StatutInscription.Rejected;
                            var statut = insc.Terminee ? "Terminée"
                                : isPendingApproval ? "En attente d'approbation"
                                : isRejected ? "Demande refusée"
                                : (insc.DateInscription.Date == DateTime.Today ? "Non commencée" : "En cours");
                            var progression = insc.Terminee ? 100 : Math.Clamp(insc.Progression, 0, 100);
                            if (!insc.Terminee && !isPendingApproval && !isRejected && progression == 0 && statut != "Non commencée")
                                progression = Math.Min(95, Math.Max(15, (DateTime.Today - insc.DateInscription.Date).Days * 5));

                            var statusBadgeClass = insc.Terminee ? "bg-success text-white"
                                : isPendingApproval ? "bg-warning text-dark"
                                : isRejected ? "bg-danger text-white"
                                : (statut == "Non commencée" ? "bg-secondary text-white" : "bg-warning text-dark");

                            // Urgency computation
                            var joursExamen = insc.DateExamen.HasValue && insc.DateExamen.Value >= DateTime.Today
                                ? (int)(insc.DateExamen.Value - DateTime.Today).TotalDays : (int?)null;
                            var isUrgent    = joursExamen.HasValue && joursExamen <= 7;

                            <div class="card ey-premium-card mb-3 p-3 formation-item @(isUrgent ? "" : "")"
                                 data-search="@(formation.Titre) @(formation.Formateur) @(formation.Categorie)"
                                 style="@(isUrgent ? "border-left:4px solid var(--ey-danger) !important;" : joursExamen.HasValue ? "border-left:4px solid var(--ey-warning) !important;" : "")">

                                @* Exam urgency banner *@
                                @if (joursExamen.HasValue && !insc.Terminee)
                                {
                                    <div class="d-flex align-items-center gap-2 mb-3 px-3 py-2 rounded-2 small"
                                         style="background:@(isUrgent ? "rgba(229,72,77,.08)" : "rgba(244,197,66,.08)");
                                                border:1px solid @(isUrgent ? "rgba(229,72,77,.25)" : "rgba(244,197,66,.25)");">
                                        <i class="@(isUrgent ? "fas fa-bell text-danger" : "far fa-calendar-check text-warning")"></i>
                                        <span class="@(isUrgent ? "text-danger" : "text-warning") fw-semibold">
                                            Examen dans @joursExamen jour@(joursExamen != 1 ? "s" : "")
                                            — @insc.DateExamen!.Value.ToString("dd/MM/yyyy")
                                        </span>
                                        @if (isUrgent)
                                        {
                                            <span class="badge bg-danger ms-auto">URGENT</span>
                                        }
                                    </div>
                                }

                                <div class="d-flex align-items-start justify-content-between flex-wrap gap-2">
                                    <div class="d-flex align-items-start gap-3 flex-grow-1">
                                        <div class="course-icon d-flex align-items-center justify-content-center flex-shrink-0">
                                            <i class="fas fa-book-open"></i>
                                        </div>
                                        <div class="w-100">
                                            <div class="d-flex gap-2 flex-wrap mb-2">
                                                <span class="badge @statusBadgeClass font-monospace rounded-pill" style="font-size:0.68rem;">@statut.ToUpper()</span>
                                                <span class="badge bg-light text-dark border font-monospace rounded-pill" style="font-size:0.68rem;">@((formation.Categorie ?? "MODULE").ToUpper())</span>
                                                <span class="badge bg-light text-dark border font-monospace rounded-pill" style="font-size:0.68rem;">@((formation.NiveauDifficulte ?? "INTERMÉDIAIRE").ToUpper())</span>
                                            </div>
                                            <h5 class="fw-bold text-dark mb-1">@formation.Titre</h5>
                                            <div class="small text-muted mb-2 d-flex align-items-center gap-3 flex-wrap">
                                                <span><i class="far fa-user me-1"></i>@(string.IsNullOrWhiteSpace(formation.Formateur) ? "Instructeur non défini" : formation.Formateur)</span>
                                                <span><i class="far fa-clock me-1"></i>@formation.DureeHeures h</span>
                                                @if (formation.EstCertifiante)
                                                {
                                                    <span class="text-primary fw-semibold"><i class="fas fa-certificate me-1"></i>Certifiante</span>
                                                }
                                            </div>
                                            
                                            <div class="learning-progress rounded-pill bg-light overflow-hidden mb-1" style="height: 6px;">
                                                <div class="progress-bar rounded-pill" style="width:@progression%; background-color:#12b981;" role="progressbar" aria-valuenow="@progression" aria-valuemin="0" aria-valuemax="100"></div>
                                            </div>
                                            <div class="d-flex justify-content-between small text-muted">
                                                <span>Progression</span>
                                                <span class="fw-bold">@progression%</span>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <div class="mt-2 border-top pt-2 d-flex gap-2 flex-wrap justify-content-end align-items-center">
                                    @if (isPendingApproval)
                                    {
                                        <div class="small text-warning fw-semibold me-auto">
                                            <i class="fas fa-hourglass-half me-1"></i> En attente d'approbation de votre manager.
                                        </div>
                                    }
                                    else if (isRejected)
                                    {
                                        <div class="small text-danger fw-semibold me-auto">
                                            <i class="fas fa-times-circle me-1"></i> Demande refusée par votre manager.
                                        </div>
                                    }
                                    else if (!insc.Terminee)
                                    {
                                        <a asp-action="ReprendreFormation" asp-route-inscriptionId="@insc.Id" class="@(statut == "Non commencée" ? "ey-btn-premium-gold" : "ey-btn-premium-main") px-4 py-2 text-decoration-none">
                                            @((statut == "Non commencée") ? "Démarrer" : "Reprendre")
                                        </a>
                                        <form asp-action="TerminerFormation" method="post" class="m-0">
                                            <input type="hidden" name="inscriptionId" value="@insc.Id" />
                                            <button type="submit" class="ey-btn-premium-ghost px-4 py-2">Marquer comme terminée</button>
                                        </form>
                                    }
                                    else
                                    {
                                        <a asp-action="TelechargerCertificat" asp-route-inscriptionId="@insc.Id" class="ey-btn-premium-ghost px-4 py-2 text-decoration-none">
                                            <i class="fas fa-download me-1"></i>Télécharger le certificat
                                        </a>
                                    }
                                </div>
                            </div>
                        }
                    }
                </div>

                <!-- Right Sidebar Column -->
                <div class="col-lg-4">
                    <!-- Recommended skills card -->
                    <div class="card p-3 border-0 shadow-sm bg-light mb-3" style="border-radius: 12px;">
                        <h5 class="fw-bold mb-1 text-dark">Compétences cibles</h5>
                        <p class="text-muted small mb-2">Recommandations priorisées selon votre poste actuel.</p>
                        <div class="d-flex flex-column gap-2 mb-2">
                            <div class="d-flex align-items-center justify-content-between bg-white p-2 rounded border border-light">
                                <span class="fw-medium small text-dark">Gestion de projet agile</span>
                                <span class="badge bg-light text-dark font-monospace rounded-pill">INTERMÉDIAIRE</span>
                            </div>
                            <div class="d-flex align-items-center justify-content-between bg-white p-2 rounded border border-light">
                                <span class="fw-medium small text-dark">Power BI avancé</span>
                                <span class="badge bg-light text-dark font-monospace rounded-pill">AVANCÉ</span>
                            </div>
                            <div class="d-flex align-items-center justify-content-between bg-white p-2 rounded border border-light">
                                <span class="fw-medium small text-dark">RGPD & conformité</span>
                                <span class="badge bg-light text-dark font-monospace rounded-pill">FONDAMENTAL</span>
                            </div>
                            <div class="d-flex align-items-center justify-content-between bg-white p-2 rounded border border-light">
                                <span class="fw-medium small text-dark">Generative AI in Audit</span>
                                <span class="badge bg-light text-dark font-monospace rounded-pill">AVANCÉ</span>
                            </div>
                        </div>
                        <a asp-controller="Competences" asp-action="Catalogue" asp-route-collaborateurId="@collaborateurId" class="ey-btn-premium-main w-100 text-center text-decoration-none text-white py-2 mb-2">
                            EXPLORER TOUTES LES COMPÉTENCES
                        </a>
                        <a asp-controller="Competences" asp-action="MatriceEquipe" asp-route-collaborateurId="@collaborateurId" class="ey-btn-premium-ghost w-100 text-center text-decoration-none py-2">
                            Matrice équipe
                        </a>
                    </div>

                    @{
                        var progressionCertif = premInscriptionEncours?.Progression ?? 0;
                        var titreCertif = premInscriptionEncours?.Formation?.Titre ?? "Aucune formation en cours";
                        var heuresTerminees = inscriptions.Where(i => i.Terminee).Sum(i => i.Formation?.DureeHeures ?? 0);
                        var nbTerminees = inscriptions.Count(i => i.Terminee);
                    }
                    <!-- Next certification planning -->
                    <div class="card p-3 border-0 shadow-sm text-white mb-3" style="background: linear-gradient(135deg, #1e1e1e 0%, #3a3a3a 100%); border-radius: 12px;">
                        <div class="small text-warning fw-bold mb-1" style="letter-spacing: 0.05em;">FORMATION EN COURS</div>
                        <h6 class="fw-bold mb-1 text-white" title="@titreCertif">
                            @(titreCertif.Length > 40 ? titreCertif.Substring(0, 37) + "…" : titreCertif)
                        </h6>
                        @if (premInscriptionEncours != null)
                        {
                            <div class="small text-white-50 mb-2">Progression : @progressionCertif%</div>
                            <div class="progress rounded-pill bg-dark mb-2" style="height: 6px;">
                                <div class="progress-bar rounded-pill" style="width: @progressionCertif%; background-color:#ffe600;" role="progressbar"></div>
                            </div>
                            <a asp-action="PlanifierExamen" asp-route-inscriptionId="@premInscriptionEncours.Id" class="ey-btn-premium-gold w-100 text-decoration-none text-dark py-2 text-center">
                                <i class="far fa-calendar-check me-1"></i>Planifier l'examen
                            </a>
                        }
                        else
                        {
                            <div class="small text-white-50 mb-2">Aucune formation active</div>
                            <button type="button" class="btn btn-warning w-100 opacity-50 py-2" disabled title="Inscrivez-vous à une formation en cours pour activer.">
                                <i class="far fa-calendar-check me-1"></i>Planifier l'examen
                            </button>
                            <div class="small text-white-50 mt-2 text-center" style="font-size:0.75rem;">Inscrivez-vous à une formation pour planifier un examen.</div>
                        }
                    </div>

                    <!-- Statistics card -->
                    <div class="card p-3 border-0 shadow-sm bg-light" style="border-radius: 12px;">
                        <h5 class="fw-bold mb-1 text-dark">Votre impact</h5>
                        <p class="text-muted small mb-2">Heures cumulées d'apprentissage</p>
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <span class="fw-bold text-dark fs-5">@heuresTerminees h</span>
                            <span class="small text-muted">@nbTerminees formation(s) terminée(s)</span>
                        </div>
                        <div class="row g-2 mt-1">
                            <div class="col-6">
                                <div class="bg-white p-2 rounded text-center border border-light">
                                    <div class="fw-bold fs-5 text-dark">@nbTerminees</div>
                                    <small class="text-muted font-monospace" style="font-size:0.65rem;">TERMINÉES</small>
                                </div>
                            </div>
                            <div class="col-6">
                                <div class="bg-white p-2 rounded text-center border border-light">
                                    <div class="fw-bold fs-5 text-dark">@enCours</div>
                                    <small class="text-muted font-monospace" style="font-size:0.65rem;">EN COURS</small>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Tab 2: Catalogue complet des Formations -->
        <div class="tab-pane fade" id="catalogue" role="tabpanel">
            
            <!-- Filters Card Panel -->
            <div class="ey-premium-filter-card p-3 mb-4">
                <h6 class="fw-bold text-dark mb-3"><i class="fas fa-filter text-warning me-2"></i>Filtres de recherche avancés</h6>
                <div class="row g-3 align-items-end">
                    <div class="col-lg-3 col-md-6">
                        <label class="form-label small">Recherche textuelle</label>
                        <div class="input-group input-group-sm">
                            <span class="input-group-text bg-white border-end-0"><i class="fas fa-search text-muted"></i></span>
                            <input id="formationCatalogSearchInput" class="form-control border-start-0" placeholder="Formation, instructeur, compétence..." />
                        </div>
                    </div>
                    <div class="col-lg-2 col-md-6">
                        <label class="form-label small">Département</label>
                        <select id="formationDepartmentFilter" class="form-select form-select-sm">
                            <option value="">Tous</option>
                            @foreach (var item in departementsFormation) { <option value="@item">@item</option> }
                        </select>
                    </div>
                    <div class="col-lg-2 col-md-6">
                        <label class="form-label small">Domaine</label>
                        <select id="formationDomainFilter" class="form-select form-select-sm">
                            <option value="">Tous</option>
                            @foreach (var item in domainesFormation) { <option value="@item">@item</option> }
                        </select>
                    </div>
                    <div class="col-lg-2 col-md-6">
                        <label class="form-label small">Poste cible</label>
                        <select id="formationRoleFilter" class="form-select form-select-sm">
                            <option value="">Tous</option>
                            <option value="Tous roles">Tous rôles</option>
                            @foreach (var item in postesFormation) { <option value="@item">@item</option> }
                        </select>
                    </div>
                    <div class="col-lg-1 col-md-4">
                        <label class="form-label small">Niveau</label>
                        <select id="formationLevelFilter" class="form-select form-select-sm">
                            <option value="">Tous</option>
                            <option value="Fondamental">Fondamental</option>
                            <option value="Débutant">Débutant</option>
                            <option value="Intermédiaire">Intermédiaire</option>
                            <option value="Avancé">Avancé</option>
                            <option value="Expert">Expert</option>
                        </select>
                    </div>
                    <div class="col-lg-1 col-md-4">
                        <label class="form-label small">Certifiante</label>
                        <select id="formationCertifiedFilter" class="form-select form-select-sm">
                            <option value="">Tous</option>
                            <option value="true">Oui</option>
                            <option value="false">Non</option>
                        </select>
                    </div>
                    <div class="col-lg-1 col-md-4">
                        <label class="form-label small">Obligatoire</label>
                        <select id="formationMandatoryFilter" class="form-select form-select-sm">
                            <option value="">Tous</option>
                            <option value="true">Oui</option>
                            <option value="false">Non</option>
                        </select>
                    </div>
                </div>
            </div>

            <!-- Strategic Sections Area -->
            <div id="strategicSectionsArea" class="mb-4">
                <div class="row g-3">
                    
                    <!-- Strategic Block 1: Recommandé pour votre évolution (C# logic) -->
                    <div class="col-lg-6">
                        <div class="card p-3 border-0 shadow-sm strategic-panel-card h-100">
                            <h6 class="strategic-section-title fw-bold mb-3">
                                <i class="fas fa-rocket text-success"></i>Recommandé pour votre évolution
                            </h6>
                            <div class="d-flex flex-column gap-2">
                                @{
                                    var recommandes = toutesFormations
                                        .Where(f => !idsInscrits.Contains(f.Id) &&
                                                    (plans.Any(p => p.FormationId == f.Id) || 
                                                     (collaborateur != null && (f.PosteCible == collaborateur.Poste || f.DepartementCible == collaborateur.Departement))))
                                        .Take(3)
                                        .ToList();
                                }
                                @if (!recommandes.Any())
                                {
                                    <div class="text-muted small p-2">Aucune nouvelle recommandation de développement.</div>
                                }
                                @foreach (var rec in recommandes)
                                {
                                    <div class="d-flex align-items-center justify-content-between p-2 rounded bg-white border border-light hover-shadow-sm transition-all" style="font-size: 0.85rem;">
                                        <div class="d-flex align-items-center gap-2">
                                            <span class="ey-badge-pill badge-recommended" style="font-size:0.62rem;">RECOMMANDÉ</span>
                                            <span class="fw-semibold text-dark">@rec.Titre</span>
                                        </div>
                                        <div class="d-flex align-items-center gap-3">
                                            <span class="text-muted">@rec.DureeHeures h</span>
                                            <a href="javascript:void(0)" onclick="quickRegister(@rec.Id)" class="btn btn-sm btn-dark px-3 py-1 font-monospace" style="font-size:0.7rem;">S'INSCRIRE</a>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>

                    <!-- Strategic Block 2: Formations Tendance (C# logic) -->
                    <div class="col-lg-6">
                        <div class="card p-3 border-0 shadow-sm strategic-panel-card h-100">
                            <h6 class="strategic-section-title fw-bold mb-3">
                                <i class="fas fa-fire text-danger"></i>Formations tendance chez EY
                            </h6>
                            <div class="d-flex flex-column gap-2">
                                @{
                                    var tendances = toutesFormations
                                        .Where(f => !idsInscrits.Contains(f.Id) && 
                                                    (f.PlacesPrises >= 6 || f.Titre.Contains("AI", StringComparison.OrdinalIgnoreCase) || f.Titre.Contains("Excel", StringComparison.OrdinalIgnoreCase)))
                                        .Take(3)
                                        .ToList();
                                }
                                @if (!tendances.Any())
                                {
                                    <div class="text-muted small p-2">Aucune formation en tendance actuellement.</div>
                                }
                                @foreach (var tend in tendances)
                                {
                                    <div class="d-flex align-items-center justify-content-between p-2 rounded bg-white border border-light hover-shadow-sm transition-all" style="font-size: 0.85rem;">
                                        <div class="d-flex align-items-center gap-2">
                                            <span class="ey-badge-pill badge-highdemand" style="font-size:0.62rem;">TENDANCE</span>
                                            <span class="fw-semibold text-dark">@tend.Titre</span>
                                        </div>
                                        <div class="d-flex align-items-center gap-3">
                                            <span class="text-muted"><i class="fas fa-users me-1"></i>@tend.PlacesPrises inscrits</span>
                                            <a href="javascript:void(0)" onclick="quickRegister(@tend.Id)" class="btn btn-sm btn-dark px-3 py-1 font-monospace" style="font-size:0.7rem;">S'INSCRIRE</a>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>

                    <!-- Strategic Block 3: Certification stratégique (C# logic) -->
                    <div class="col-lg-6">
                        <div class="card p-3 border-0 shadow-sm strategic-panel-card h-100">
                            <h6 class="strategic-section-title fw-bold mb-3">
                                <i class="fas fa-trophy text-warning"></i>Certifications stratégiques
                            </h6>
                            <div class="d-flex flex-column gap-2">
                                @{
                                    var certfs = toutesFormations
                                        .Where(f => !idsInscrits.Contains(f.Id) && (f.EstCertifiante || f.Titre.Contains("PMP", StringComparison.OrdinalIgnoreCase)))
                                        .Take(3)
                                        .ToList();
                                }
                                @if (!certfs.Any())
                                {
                                    <div class="text-muted small p-2">Aucune certification disponible.</div>
                                }
                                @foreach (var ctf in certfs)
                                {
                                    <div class="d-flex align-items-center justify-content-between p-2 rounded bg-white border border-light hover-shadow-sm transition-all" style="font-size: 0.85rem;">
                                        <div class="d-flex align-items-center gap-2">
                                            <span class="ey-badge-pill badge-certified" style="font-size:0.62rem;">CERTIFIANT</span>
                                            <span class="fw-semibold text-dark">@ctf.Titre</span>
                                        </div>
                                        <div class="d-flex align-items-center gap-3">
                                            <span class="text-muted">Examen inclus</span>
                                            <a href="javascript:void(0)" onclick="quickRegister(@ctf.Id)" class="btn btn-sm btn-dark px-3 py-1 font-monospace" style="font-size:0.7rem;">S'INSCRIRE</a>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>

                    <!-- Strategic Block 4: Progression de carrière -->
                    <div class="col-lg-6">
                        <div class="card p-3 border-0 shadow-sm strategic-panel-card h-100 d-flex flex-column justify-content-between" style="background: linear-gradient(135deg, #ffffff 0%, #f6f8fd 100%);">
                            <div>
                                <h6 class="strategic-section-title fw-bold mb-2">
                                    <i class="fas fa-user-tie text-primary"></i>Votre progression de carrière
                                </h6>
                                <p class="text-muted small mb-2">
                                    Chez EY, le développement continu de vos compétences est le moteur de votre avancement. Chaque formation complétée alimente votre profil et vous rapproche de vos objectifs de promotion.
                                </p>
                            </div>
                            <div class="d-flex align-items-center gap-3 border-top pt-2">
                                <div class="small fw-semibold text-dark"><i class="fas fa-bullseye text-warning me-1"></i>Objectif Grade Supérieur :</div>
                                <span class="badge bg-light text-dark font-monospace rounded-pill border">@(collaborateur?.Grade == "Junior" ? "Senior" : (collaborateur?.Grade == "Senior" ? "Manager" : "Director"))</span>
                            </div>
                        </div>
                    </div>

                </div>
            </div>

            <!-- Full Catalogue Grid -->
            <h5 class="fw-bold text-dark mb-3"><i class="fas fa-list text-muted me-2"></i>Toutes les formations disponibles</h5>
            <div class="row g-4">
                @if (!toutesFormations.Any())
                {
                    <div class="col-12"><div class="alert alert-light text-center border p-5">Aucune formation dans le référentiel.</div></div>
                }
                else
                {
                    @foreach (var f in toutesFormations)
                    {
                        var deja = idsInscrits.Contains(f.Id);
                        
                        // Smart Badges calculation
                        bool isMandatory = f.Titre.Contains("RGPD", StringComparison.OrdinalIgnoreCase) || 
                                           f.Titre.Contains("Conformité", StringComparison.OrdinalIgnoreCase) ||
                                           (collaborateur != null && !string.IsNullOrEmpty(collaborateur.FormationsObligatoires) && 
                                            collaborateur.FormationsObligatoires.Contains(f.Titre, StringComparison.OrdinalIgnoreCase));

                        bool isRecommended = plans.Any(p => p.FormationId == f.Id) || 
                                             (collaborateur != null && (f.PosteCible == collaborateur.Poste || f.DepartementCible == collaborateur.Departement));

                        bool isForteDemande = f.PlacesPrises >= 6 || 
                                              f.Titre.Contains("AI", StringComparison.OrdinalIgnoreCase) || 
                                              f.Titre.Contains("Excel", StringComparison.OrdinalIgnoreCase);

                        bool isStrategic = f.EstCertifiante || 
                                           f.Titre.Contains("Leadership", StringComparison.OrdinalIgnoreCase) || 
                                           f.Titre.Contains("Agile", StringComparison.OrdinalIgnoreCase);

                        int compatScore = GetCompatibilityScore(f, collaborateur);
                        
                        var targetDept = f.DepartementCible ?? f.Categorie ?? "Tous";
                        var targetRole = f.PosteCible ?? "Tous roles";
                        var targetDomain = f.DomaineCompetence ?? f.CompetenceVisee ?? "Général";
                        var difficulty = f.NiveauDifficulte ?? "Intermédiaire";

                        <div class="col-md-6 col-xl-4 d-flex">
                            <div class="card ey-premium-card w-100 p-3 d-flex flex-column justify-content-between formation-catalogue-item"
                                 data-search="@(f.Titre) @(f.Formateur) @(f.Categorie) @(f.CompetenceVisee) @(f.DepartementCible) @(f.PosteCible) @(f.MetierCible) @(f.DomaineCompetence) @(difficulty)"
                                 data-department="@targetDept"
                                 data-domain="@targetDomain"
                                 data-role="@targetRole"
                                 data-level="@difficulty"
                                 data-certified="@(f.EstCertifiante ? "true" : "false")"
                                 data-mandatory="@(isMandatory ? "true" : "false")">
                                
                                <div>
                                    <!-- Badges List -->
                                    <div class="d-flex flex-wrap gap-1 mb-2">
                                        @if (isMandatory)
                                        {
                                            <span class="ey-badge-pill badge-mandatory"><i class="fas fa-exclamation-circle"></i>Obligatoire</span>
                                        }
                                        @if (f.EstCertifiante)
                                        {
                                            <span class="ey-badge-pill badge-certified"><i class="fas fa-certificate"></i>Certifiante</span>
                                        }
                                        @if (isRecommended)
                                        {
                                            <span class="ey-badge-pill badge-recommended"><i class="fas fa-thumbs-up"></i>Recommandée</span>
                                        }
                                        @if (isForteDemande)
                                        {
                                            <span class="ey-badge-pill badge-highdemand"><i class="fas fa-bolt"></i>Forte demande</span>
                                        }
                                        @if (isStrategic)
                                        {
                                            <span class="ey-badge-pill badge-strategic"><i class="fas fa-crown"></i>Stratégique</span>
                                        }
                                    </div>

                                    <!-- Platform badge -->
                                    @if (!string.IsNullOrEmpty(f.Plateforme))
                                    {
                                        var platColor = f.Plateforme switch {
                                            "Udemy"             => "#A435F0",
                                            "Microsoft Learn"   => "#0078D4",
                                            "Coursera"          => "#0056D3",
                                            "AWS Skill Builder" => "#FF9900",
                                            "LinkedIn Learning" => "#0A66C2",
                                            _                   => "#2E2E38"
                                        };
                                        var platIcon = f.Plateforme switch {
                                            "Udemy"             => "fab fa-udemy",
                                            "Microsoft Learn"   => "fab fa-microsoft",
                                            "Coursera"          => "fas fa-graduation-cap",
                                            "AWS Skill Builder" => "fab fa-aws",
                                            "LinkedIn Learning" => "fab fa-linkedin",
                                            _                   => "fas fa-building"
                                        };
                                        <div class="mb-2">
                                            <span class="badge rounded-pill px-2 py-1 fw-semibold"
                                                  style="background:@(platColor)18;color:@platColor;border:1px solid @(platColor)30;font-size:.66rem;">
                                                <i class="@platIcon me-1"></i>@f.Plateforme
                                            </span>
                                        </div>
                                    }
                                    <!-- Title & Meta -->
                                    <h5 class="fw-bold text-dark mb-1 text-clamp-2" style="line-height: 1.3;">@f.Titre</h5>
                                    <div class="small text-muted mb-3">@(string.IsNullOrWhiteSpace(f.Formateur) ? "Formateur à confirmer" : f.Formateur)</div>

                                    <!-- Role Compatibility Progress track -->
                                    <div class="compat-indicator-container">
                                        <div class="d-flex justify-content-between align-items-center small mb-1">
                                            <span class="text-muted fw-medium">Adéquation poste ciblé</span>
                                            <span class="fw-bold" style="color:#b78103;">@compatScore%</span>
                                        </div>
                                        <div class="compat-progress-bar">
                                            <div class="compat-progress-fill" style="width: @compatScore%;"></div>
                                        </div>
                                    </div>

                                    <!-- Card Details Grid -->
                                    <div class="ey-card-details-grid">
                                        <div class="ey-detail-item">
                                            <i class="far fa-clock"></i>
                                            <span>@f.DureeHeures h</span>
                                        </div>
                                        <div class="ey-detail-item">
                                            <i class="fas fa-users"></i>
                                            <span>Places : @(f.CapaciteMax - f.PlacesPrises) / @f.CapaciteMax</span>
                                        </div>
                                        <div class="ey-detail-item">
                                            <i class="fas fa-building"></i>
                                            <span class="text-truncate" title="@targetDept">@targetDept</span>
                                        </div>
                                        <div class="ey-detail-item">
                                            <i class="fas fa-signal"></i>
                                            <span>@difficulty</span>
                                        </div>
                                    </div>

                                    <!-- Covered skills tags -->
                                    @if (!string.IsNullOrWhiteSpace(f.CompetenceVisee))
                                    {
                                        <div class="covered-skills-container mb-3">
                                            <span class="small text-muted d-block mb-1 fw-semibold">Compétence visée :</span>
                                            <span class="skill-tag">@f.CompetenceVisee</span>
                                            @if (!string.IsNullOrWhiteSpace(f.DomaineCompetence) && f.DomaineCompetence != f.CompetenceVisee)
                                            {
                                                <span class="skill-tag">@f.DomaineCompetence</span>
                                            }
                                        </div>
                                    }
                                </div>

                                <!-- Actions Buttons -->
                                <div class="mt-3">
                                    @if (deja)
                                    {
                                        <div class="d-flex gap-2">
                                            <button class="ey-btn-premium-disabled flex-grow-1" disabled><i class="fas fa-check me-1"></i>Inscrit</button>
                                            <a asp-action="Details" asp-route-id="@f.Id" asp-route-collaborateurId="@collaborateurId"
                                               class="ey-btn-premium-ghost px-3 text-decoration-none" title="Voir les détails">
                                                <i class="fas fa-eye"></i>
                                            </a>
                                        </div>
                                    }
                                    else if (f.PlacesPrises < f.CapaciteMax)
                                    {
                                        <div class="d-flex gap-2">
                                            <form asp-action="Inscrire" method="post" id="form-inscrire-@f.Id" class="m-0 flex-grow-1">
                                                <input type="hidden" name="formationId" value="@f.Id" />
                                                <input type="hidden" name="collaborateurId" value="@collaborateurId" />
                                                <button type="submit" class="ey-btn-premium-gold w-100">S'inscrire</button>
                                            </form>
                                            <a asp-action="Details" asp-route-id="@f.Id" asp-route-collaborateurId="@collaborateurId"
                                               class="ey-btn-premium-ghost px-3 text-decoration-none" title="Voir les détails">
                                                <i class="fas fa-eye"></i>
                                            </a>
                                        </div>
                                        @if (!string.IsNullOrEmpty(f.ExternalUrl))
                                        {
                                            <a href="@f.ExternalUrl" target="_blank" rel="noopener"
                                               class="btn btn-sm btn-outline-secondary w-100 mt-2 small">
                                                <i class="fas fa-external-link-alt me-1"></i>Aperçu externe
                                            </a>
                                        }
                                    }
                                    else
                                    {
                                        <button class="ey-btn-premium-disabled w-100" disabled>Complet</button>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                }
            </div>

        </div>

        <!-- Tab 3: Certifications -->
        <div class="tab-pane fade" id="certifications" role="tabpanel">
            <div class="row g-4">
                @if (!certifications.Any())
                {
                    <div class="col-12">
                        <div class="alert alert-light border text-center p-5 rounded-3">
                            <i class="fas fa-award fa-3x text-muted mb-3"></i>
                            <h5 class="fw-bold text-dark">Aucune certification obtenue</h5>
                            <p class="text-muted small">Finalisez vos parcours de formation actifs pour générer et valider vos certifications EY.</p>
                        </div>
                    </div>
                }
                else
                {
                    @foreach (var certif in certifications)
                    {
                        var formation = certif.Formation;
                        if (formation == null) continue;
                        <div class="col-md-6 col-xl-4 d-flex">
                            <div class="card ey-premium-card w-100 p-3 d-flex flex-column justify-content-between">
                                <div>
                                    <div class="text-warning mb-2 fs-4"><i class="fas fa-certificate"></i></div>
                                    <h5 class="fw-bold text-dark mb-1">@formation.Titre</h5>
                                    <div class="small text-muted mb-3">Organisme : @(string.IsNullOrEmpty(formation.Organisme) ? "EY Learning" : formation.Organisme)</div>
                                    
                                    <!-- Source platform badge -->
                                    @if (!string.IsNullOrEmpty(certif.SourceCertification) || !string.IsNullOrEmpty(formation.Plateforme))
                                    {
                                        var src = certif.SourceCertification ?? formation.Plateforme ?? "EY Learning";
                                        var srcColor = src switch {
                                            "Udemy"             => "#A435F0",
                                            "Microsoft Learn"   => "#0078D4",
                                            "Coursera"          => "#0056D3",
                                            "AWS Skill Builder" => "#FF9900",
                                            "LinkedIn Learning" => "#0A66C2",
                                            _                   => "#2E2E38"
                                        };
                                        <div class="mb-2">
                                            <span class="badge rounded-pill px-2 py-1"
                                                  style="background:@(srcColor)18;color:@srcColor;border:1px solid @(srcColor)30;font-size:.68rem;">
                                                <i class="fas fa-building me-1"></i>@src
                                            </span>
                                        </div>
                                    }

                                    <div class="ey-card-details-grid border-bottom-0 pb-0">
                                        <div class="ey-detail-item">
                                            <i class="far fa-calendar-alt"></i>
                                            <span>Obtenue le : @((certif.DateCompletion ?? certif.DateInscription).ToString("dd/MM/yyyy"))</span>
                                        </div>
                                        <div class="ey-detail-item">
                                            <i class="far fa-clock"></i>
                                            <span>Durée : @formation.DureeHeures h</span>
                                        </div>
                                        @if (certif.DateExpiration.HasValue)
                                        {
                                            var expiree = certif.DateExpiration.Value < DateTime.Today;
                                            <div class="ey-detail-item @(expiree ? "text-danger" : "")">
                                                <i class="far fa-calendar-times"></i>
                                                <span>Expire : @certif.DateExpiration.Value.ToString("dd/MM/yyyy") @(expiree ? "(expirée)" : "")</span>
                                            </div>
                                        }
                                    </div>
                                </div>
                                <div class="mt-3 pt-3 border-top d-flex gap-2 flex-wrap">
                                    <a asp-action="TelechargerCertificat" asp-route-inscriptionId="@certif.Id"
                                       class="ey-btn-premium-main flex-grow-1 text-decoration-none py-2 text-center text-white">
                                        <i class="fas fa-download me-1"></i>Certificat PDF
                                    </a>
                                    <a asp-action="Details" asp-route-id="@formation.Id" asp-route-collaborateurId="@collaborateurId"
                                       class="ey-btn-premium-ghost px-3 text-decoration-none" title="Détails">
                                        <i class="fas fa-eye"></i>
                                    </a>
                                    @if (certif.EvaluationPostFormation != null)
                                    {
                                        if (certif.EvaluationSuiviFormation == null)
                                        {
                                            <a asp-action="EvaluationSuivi" asp-route-inscriptionId="@certif.Id"
                                               class="ey-btn-premium-ghost px-3 text-decoration-none" title="Évaluation de suivi">
                                                <i class="fas fa-chart-line"></i>
                                            </a>
                                        }
                                        else
                                        {
                                            <span class="ey-btn-premium-ghost px-3 text-success" title="Évaluation de suivi complétée">
                                                <i class="fas fa-check-circle"></i>
                                            </span>
                                        }
                                    }
                                </div>
                            </div>
                        </div>
                    }
                }
            </div>
        </div>

    </div>
</div>

<script>
    document.getElementById('btn-feuille-route')?.addEventListener('click', function () {
        var el = document.getElementById('certifications-tab');
        if (el && window.bootstrap && bootstrap.Tab) {
            bootstrap.Tab.getOrCreateInstance(el).show();
        }
    });

    // Deep-link a specific tab from the sidebar (?tab=mes-formations|catalogue|certifications).
    (function () {
        var requestedTab = new URLSearchParams(window.location.search).get('tab');
        if (!requestedTab) return;
        var tabButton = document.getElementById(requestedTab + '-tab');
        if (tabButton && window.bootstrap && bootstrap.Tab) {
            bootstrap.Tab.getOrCreateInstance(tabButton).show();
        }
    })();

    // Quick registration helper
    function quickRegister(formationId) {
        const form = document.getElementById('form-inscrire-' + formationId);
        if (form) {
            form.submit();
        } else {
            alert("Erreur: Impossible de s'inscrire directement. Veuillez utiliser le bouton de la carte correspondante.");
        }
    }

    // Mes Formations Search
    document.getElementById('formationSearchInput')?.addEventListener('input', function () {
        const q = (this.value || '').toLowerCase().trim();
        document.querySelectorAll('.formation-item').forEach(function (el) {
            const text = (el.getAttribute('data-search') || '').toLowerCase();
            el.style.display = !q || text.includes(q) ? '' : 'none';
        });
    });

    // Catalogue filters
    const catalogSearch = document.getElementById('formationCatalogSearchInput');
    const departmentFilter = document.getElementById('formationDepartmentFilter');
    const domainFilter = document.getElementById('formationDomainFilter');
    const roleFilter = document.getElementById('formationRoleFilter');
    const levelFilter = document.getElementById('formationLevelFilter');
    const certifiedFilter = document.getElementById('formationCertifiedFilter');
    const mandatoryFilter = document.getElementById('formationMandatoryFilter');

    function applyFormationCatalogFilters() {
        const q = (catalogSearch?.value || '').toLowerCase().trim();
        const department = departmentFilter?.value || '';
        const domain = domainFilter?.value || '';
        const role = roleFilter?.value || '';
        const level = levelFilter?.value || '';
        const certified = certifiedFilter?.value || '';
        const mandatory = mandatoryFilter?.value || '';

        document.querySelectorAll('.formation-catalogue-item').forEach(function (el) {
            const text = (el.getAttribute('data-search') || '').toLowerCase();
            const dataDept = el.getAttribute('data-department') || '';
            const dataDomain = el.getAttribute('data-domain') || '';
            const dataRole = el.getAttribute('data-role') || '';
            const dataLevel = el.getAttribute('data-level') || '';
            const dataCertified = el.getAttribute('data-certified') || '';
            const dataMandatory = el.getAttribute('data-mandatory') || '';

            const matchesSearch = !q || text.includes(q);
            const matchesDepartment = !department || dataDept === department;
            const matchesDomain = !domain || dataDomain === domain;
            
            // Handle role mapping fallback
            const matchesRole = !role || (role === 'Tous roles' && (dataRole === '' || dataRole === 'Tous roles')) || dataRole === role;
            
            // Level match with accent normalization
            let matchesLevel = !level;
            if (level) {
                const normalize = (s) => s.toLowerCase().normalize("NFD").replace(/[\u0300-\u036f]/g, "");
                matchesLevel = normalize(dataLevel).includes(normalize(level)) || normalize(level).includes(normalize(dataLevel));
            }

            const matchesCertified = !certified || dataCertified === certified;
            const matchesMandatory = !mandatory || dataMandatory === mandatory;

            const isVisible = matchesSearch && matchesDepartment && matchesDomain && matchesRole && matchesLevel && matchesCertified && matchesMandatory;
            el.closest('[class*="col-"]').style.display = isVisible ? 'flex' : 'none';
        });
    }

    [catalogSearch, departmentFilter, domainFilter, roleFilter, levelFilter, certifiedFilter, mandatoryFilter].forEach(function (el) {
        el?.addEventListener('input', applyFormationCatalogFilters);
        el?.addEventListener('change', applyFormationCatalogFilters);
    });
</script>
