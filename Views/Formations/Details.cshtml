@model SIRH.EY.Models.FormationDetailViewModel

@{
    ViewData["Title"] = Model.Formation.Titre;
    var f    = Model.Formation;
    var insc = Model.InscriptionActuelle;
    var prog = insc != null ? (insc.Terminee ? 100 : Math.Clamp(insc.Progression, 0, 100)) : 0;
    var placesDisponibles = f.CapaciteMax - f.PlacesPrises;
    var tauxRemplissage   = f.CapaciteMax > 0 ? (int)((double)f.PlacesPrises / f.CapaciteMax * 100) : 0;
}

@section Styles {
    <link rel="stylesheet" href="~/css/ey-formations-catalogue.css" asp-append-version="true" />
}

@if (TempData["Success"] != null)
{
    <div class="alert alert-success border-0 shadow-sm rounded-3 mb-3"><i class="fas fa-check-circle me-2"></i>@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger border-0 shadow-sm rounded-3 mb-3"><i class="fas fa-exclamation-triangle me-2"></i>@TempData["Error"]</div>
}

<!-- Breadcrumb -->
<nav aria-label="breadcrumb" class="mb-4">
    <ol class="breadcrumb small mb-0">
        <li class="breadcrumb-item">
            <a asp-action="Index" asp-route-collaborateurId="@Model.CollaborateurId" class="text-decoration-none">
                Centre de formation
            </a>
        </li>
        <li class="breadcrumb-item active" aria-current="page">@f.Titre</li>
    </ol>
</nav>

<div class="row g-4">

    <!-- ── LEFT: Formation detail ─────────────────────────────────────────────── -->
    <div class="col-lg-8">

        <!-- ─ Hero banner ─ -->
        <div class="card border-0 shadow-sm mb-4" style="border-radius:16px;overflow:hidden;">
            <div class="p-4" style="background:linear-gradient(135deg,#1A1A24 0%,#2E2E38 100%);">

                <!-- Badges row -->
                <div class="d-flex align-items-start justify-content-between gap-3 flex-wrap mb-3">
                    <div class="d-flex flex-wrap gap-2">
                        @if (!string.IsNullOrEmpty(f.Plateforme))
                        {
                            <span class="badge fw-bold px-3 py-2 rounded-pill"
                                  style="background:@Model.PlatformeCouleur;color:#fff;font-size:.72rem;">
                                <i class="@Model.PlateformeIconClass me-1"></i>@f.Plateforme
                            </span>
                        }
                        @if (f.EstCertifiante)   { <span class="ey-badge-pill badge-certified"><i class="fas fa-certificate"></i>Certifiante</span> }
                        @if (f.EstStrategique)   { <span class="ey-badge-pill badge-strategic"><i class="fas fa-crown"></i>Stratégique</span> }
                        @if (f.EstForteDemande)  { <span class="ey-badge-pill badge-highdemand"><i class="fas fa-bolt"></i>Forte demande</span> }
                        @if (Model.EstObligatoire) { <span class="ey-badge-pill badge-mandatory"><i class="fas fa-exclamation-circle"></i>Obligatoire</span> }
                    </div>
                    @if (Model.ScoreAdequation > 0)
                    {
                        <div class="text-end flex-shrink-0">
                            <div class="fw-black text-warning lh-1" style="font-size:1.8rem;">@Model.ScoreAdequation%</div>
                            <div class="text-white-50 small">Adéquation</div>
                        </div>
                    }
                </div>

                <h1 class="fw-black text-white mb-2 lh-sm" style="font-size:1.55rem;">@f.Titre</h1>
                <div class="text-white-50 small">
                    <i class="far fa-user me-1"></i>
                    @(string.IsNullOrWhiteSpace(f.Formateur) ? "Formateur à confirmer" : f.Formateur)
                    @if (!string.IsNullOrEmpty(f.Organisme))
                    {
                        <span class="mx-2 opacity-40">·</span>
                        <i class="fas fa-building me-1"></i>@f.Organisme
                    }
                </div>
            </div>

            <!-- Quick stats bar -->
            <div class="bg-white px-4 py-3 border-top">
                <div class="row g-2 text-center">
                    <div class="col-3">
                        <div class="fw-bold text-dark">@f.DureeHeures h</div>
                        <div class="text-muted" style="font-size:.72rem;">Durée</div>
                    </div>
                    <div class="col-3">
                        <div class="fw-bold text-dark">@(f.NiveauDifficulte ?? "—")</div>
                        <div class="text-muted" style="font-size:.72rem;">Niveau</div>
                    </div>
                    <div class="col-3">
                        <div class="fw-bold @(placesDisponibles <= 3 ? "text-danger" : "text-success")">@placesDisponibles / @f.CapaciteMax</div>
                        <div class="text-muted" style="font-size:.72rem;">Places dispo.</div>
                    </div>
                    <div class="col-3">
                        <div class="fw-bold text-dark">@f.DateDebut.ToString("dd/MM/yy")</div>
                        <div class="text-muted" style="font-size:.72rem;">Début</div>
                    </div>
                </div>
            </div>
        </div>

        <!-- ─ Description ─ -->
        @if (!string.IsNullOrWhiteSpace(f.Description))
        {
            <div class="card border-0 shadow-sm mb-4 p-4" style="border-radius:16px;">
                <h5 class="fw-bold text-dark mb-3">
                    <i class="fas fa-info-circle text-warning me-2"></i>À propos de cette formation
                </h5>
                <p class="text-secondary lh-lg mb-0" style="font-size:.95rem;">@f.Description</p>
            </div>
        }

        <!-- ─ Compétences développées / requises ─ -->
        @if (Model.CompetencesDeveloppees.Any() || Model.CompetencesPrerequisListe.Any())
        {
            <div class="card border-0 shadow-sm mb-4 p-4" style="border-radius:16px;">
                <div class="row g-4">
                    @if (Model.CompetencesDeveloppees.Any())
                    {
                        <div class="@(Model.CompetencesPrerequisListe.Any() ? "col-md-6" : "col-12")">
                            <h6 class="fw-bold text-success mb-3">
                                <i class="fas fa-check-circle me-2"></i>Compétences développées
                            </h6>
                            <div class="d-flex flex-wrap gap-2">
                                @foreach (var c in Model.CompetencesDeveloppees)
                                {
                                    <span class="badge rounded-pill px-3 py-2 fw-semibold"
                                          style="background:#e6f9f0;color:#0d7a4e;border:1px solid #a8dfc5;">
                                        <i class="fas fa-plus-circle me-1"></i>@c
                                    </span>
                                }
                            </div>
                        </div>
                    }
                    @if (Model.CompetencesPrerequisListe.Any())
                    {
                        <div class="@(Model.CompetencesDeveloppees.Any() ? "col-md-6" : "col-12")">
                            <h6 class="fw-bold text-warning mb-3">
                                <i class="fas fa-exclamation-triangle me-2"></i>Prérequis
                            </h6>
                            <div class="d-flex flex-wrap gap-2">
                                @foreach (var r in Model.CompetencesPrerequisListe)
                                {
                                    <span class="badge rounded-pill px-3 py-2 fw-semibold"
                                          style="background:#fff8e6;color:#7a5c00;border:1px solid #f5d57a;">
                                        @r
                                    </span>
                                }
                            </div>
                        </div>
                    }
                </div>
            </div>
        }

        <!-- ─ Certification ─ -->
        @if (f.EstCertifiante)
        {
            <div class="card border-0 shadow-sm mb-4 p-4"
                 style="border-radius:16px;background:linear-gradient(135deg,#fffbeb 0%,#fef3c7 100%);border:1px solid #fde68a !important;">
                <div class="d-flex align-items-start gap-3">
                    <div class="text-warning flex-shrink-0" style="font-size:2rem;"><i class="fas fa-award"></i></div>
                    <div>
                        <h6 class="fw-bold text-dark mb-1">Certification incluse</h6>
                        @if (!string.IsNullOrWhiteSpace(f.CertificationNom))
                        {
                            <div class="fw-semibold text-dark mb-2">@f.CertificationNom</div>
                        }
                        <p class="text-muted small mb-2">
                            À l'issue de cette formation, vous obtiendrez un certificat reconnu
                            @if (!string.IsNullOrEmpty(f.Plateforme)) { <span>par <strong>@f.Plateforme</strong></span> }
                            attestant de votre maîtrise des compétences enseignées.
                        </p>
                        @if (!string.IsNullOrEmpty(f.Organisme))
                        {
                            <div class="small text-muted">
                                <i class="fas fa-building me-1"></i>Organisme : <strong>@f.Organisme</strong>
                            </div>
                        }
                    </div>
                </div>
            </div>
        }

        <!-- ─ Progression (if enrolled) ─ -->
        @if (insc != null)
        {
            <div class="card border-0 shadow-sm mb-4 p-4" style="border-radius:16px;">
                <h6 class="fw-bold text-dark mb-3">
                    <i class="fas fa-tasks text-primary me-2"></i>Votre progression
                </h6>
                <div class="d-flex justify-content-between mb-1 small">
                    <span class="text-muted">@(insc.Terminee ? "Formation complétée ✓" : "En cours")</span>
                    <span class="fw-bold">@prog%</span>
                </div>
                <div class="progress rounded-pill mb-3" style="height:8px;">
                    <div class="progress-bar rounded-pill"
                         style="width:@prog%;background:@(insc.Terminee ? "#10b981" : "#ffe600");"
                         role="progressbar"></div>
                </div>
                @if (!insc.Terminee)
                {
                    <div class="d-flex gap-2 flex-wrap">
                        <a asp-action="ReprendreFormation" asp-route-inscriptionId="@insc.Id"
                           class="ey-btn-premium-gold px-4 py-2 text-decoration-none">
                            <i class="fas fa-play me-1"></i>Reprendre
                        </a>
                        <a asp-action="PlanifierExamen" asp-route-inscriptionId="@insc.Id"
                           class="ey-btn-premium-ghost px-4 py-2 text-decoration-none">
                            <i class="far fa-calendar-check me-1"></i>Planifier l'examen
                        </a>
                    </div>
                }
                else
                {
                    <a asp-action="TelechargerCertificat" asp-route-inscriptionId="@insc.Id"
                       class="ey-btn-premium-main px-4 py-2 text-decoration-none text-white">
                        <i class="fas fa-download me-1"></i>Télécharger le certificat PDF
                    </a>
                }
            </div>
        }

        <!-- ─ Info grid (fallback for fields without separate section) ─ -->
        <div class="card border-0 shadow-sm mb-4 p-4" style="border-radius:16px;">
            <h5 class="fw-semibold mb-4">Détails de la formation</h5>
            <div class="row g-3">
                <div class="col-sm-6">
                    <div class="small text-muted fw-semibold mb-1">Formateur</div>
                    <div><i class="far fa-user me-2 text-muted"></i>@(string.IsNullOrWhiteSpace(f.Formateur) ? "À confirmer" : f.Formateur)</div>
                </div>
                <div class="col-sm-6">
                    <div class="small text-muted fw-semibold mb-1">Organisme</div>
                    <div><i class="fas fa-building me-2 text-muted"></i>@(string.IsNullOrWhiteSpace(f.Organisme) ? "EY Internal" : f.Organisme)</div>
                </div>
                @if (!string.IsNullOrWhiteSpace(f.DepartementCible))
                {
                    <div class="col-sm-6">
                        <div class="small text-muted fw-semibold mb-1">Département cible</div>
                        <div><i class="fas fa-sitemap me-2 text-muted"></i>@f.DepartementCible</div>
                    </div>
                }
                @if (!string.IsNullOrWhiteSpace(f.PosteCible))
                {
                    <div class="col-sm-6">
                        <div class="small text-muted fw-semibold mb-1">Poste cible</div>
                        <div><i class="fas fa-briefcase me-2 text-muted"></i>@f.PosteCible</div>
                    </div>
                }
            </div>
            <div class="border-top mt-4 pt-3 d-flex gap-2 flex-wrap">
                <a asp-action="Edit" asp-route-id="@f.Id" class="btn btn-sm btn-outline-secondary">
                    <i class="fas fa-pen me-1"></i>Modifier
                </a>
                <a asp-action="Index" asp-route-collaborateurId="@Model.CollaborateurId"
                   class="btn btn-sm btn-light">
                    <i class="fas fa-arrow-left me-1"></i>Retour
                </a>
            </div>
        </div>

    </div>

    <!-- ── RIGHT: Action sidebar ──────────────────────────────────────────────── -->
    <div class="col-lg-4">

        <!-- CTA card (sticky) -->
        <div class="card border-0 shadow-sm mb-4 p-4" style="border-radius:16px;position:sticky;top:80px;">

            <!-- Platform badge -->
            @if (!string.IsNullOrEmpty(f.Plateforme))
            {
                <div class="d-flex align-items-center gap-3 p-3 rounded-3 mb-4"
                     style="background:@(Model.PlatformeCouleur)18;border:2px solid @(Model.PlatformeCouleur)35;">
                    <i class="@Model.PlateformeIconClass fa-2x" style="color:@Model.PlatformeCouleur;"></i>
                    <div>
                        <div class="fw-bold text-dark">@f.Plateforme</div>
                        <div class="text-muted small">Plateforme d'apprentissage</div>
                    </div>
                </div>
            }

            <!-- Enroll or status -->
            @if (insc == null)
            {
                if (f.PlacesPrises < f.CapaciteMax)
                {
                    <form asp-action="Inscrire" method="post" class="mb-3">
                        <input type="hidden" name="formationId" value="@f.Id" />
                        <input type="hidden" name="collaborateurId" value="@Model.CollaborateurId" />
                        <button type="submit" class="ey-btn-premium-gold w-100 py-3 fw-bold" style="font-size:1rem;">
                            <i class="fas fa-plus-circle me-2"></i>S'inscrire à la formation
                        </button>
                    </form>
                }
                else
                {
                    <button class="ey-btn-premium-disabled w-100 py-3 mb-3" disabled>Complet</button>
                }
            }
            else
            {
                <div class="text-center p-3 rounded-3 mb-3"
                     style="background:@(insc.Terminee ? "#e6f9f0" : "#fffbeb");border:1px solid @(insc.Terminee ? "#a8dfc5" : "#fde68a");">
                    <i class="fas @(insc.Terminee ? "fa-check-circle text-success" : "fa-spinner text-warning") fa-2x mb-2 d-block"></i>
                    <div class="fw-bold @(insc.Terminee ? "text-success" : "text-warning")">
                        @(insc.Terminee ? "Formation terminée" : "En cours d'apprentissage")
                    </div>
                    <div class="small text-muted mt-1">Depuis le @insc.DateInscription.ToString("dd/MM/yyyy")</div>
                </div>
            }

            <!-- Open on platform -->
            @if (!string.IsNullOrWhiteSpace(f.ExternalUrl))
            {
                <a href="@f.ExternalUrl" target="_blank" rel="noopener"
                   class="btn w-100 mb-3 py-2 fw-semibold text-white"
                   style="background:@Model.PlatformeCouleur;border:none;border-radius:10px;">
                    <i class="@Model.PlateformeIconClass me-2"></i>@Model.BoutonOuvrirLabel
                    <i class="fas fa-external-link-alt ms-2 small"></i>
                </a>
            }

            <!-- Download PDF support -->
            @if (!string.IsNullOrWhiteSpace(f.SupportPdfUrl))
            {
                <a href="@f.SupportPdfUrl" target="_blank" rel="noopener"
                   class="ey-btn-premium-ghost w-100 text-decoration-none py-2 text-center mb-3 d-block">
                    <i class="fas fa-file-pdf text-danger me-2"></i>Télécharger le support PDF
                </a>
            }

            <!-- Contact mentor -->
            @if (!string.IsNullOrWhiteSpace(f.MentorEmail))
            {
                <a href="mailto:@f.MentorEmail?subject=@Uri.EscapeDataString("Question : " + f.Titre)"
                   class="ey-btn-premium-ghost w-100 text-decoration-none py-2 text-center mb-3 d-block">
                    <i class="fas fa-envelope me-2"></i>Contacter le mentor
                </a>
            }

            <!-- Meta -->
            <div class="border-top pt-3 mt-1">
                <div class="row g-2 mb-2">
                    <div class="col-6">
                        <div class="p-2 rounded-2 text-center" style="background:#f0fdf4;border:1px solid rgba(16,185,129,.2);">
                            <div class="fw-bold fs-4 lh-1 mb-1" style="color:#10b981;">@placesDisponibles</div>
                            <div class="text-muted" style="font-size:.65rem;text-transform:uppercase;">Disponibles</div>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="p-2 rounded-2 text-center" style="background:#f8f9fb;border:1px solid rgba(17,24,39,.08);">
                            <div class="fw-bold fs-4 lh-1 mb-1">@f.PlacesPrises</div>
                            <div class="text-muted" style="font-size:.65rem;text-transform:uppercase;">Inscrits</div>
                        </div>
                    </div>
                </div>
                @if (Model.EstDansPlan)
                {
                    <div class="small text-info fw-semibold mt-2">
                        <i class="fas fa-clipboard-check me-1"></i>Dans votre plan de développement
                    </div>
                }
                @if (Model.ProchainGrade != null)
                {
                    <div class="mt-3 p-2 rounded-2 small" style="background:#f0f4ff;border:1px solid #c7d7fd;">
                        <i class="fas fa-level-up-alt text-primary me-1"></i>
                        Contribue à votre évolution vers <strong>@Model.ProchainGrade</strong>
                    </div>
                }
            </div>
        </div>

        <!-- Quick links -->
        <div class="card border-0 shadow-sm p-3" style="border-radius:16px;">
            <h6 class="fw-bold text-dark mb-3">Accès rapide</h6>
            <div class="d-flex flex-column gap-2">
                <a asp-action="Recommandations" asp-route-collaborateurId="@Model.CollaborateurId"
                   class="ey-btn-premium-main text-decoration-none text-white text-center py-2">
                    <i class="fas fa-rocket me-2"></i>Mes recommandations
                </a>
                <a asp-action="ParcoursCarriere" asp-route-collaborateurId="@Model.CollaborateurId"
                   class="ey-btn-premium-ghost text-decoration-none text-center py-2">
                    <i class="fas fa-road me-2"></i>Mon parcours de carrière
                </a>
                <a asp-action="Index" asp-route-collaborateurId="@Model.CollaborateurId"
                   class="btn btn-light text-decoration-none text-center py-2 small">
                    <i class="fas fa-arrow-left me-1"></i>Retour au catalogue
                </a>
            </div>
        </div>

    </div>
</div>
