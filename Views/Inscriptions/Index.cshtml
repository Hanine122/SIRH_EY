@model IEnumerable<SIRH.EY.Models.Inscription>

@{
    ViewData["Title"] = "Inscriptions";
}

@* ── Page Header ──────────────────────────────────────────────────────────── *@
<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-start gap-3 mb-4">
    <div>
        <div class="ey-page-kicker">Administration RH</div>
        <h1 class="ey-page-title">Inscriptions aux formations</h1>
        <p class="ey-page-lead mb-0">
            <strong>@Model.Count()</strong> inscription(s) enregistrée(s) —
            <span class="text-success fw-semibold">@Model.Count(i => i.Terminee)</span> terminée(s),
            <span class="text-warning fw-semibold">@Model.Count(i => !i.Terminee)</span> en cours.
        </p>
    </div>
    <a asp-action="Create" class="ey-btn-main text-decoration-none flex-shrink-0 align-self-md-start">
        <i class="fas fa-plus me-1"></i>Nouvelle inscription
    </a>
</div>

@* ── Table ─────────────────────────────────────────────────────────────────── *@
<div class="ey-card overflow-hidden">
    @if (!Model.Any())
    {
        <div class="p-4 text-center">
            <i class="fas fa-clipboard-list fa-2x text-muted mb-3 d-block opacity-50"></i>
            <p class="fw-semibold text-dark mb-1">Aucune inscription enregistrée</p>
            <p class="text-muted small mb-0">Créez la première inscription pour qu'elle apparaisse ici.</p>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th scope="col" class="fw-semibold text-muted small text-uppercase ps-3" style="letter-spacing:.05em;">
                            Date d'inscription
                        </th>
                        <th scope="col" class="fw-semibold text-muted small text-uppercase" style="letter-spacing:.05em;">
                            Statut
                        </th>
                        <th scope="col" class="fw-semibold text-muted small text-uppercase" style="letter-spacing:.05em;">
                            Collaborateur
                        </th>
                        <th scope="col" class="fw-semibold text-muted small text-uppercase" style="letter-spacing:.05em;">
                            Formation
                        </th>
                        <th scope="col" class="fw-semibold text-muted small text-uppercase text-end pe-3" style="letter-spacing:.05em;">
                            Actions
                        </th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="ps-3 small">
                                <i class="far fa-calendar-alt me-1 text-muted"></i>
                                @item.DateInscription.ToString("dd/MM/yyyy")
                            </td>
                            <td>
                                @if (item.Terminee)
                                {
                                    <span class="ey-pill active">
                                        <i class="fas fa-check-circle me-1"></i>Terminée
                                    </span>
                                }
                                else
                                {
                                    <span class="ey-pill in-progress">
                                        <i class="fas fa-circle-notch me-1"></i>En cours
                                    </span>
                                }
                            </td>
                            <td class="fw-semibold text-dark small">
                                @Html.DisplayFor(m => item.Collaborateur.Nom)
                            </td>
                            <td class="small text-muted text-truncate" style="max-width:240px;"
                                title="@item.Formation?.Titre">
                                @Html.DisplayFor(m => item.Formation.Titre)
                            </td>
                            <td class="text-end pe-3">
                                <div class="d-flex gap-1 justify-content-end">
                                    <a asp-action="Edit" asp-route-id="@item.Id"
                                       class="ey-btn-ghost btn-sm text-decoration-none"
                                       title="Modifier">
                                        <i class="fas fa-pen"></i>
                                        <span class="d-none d-lg-inline ms-1">Modifier</span>
                                    </a>
                                    <a asp-action="Details" asp-route-id="@item.Id"
                                       class="ey-btn-ghost btn-sm text-decoration-none"
                                       title="Détails">
                                        <i class="fas fa-eye"></i>
                                        <span class="d-none d-lg-inline ms-1">Détails</span>
                                    </a>
                                    <a asp-action="Delete" asp-route-id="@item.Id"
                                       class="btn btn-sm btn-outline-danger text-decoration-none"
                                       title="Supprimer">
                                        <i class="fas fa-trash"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
