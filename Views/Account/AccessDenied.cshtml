@using Microsoft.AspNetCore.Identity
@inject UserManager<ApplicationUser> UserManager

@{
    ViewData["Title"] = "Accès refusé";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var user = await UserManager.GetUserAsync(User);
    var roles = user != null ? await UserManager.GetRolesAsync(user) : new List<string>();

    string homeUrl = "/";
    string homeLabel = "Retour au tableau de bord";

    if (roles.Contains("ITAdmin"))      { homeUrl = "/Admin/AdminHome";  homeLabel = "Administration IT"; }
    else if (roles.Contains("RH"))      { homeUrl = "/RhInsights";       homeLabel = "RH Insights"; }
    else if (roles.Contains("Manager")) { homeUrl = "/Talent";           homeLabel = "Gestion des talents"; }
}

<div class="ey-card p-5 text-center" style="max-width:560px;margin:80px auto;">
    <div class="mb-3" style="font-size:3rem;color:var(--ey-yellow,#FFE600);">
        <i class="fas fa-shield-alt"></i>
    </div>
    <h2 class="fw-bold mb-2">Accès refusé</h2>
    <p class="text-muted mb-4">
        Vous n'avez pas les droits nécessaires pour accéder à cette page.<br />
        Si vous pensez qu'il s'agit d'une erreur, contactez votre administrateur.
    </p>
    <div class="d-flex gap-2 justify-content-center flex-wrap">
        <a href="@homeUrl" class="ey-btn-main text-decoration-none">
            <i class="fas fa-home me-1"></i> @homeLabel
        </a>
        <a href="javascript:history.back()" class="btn btn-outline-secondary">
            <i class="fas fa-arrow-left me-1"></i> Page précédente
        </a>
    </div>
    <div class="mt-4 text-muted small">
        Rôle actuel : <strong>@(roles.FirstOrDefault() ?? "Non défini")</strong>
    </div>
</div>
