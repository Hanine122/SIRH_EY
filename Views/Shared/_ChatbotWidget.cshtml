<div id="chatbot-widget-container" class="chatbot-widget-container">
    <!-- Chatbot Launcher Button -->
    <button id="chatbot-launcher" class="chatbot-launcher shadow-lg" aria-label="Ouvrir l'assistant IA">
        <i class="fas fa-comment-dots chatbot-launcher-icon"></i>
        <i class="fas fa-times chatbot-close-icon" style="display: none;"></i>
    </button>

    <!-- Chatbot Panel -->
    <div id="chatbot-panel" class="chatbot-panel shadow-lg" style="display: none;">
        <!-- Header -->
        <div class="chatbot-header">
            <div class="chatbot-header-info">
                <div class="chatbot-avatar">
                    <i class="fas fa-robot"></i>
                </div>
                <div class="chatbot-header-text">
                    <div class="chatbot-title">Assistant RH IA</div>
                    <div class="chatbot-status">En ligne</div>
                </div>
            </div>
            <div class="chatbot-header-actions">
                <span class="ey-ai-tag">EY IA</span>
                <button id="chatbot-close-btn" class="chatbot-close-btn" aria-label="Fermer">
                    <i class="fas fa-times"></i>
                </button>
            </div>
        </div>

        <!-- Messages Area -->
        <div id="chatbot-messages" class="chatbot-messages">
            <!-- Welcome Message -->
            <div class="chat-message bot-message">
                <div class="message-content">
                    <p class="ey-answer-text">
                        <strong>Bonjour !</strong> Je suis votre assistant RH IA EY.<br>
                        Je peux analyser vos <strong>talents</strong>, <strong>successions</strong>,
                        <strong>promotions</strong> et <strong>effectifs</strong> en temps réel.
                    </p>
                </div>
            </div>

            <!-- Quick Prompts -->
            <div id="chatbot-quick-prompts" class="chatbot-quick-prompts">
                <button class="quick-prompt-btn" data-prompt="Quels sont les top talents ?">Top talents &amp; hauts potentiels?</button>
                <button class="quick-prompt-btn" data-prompt="Qui est prêt pour une promotion ?">Candidats à la promotion?</button>
                <button class="quick-prompt-btn" data-prompt="Montre la répartition par département">Répartition des effectifs?</button>
            </div>
        </div>

        <!-- Input Area -->
        <div class="chatbot-input-area">
            <input type="text" id="chatbot-input" class="chatbot-input form-control"
                   placeholder="Posez votre question RH..." autocomplete="off" />
            <button id="chatbot-send-btn" class="chatbot-send-btn" disabled>
                <i class="fas fa-paper-plane"></i>
            </button>
        </div>
    </div>
</div>
