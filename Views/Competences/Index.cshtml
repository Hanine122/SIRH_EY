@model IEnumerable<SIRH.EY.Models.Competence>
@using SIRH.EY.Authorization
@inject SIRH.EY.Services.IUserContextService UserContext

@{
    ViewData["Title"] = "Compétences";
    var collaborateurNom  = ViewBag.CollaborateurNom;
    var grade             = ViewBag.GradeCollaborateur as string;
    var categories        = ViewBag.Categories as List<string> ?? new List<string>();
    var categorieCourante = ViewBag.CategorieCourante as string;
    var plans             = ViewBag.PlanDeveloppement as List<SIRH.EY.Models.PlanDeveloppement>
                            ?? new List<SIRH.EY.Models.PlanDeveloppement>();
    var seuilRequis       = SIRH.EY.Services.CompetenceRules.GetSeuilRequis(grade ?? "Junior");
    var isManager         = await UserContext.IsUserInRoleAsync(User, Roles.Manager);

    // ── Priority groups ──────────────────────────────────────────────────────
    var all            = Model.ToList();
    var total          = all.Count;
    var criticalList   = all.Where(c => c.NiveauCible - c.NiveauActuel >= 2)
                            .OrderByDescending(c => c.NiveauCible - c.NiveauActuel).ToList();
    var progressList   = all.Where(c => c.NiveauCible - c.NiveauActuel == 1).ToList();
    var validatedList  = all.Where(c => c.NiveauActuel >= c.NiveauCible).ToList();

    // ── Dashboard metrics ────────────────────────────────────────────────────
    var avgScore      = total > 0 ? Math.Round(all.Average(c => (double)c.NiveauActuel), 1) : 0.0;
    var completionPct = total > 0 ? (int)(validatedList.Count * 100.0 / total) : 0;
    var avgPct        = (int)(avgScore / 5.0 * 100);

    // ── Plan lookup helper ────────────────────────────────────────────────────
    SIRH.EY.Models.PlanDeveloppement? PlanFor(string nom) =>
        plans.FirstOrDefault(p =>
            p.Formation?.CompetenceVisee != null &&
            string.Equals(p.Formation.CompetenceVisee, nom, StringComparison.OrdinalIgnoreCase));
}

@section Styles {
    <link rel="stylesheet" href="~/css/ceb-evaluation-status.css" asp-append-version="true" />
}

@* Jeton anti-CSRF partagé par tous les boutons "Valider" rendus par le partial ci-dessous *@
@Html.AntiForgeryToken()

@* ── Flash messages ────────────────────────────────────────────────────────── *@
@if (TempData["Success"] != null)
{
    <div class="alert alert-success d-flex align-items-center gap-2 mb-3">
        <i class="fas fa-check-circle flex-shrink-0"></i>
        <span>@TempData["Success"]</span>
    </div>
}

@* ── Context breadcrumb + primary action ────────────────────────────────────── *@
<div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
    <div>
        <div class="ey-page-kicker">Développement professionnel</div>
        <h1 class="ey-page-title">Compétences de @collaborateurNom</h1>
    </div>
    <div class="d-flex gap-2 flex-wrap">
        <a asp-action="Catalogue" asp-route-collaborateurId="@ViewBag.CollaborateurId"
           class="ey-btn-ghost text-decoration-none">
            <i class="fas fa-th me-1"></i>Catalogue EY
        </a>
        <a asp-action="Create" asp-route-collaborateurId="@ViewBag.CollaborateurId"
           class="ey-btn-main text-decoration-none">
            <i class="fas fa-plus me-1"></i>Ajouter
        </a>
    </div>
</div>

@if (total == 0)
{
    @* ── Onboarding empty state ────────────────────────────────────────────── *@
    <div class="ey-dark-hero p-5 text-center mb-4">
        <i class="fas fa-chart-radar fa-3x mb-3 d-block" style="color:rgba(255,230,0,.6);"></i>
        <h2 class="fw-bold text-white mb-2">Aucune compétence enregistrée</h2>
        <p class="text-white-50 mb-4" style="max-width:520px;margin:0 auto;">
            Construisez le profil de compétences de <strong class="text-white">@collaborateurNom</strong>
            en ajoutant des compétences manuellement ou en explorant le catalogue EY.
        </p>
        <div class="d-flex justify-content-center gap-3 flex-wrap">
            <a asp-action="Catalogue" asp-route-collaborateurId="@ViewBag.CollaborateurId"
               class="ey-btn-yellow text-decoration-none px-4">
                <i class="fas fa-th me-2"></i>Explorer le catalogue EY
            </a>
            <a asp-action="Create" asp-route-collaborateurId="@ViewBag.CollaborateurId"
               class="ey-btn-ghost text-decoration-none px-4">
                <i class="fas fa-plus me-2"></i>Ajouter manuellement
            </a>
        </div>
    </div>
}
else
{
    @* ══════════════════════════════════════════════════════════════════════════
       1. SKILLS DASHBOARD HERO
       ══════════════════════════════════════════════════════════════════════════ *@
    <div class="ey-dark-hero p-4 mb-4">
        <div class="row g-4 align-items-center">

            @* Left: identity + overall progress ring *@
            <div class="col-lg-4">
                <div class="d-flex align-items-center gap-3">
                    <div class="flex-shrink-0 d-flex align-items-center justify-content-center rounded-3"
                         style="width:72px;height:72px;background:rgba(255,230,0,.12);border:2px solid rgba(255,230,0,.3);">
                        <span class="fw-black text-white" style="font-size:1.5rem;letter-spacing:-.02em;">@avgScore</span>
                    </div>
                    <div>
                        <div style="font-size:10px;font-weight:700;letter-spacing:.12em;text-transform:uppercase;color:rgba(255,255,255,.5);">
                            Score moyen
                        </div>
                        <div class="text-white fw-bold mb-1">@avgPct% du plafond</div>
                        <div class="progress" style="height:5px;width:120px;background:rgba(255,255,255,.1);">
                            <div class="progress-bar" style="width:@avgPct%;background:var(--ey-yellow);"></div>
                        </div>
                        <div class="mt-2">
                            <span class="badge text-dark fw-bold" style="background:var(--ey-yellow);">
                                @((grade ?? "Junior").ToUpperInvariant())
                            </span>
                        </div>
                    </div>
                </div>
            </div>

            @* Right: 4-metric row *@
            <div class="col-lg-8">
                <div class="row g-3 text-center">

                    @* Completed *@
                    <div class="col-6 col-md-3">
                        <div class="px-3 py-2 rounded-3" style="background:rgba(18,185,129,.12);border:1px solid rgba(18,185,129,.25);">
                            <div class="fw-black text-success" style="font-size:1.9rem;line-height:1.1;">
                                @validatedList.Count
                            </div>
                            <div style="font-size:10px;font-weight:700;letter-spacing:.07em;text-transform:uppercase;color:rgba(255,255,255,.55);">
                                Objectifs atteints
                            </div>
                            <div class="text-success small fw-semibold">@completionPct% du profil</div>
                        </div>
                    </div>

                    @* Critical *@
                    <div class="col-6 col-md-3">
                        <div class="px-3 py-2 rounded-3"
                             style="background:@(criticalList.Count > 0 ? "rgba(229,72,77,.14)" : "rgba(18,185,129,.12)");
                                    border:1px solid @(criticalList.Count > 0 ? "rgba(229,72,77,.3)" : "rgba(18,185,129,.25)");">
                            <div class="fw-black @(criticalList.Count > 0 ? "text-danger" : "text-success")"
                                 style="font-size:1.9rem;line-height:1.1;">
                                @criticalList.Count
                            </div>
                            <div style="font-size:10px;font-weight:700;letter-spacing:.07em;text-transform:uppercase;color:rgba(255,255,255,.55);">
                                Écarts critiques
                            </div>
                            <div class="@(criticalList.Count > 0 ? "text-danger" : "text-success") small fw-semibold">
                                @(criticalList.Count > 0 ? "⚠ Action requise" : "✓ Aucun")
                            </div>
                        </div>
                    </div>

                    @* In progress *@
                    <div class="col-6 col-md-3">
                        <div class="px-3 py-2 rounded-3" style="background:rgba(244,197,66,.1);border:1px solid rgba(244,197,66,.25);">
                            <div class="fw-black text-warning" style="font-size:1.9rem;line-height:1.1;">
                                @progressList.Count
                            </div>
                            <div style="font-size:10px;font-weight:700;letter-spacing:.07em;text-transform:uppercase;color:rgba(255,255,255,.55);">
                                En progression
                            </div>
                            <div class="text-warning small fw-semibold">À consolider</div>
                        </div>
                    </div>

                    @* Total *@
                    <div class="col-6 col-md-3">
                        <div class="px-3 py-2 rounded-3" style="background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.1);">
                            <div class="fw-black text-white" style="font-size:1.9rem;line-height:1.1;">
                                @total
                            </div>
                            <div style="font-size:10px;font-weight:700;letter-spacing:.07em;text-transform:uppercase;color:rgba(255,255,255,.55);">
                                Compétences
                            </div>
                            <div class="text-white-50 small fw-semibold">dans le profil</div>
                        </div>
                    </div>

                </div>
            </div>

        </div>
    </div>

    @* ── Category filter (compact, secondary) ────────────────────────────────── *@
    @if (categories.Any())
    {
        <div class="d-flex align-items-center gap-2 mb-4 flex-wrap">
            <span class="small text-muted fw-semibold me-1">Catégorie :</span>
            <form method="get" class="d-contents">
                <input type="hidden" name="collaborateurId" value="@ViewBag.CollaborateurId" />
                <a asp-action="Index" asp-route-collaborateurId="@ViewBag.CollaborateurId"
                   class="ey-pill @(string.IsNullOrEmpty(categorieCourante) ? "active" : "") text-decoration-none">
                    Toutes
                </a>
                @foreach (var cat in categories)
                {
                    <a asp-action="Index" asp-route-collaborateurId="@ViewBag.CollaborateurId"
                       asp-route-categorie="@cat"
                       class="ey-pill @(cat == categorieCourante ? "active" : "") text-decoration-none">
                        @cat
                    </a>
                }
            </form>
        </div>
    }

    @* ══════════════════════════════════════════════════════════════════════════
       2. CRITICAL GAPS — ACTIONS REQUISES
       ══════════════════════════════════════════════════════════════════════════ *@
    @if (criticalList.Any())
    {
        <div class="mb-4">
            <div class="d-flex align-items-center gap-3 mb-3 px-4 py-3 rounded-3"
                 style="background:rgba(229,72,77,.08);border:1px solid rgba(229,72,77,.2);border-left:4px solid var(--ey-danger);">
                <i class="fas fa-exclamation-triangle text-danger fa-lg flex-shrink-0"></i>
                <div>
                    <span class="fw-bold text-danger">ACTIONS REQUISES</span>
                    <span class="text-muted ms-2 small">
                        @criticalList.Count compétence@(criticalList.Count > 1 ? "s" : "") avec un écart de 2 niveaux ou plus
                    </span>
                </div>
                <span class="badge bg-danger ms-auto">@criticalList.Count</span>
            </div>

            @foreach (var comp in criticalList)
            {
                var gap        = comp.NiveauCible - comp.NiveauActuel;
                var evalData   = comp.EvaluationCompetence;
                var planForComp = PlanFor(comp.Nom);
                var hasAutoEval = evalData?.DateAutoEvaluation.HasValue == true;

                <div class="ey-card mb-3" style="border-left:4px solid var(--ey-danger);">
                    <div class="p-4">
                        <div class="row g-4 align-items-center">

                            @* ── Skill identity + level visualization ─── *@
                            <div class="col-lg-5">
                                <div class="d-flex gap-2 mb-2">
                                    <span class="badge bg-danger rounded-pill">CRITIQUE</span>
                                    @if (comp.CategorieCompetence != null)
                                    {
                                        <span class="badge bg-light border text-muted fw-normal">@comp.CategorieCompetence.Nom</span>
                                    }
                                </div>
                                <h4 class="fw-bold text-dark mb-3 fs-5">@comp.Nom</h4>

                                <div class="row g-2">
                                    <div class="col-6">
                                        <div class="text-muted mb-1" style="font-size:10px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;">
                                            Niveau actuel
                                        </div>
                                        <div class="d-flex align-items-center gap-1">
                                            @for (int i = 1; i <= 5; i++)
                                            {
                                                <span class="@(i <= comp.NiveauActuel ? "text-dark" : "text-muted opacity-25")"
                                                      style="font-size:1.1rem;line-height:1;">●</span>
                                            }
                                            <span class="small fw-bold text-dark ms-1">@comp.NiveauActuel/5</span>
                                        </div>
                                    </div>
                                    <div class="col-6">
                                        <div class="text-muted mb-1" style="font-size:10px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;">
                                            Objectif grade
                                        </div>
                                        <div class="d-flex align-items-center gap-1">
                                            @for (int i = 1; i <= 5; i++)
                                            {
                                                <span class="@(i <= comp.NiveauCible ? "text-danger" : "text-muted opacity-25")"
                                                      style="font-size:1.1rem;line-height:1;">●</span>
                                            }
                                            <span class="small fw-bold text-danger ms-1">@comp.NiveauCible/5</span>
                                        </div>
                                    </div>
                                </div>

                                @* Statut d'évaluation *@
                                <div class="mt-3">
                                    <partial name="_EvaluationStatusBadge"
                                             model='new SIRH.EY.Models.CompetenceEvaluationStatusViewModel { Competence = comp, IsManager = isManager }' />
                                </div>
                            </div>

                            @* ── Gap metric ─── *@
                            <div class="col-lg-2 text-center">
                                <div class="d-inline-flex flex-column align-items-center justify-content-center rounded-3 p-3"
                                     style="background:rgba(229,72,77,.08);border:2px solid rgba(229,72,77,.2);min-width:80px;">
                                    <span class="fw-black text-danger" style="font-size:2rem;line-height:1;">@gap</span>
                                    <span class="text-danger fw-bold" style="font-size:0.6rem;letter-spacing:.08em;text-transform:uppercase;">
                                        niveau@(gap > 1 ? "x" : "")<br/>à combler
                                    </span>
                                </div>
                            </div>

                            @* ── Action panel ─── *@
                            <div class="col-lg-5">
                                @if (planForComp?.Formation != null)
                                {
                                    <div class="p-3 rounded-3 mb-3"
                                         style="background:rgba(59,130,246,.07);border:1px solid rgba(59,130,246,.2);">
                                        <div class="mb-1" style="font-size:10px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:#2563eb;">
                                            <i class="fas fa-graduation-cap me-1"></i>Formation recommandée
                                        </div>
                                        <div class="fw-semibold small text-dark lh-sm">@planForComp.Formation.Titre</div>
                                        @if (!string.IsNullOrWhiteSpace(planForComp.Commentaire))
                                        {
                                            <div class="text-muted small mt-1">@planForComp.Commentaire</div>
                                        }
                                    </div>
                                }
                                <div class="d-flex flex-column gap-2">
                                    <a asp-action="AutoEvaluation" asp-route-id="@comp.Id"
                                       class="ey-btn-main text-decoration-none text-center">
                                        <i class="fas fa-user-edit me-1"></i>
                                        @(evalData?.DateAutoEvaluation.HasValue == true
                                            ? "Mettre à jour l'auto-évaluation"
                                            : "Démarrer l'auto-évaluation")
                                    </a>
                                    <a asp-action="ValidationManager" asp-route-id="@comp.Id"
                                       class="ey-btn-ghost text-decoration-none text-center small">
                                        <i class="fas fa-check-double me-1"></i>Validation manager
                                    </a>
                                    <div class="d-flex gap-2">
                                        <a asp-action="Edit" asp-route-id="@comp.Id"
                                           class="ey-btn-ghost btn-sm flex-grow-1 text-decoration-none text-center">
                                            <i class="fas fa-pen me-1"></i>Modifier
                                        </a>
                                        <a asp-action="Delete" asp-route-id="@comp.Id"
                                           class="btn btn-sm btn-outline-danger flex-grow-1 text-decoration-none text-center">
                                            <i class="fas fa-trash me-1"></i>Supprimer
                                        </a>
                                    </div>
                                </div>
                            </div>

                        </div>
                    </div>
                </div>
            }
        </div>
    }

    @* ══════════════════════════════════════════════════════════════════════════
       3. EN PROGRESSION (gap == 1)
       ══════════════════════════════════════════════════════════════════════════ *@
    @if (progressList.Any())
    {
        <div class="mb-4">
            <div class="d-flex align-items-center gap-3 mb-3 px-4 py-2 rounded-3"
                 style="background:rgba(244,197,66,.08);border:1px solid rgba(244,197,66,.2);border-left:4px solid var(--ey-warning);">
                <i class="fas fa-chart-line text-warning fa-lg flex-shrink-0"></i>
                <span class="fw-bold text-dark">EN PROGRESSION</span>
                <span class="text-muted small">
                    @progressList.Count compétence@(progressList.Count > 1 ? "s" : "") à 1 niveau de l'objectif
                </span>
                <span class="badge bg-warning text-dark ms-auto">@progressList.Count</span>
            </div>

            <div class="row g-3">
                @foreach (var comp in progressList)
                {
                    var planForComp = PlanFor(comp.Nom);

                    <div class="col-md-6 col-xl-4">
                        <div class="ey-card h-100" style="border-left:3px solid var(--ey-warning);">
                            <div class="p-3">
                                <div class="d-flex justify-content-between align-items-start mb-2">
                                    <div class="flex-grow-1 me-2">
                                        <h6 class="fw-bold mb-1 text-dark lh-sm">@comp.Nom</h6>
                                        @if (comp.CategorieCompetence != null)
                                        {
                                            <span class="badge bg-light border text-secondary fw-normal small">
                                                @comp.CategorieCompetence.Nom
                                            </span>
                                        }
                                    </div>
                                    <span class="badge bg-warning text-dark rounded-pill flex-shrink-0">+1</span>
                                </div>

                                <div class="d-flex gap-1 align-items-center mb-1">
                                    @for (int i = 1; i <= 5; i++)
                                    {
                                        <span class="@(i <= comp.NiveauActuel ? "text-warning" : "text-muted opacity-25")"
                                              style="font-size:1rem;line-height:1;">●</span>
                                    }
                                    <span class="small text-muted ms-1">@comp.NiveauActuel → @comp.NiveauCible</span>
                                </div>

                                <div class="progress rounded-pill mb-2" style="height:5px;">
                                    <div class="progress-bar bg-warning" style="width:@(comp.NiveauActuel / 5.0 * 100)%;"></div>
                                </div>

                                <div class="mb-2">
                                    <partial name="_EvaluationStatusBadge"
                                             model='new SIRH.EY.Models.CompetenceEvaluationStatusViewModel { Competence = comp, IsManager = isManager }' />
                                </div>

                                @if (planForComp?.Formation != null)
                                {
                                    <div class="small text-muted mb-2">
                                        <i class="fas fa-graduation-cap text-primary me-1"></i>@planForComp.Formation.Titre
                                    </div>
                                }

                                <div class="d-flex gap-2 mt-auto">
                                    <a asp-action="AutoEvaluation" asp-route-id="@comp.Id"
                                       class="ey-btn-main btn-sm flex-grow-1 text-decoration-none text-center">
                                        <i class="fas fa-user-edit me-1"></i>Auto-éval
                                    </a>
                                    <a asp-action="ValidationManager" asp-route-id="@comp.Id"
                                       class="ey-btn-ghost btn-sm flex-grow-1 text-decoration-none text-center">
                                        Manager
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    }

    @* ══════════════════════════════════════════════════════════════════════════
       4. OBJECTIFS ATTEINTS — compact list, collapsible
       ══════════════════════════════════════════════════════════════════════════ *@
    @if (validatedList.Any())
    {
        <div class="mb-4">
            <div class="d-flex align-items-center gap-3 mb-3 px-4 py-2 rounded-3 cursor-pointer"
                 style="background:rgba(18,185,129,.07);border:1px solid rgba(18,185,129,.2);border-left:4px solid var(--ey-success);"
                 data-bs-toggle="collapse" data-bs-target="#validated-section" role="button"
                 aria-expanded="@(criticalList.Any() || progressList.Any() ? "false" : "true")">
                <i class="fas fa-check-circle text-success fa-lg flex-shrink-0"></i>
                <span class="fw-bold text-dark">OBJECTIFS ATTEINTS</span>
                <span class="text-muted small">
                    @validatedList.Count compétence@(validatedList.Count > 1 ? "s" : "") maîtrisée@(validatedList.Count > 1 ? "s" : "")
                </span>
                <span class="badge bg-success ms-auto me-2">@validatedList.Count</span>
                <i class="fas fa-chevron-down text-muted small"></i>
            </div>

            @* Collapse open only if there are no higher-priority items *@
            <div class="collapse @(criticalList.Any() || progressList.Any() ? "" : "show")"
                 id="validated-section">
                <div class="ey-card overflow-hidden">
                    @foreach (var comp in validatedList)
                    {
                        <div class="d-flex align-items-center gap-3 px-4 py-3 border-bottom border-light"
                             style="transition:background .15s ease;">
                            <i class="fas fa-check-circle text-success flex-shrink-0"></i>
                            <div class="flex-grow-1 min-width-0">
                                <span class="fw-semibold text-dark">@comp.Nom</span>
                                @if (comp.CategorieCompetence != null)
                                {
                                    <span class="text-muted small ms-2">@comp.CategorieCompetence.Nom</span>
                                }
                            </div>
                            <div class="d-flex gap-1 align-items-center flex-shrink-0">
                                @for (int i = 1; i <= 5; i++)
                                {
                                    <span class="@(i <= comp.NiveauActuel ? "text-success" : "text-muted opacity-25")"
                                          style="font-size:.9rem;line-height:1;">●</span>
                                }
                            </div>
                            <div class="flex-shrink-0">
                                <partial name="_EvaluationStatusBadge"
                                         model='new SIRH.EY.Models.CompetenceEvaluationStatusViewModel { Competence = comp, IsManager = isManager }' />
                            </div>
                            <div class="d-flex gap-1 flex-shrink-0">
                                <a asp-action="AutoEvaluation" asp-route-id="@comp.Id"
                                   class="btn btn-sm btn-link text-muted text-decoration-none p-1" title="Auto-évaluation">
                                    <i class="fas fa-user-edit"></i>
                                </a>
                                <a asp-action="Edit" asp-route-id="@comp.Id"
                                   class="btn btn-sm btn-link text-muted text-decoration-none p-1" title="Modifier">
                                    <i class="fas fa-pen"></i>
                                </a>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    }

    @* ══════════════════════════════════════════════════════════════════════════
       5. PLAN DE DÉVELOPPEMENT — only if there are plans not already shown inline
       ══════════════════════════════════════════════════════════════════════════ *@

    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3 mt-2">
        <div>
            <div class="ey-page-kicker">Parcours personnalisé</div>
            <h4 class="fw-bold text-dark mb-0">Plan de développement</h4>
        </div>
        <form asp-action="GenererPlanDeveloppement" method="post" class="m-0">
            @Html.AntiForgeryToken()
            <input type="hidden" name="collaborateurId" value="@ViewBag.CollaborateurId" />
            <button type="submit" class="ey-btn-yellow">
                <i class="fas fa-wand-magic-sparkles me-1"></i>Générer les recommandations
            </button>
        </form>
    </div>

    @if (plans.Any())
    {
        <div class="row g-3 mb-4">
            @foreach (var plan in plans)
            {
                <div class="col-md-4">
                    <div class="ey-card p-3 h-100">
                        <div class="d-flex align-items-start gap-3 mb-2">
                            <div class="report-kpi-icon report-kpi-icon--dark flex-shrink-0">
                                <i class="fas fa-graduation-cap"></i>
                            </div>
                            <div class="flex-grow-1 min-width-0">
                                <h6 class="fw-bold mb-1 lh-sm text-dark">@plan.Formation?.Titre</h6>
                                <span class="ey-pill pending">@plan.Statut</span>
                            </div>
                        </div>
                        @if (!string.IsNullOrWhiteSpace(plan.Commentaire))
                        {
                            <p class="small text-muted mb-2">@plan.Commentaire</p>
                        }
                        <p class="small text-muted mb-0">
                            <i class="far fa-calendar-alt me-1"></i>
                            Recommandé le @plan.DateRecommandation.ToString("dd/MM/yyyy")
                        </p>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="ey-card p-4 text-center text-muted mb-4">
            <i class="fas fa-route fa-2x d-block mb-3 opacity-50"></i>
            <p class="mb-1 fw-semibold text-dark">Aucune recommandation générée</p>
            <p class="small mb-0">
                Cliquez sur <strong>Générer les recommandations</strong> pour créer un parcours de développement personnalisé.
            </p>
        </div>
    }
}

@* ── Footer navigation ─────────────────────────────────────────────────────── *@
<div class="d-flex gap-2 flex-wrap mt-2">
    <a asp-action="MatriceEquipe" asp-route-collaborateurId="@ViewBag.CollaborateurId"
       class="ey-btn-ghost text-decoration-none">
        <i class="fas fa-th me-1"></i>Matrice équipe
    </a>
    <a asp-controller="Collaborateurs" asp-action="Index" class="ey-btn-ghost text-decoration-none">
        <i class="fas fa-arrow-left me-1"></i>Retour au répertoire
    </a>
</div>

@section Scripts {
    <script src="~/js/ceb-evaluation-status.js" asp-append-version="true"></script>
}
