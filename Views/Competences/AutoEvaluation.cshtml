@model SIRH.EY.Models.AutoEvaluationCompetenceViewModel
@using SIRH.EY.Models

@{
    ViewData["Title"] = "Auto-évaluation compétence";
    var ecartObjectif = Model.AutoEvaluationCollaborateur - Model.SeuilRh;
    var evalsChaud = ViewBag.EvaluationsAChaud as List<Inscription> ?? new List<Inscription>();
    var evalsFroidEnAttente = ViewBag.EvaluationsAFroidEnAttente as List<Inscription> ?? new List<Inscription>();
    var returnUrl = Context.Request.Path + Context.Request.QueryString;
}

@section Styles {
<style>
    .aeh-panel { border-radius:16px; }
    .aeh-section-title {
        font-size:11px; font-weight:700; letter-spacing:.06em; text-transform:uppercase; color:#6b7280;
        display:flex; align-items:center; gap:6px; margin:18px 0 10px;
    }
    .aeh-section-title:first-child { margin-top:0; }
    .aeh-item {
        display:flex; align-items:center; gap:10px; padding:10px 12px; border-radius:10px;
        border:1px solid #e5e7eb; background:#fff; margin-bottom:8px; transition:box-shadow .15s ease, border-color .15s ease;
    }
    .aeh-item:hover { box-shadow:0 4px 12px rgba(15,23,42,.06); border-color:#d1d5db; }
    .aeh-item-froid { background:#FFFBEB; border-color:#FDE68A; }
    .aeh-item-icon {
        width:32px; height:32px; border-radius:9px; flex-shrink:0; display:flex; align-items:center; justify-content:center;
        font-size:13px;
    }
    .aeh-item-icon-chaud { background:#EFF6FF; color:var(--blue-600, #2563eb); }
    .aeh-item-icon-froid { background:#FFFBEB; color:#B45309; }
    .aeh-item-title { font-size:12.5px; font-weight:600; color:#111319; line-height:1.3; }
    .aeh-item-sub { font-size:11px; color:#6b7280; margin-top:1px; }
    .aeh-eye-btn {
        width:28px; height:28px; border-radius:8px; flex-shrink:0; display:flex; align-items:center; justify-content:center;
        color:#6b7280; background:#f3f4f6; transition:background .15s ease, color .15s ease;
    }
    .aeh-eye-btn:hover { background:#e5e7eb; color:#111319; }
    .aeh-froid-btn {
        font-size:11px; font-weight:700; padding:5px 10px; border-radius:8px; background:#1A1A24; color:#fff;
        white-space:nowrap; flex-shrink:0; text-decoration:none;
    }
    .aeh-froid-btn:hover { background:#000; color:#fff; }
    .aeh-empty { font-size:12px; color:#9ca3af; padding:10px 2px; }
</style>
}

<div class="mb-3">
    <a asp-action="Index" asp-route-collaborateurId="@Model.CollaborateurId" class="text-decoration-none small text-muted">
        <i class="fas fa-arrow-left me-1"></i> Retour aux compétences
    </a>
</div>

<div class="row g-3">
    <!-- ── LEFT: Feedback history panel ────────────────────────────────────── -->
    <div class="col-lg-4 order-2 order-lg-1">
        <div class="ey-card aeh-panel p-3">
            <div class="fw-bold text-dark mb-1"><i class="fas fa-clock-rotate-left text-warning me-2"></i>Mon Historique de Feedback Formation</div>
            <div class="small text-muted mb-2">Vos retours sur les formations terminées.</div>

            <div class="aeh-section-title"><i class="fas fa-fire" style="color:#B45309"></i> Évaluations à chaud</div>
            @if (!evalsChaud.Any())
            {
                <div class="aeh-empty">Aucune évaluation à chaud enregistrée pour le moment.</div>
            }
            @foreach (var i in evalsChaud)
            {
                <div class="aeh-item">
                    <div class="aeh-item-icon aeh-item-icon-chaud"><i class="fas fa-graduation-cap"></i></div>
                    <div class="flex-grow-1 min-w-0">
                        <div class="aeh-item-title text-truncate">@(i.Formation?.Titre ?? "Formation")</div>
                        <div class="aeh-item-sub">Note : @i.EvaluationPostFormation!.NoteGlobale/5</div>
                    </div>
                    <a asp-controller="Formations" asp-action="EvaluerFormation" asp-route-inscriptionId="@i.Id"
                       asp-route-returnUrl="@returnUrl" class="aeh-eye-btn" title="Revoir mon évaluation à chaud">
                        <i class="fas fa-eye"></i>
                    </a>
                </div>
            }

            <div class="aeh-section-title"><i class="fas fa-snowflake" style="color:#2563eb"></i> Évaluations à froid</div>
            @if (!evalsFroidEnAttente.Any())
            {
                <div class="aeh-empty">Aucune évaluation à froid en attente.</div>
            }
            @foreach (var i in evalsFroidEnAttente)
            {
                <div class="aeh-item aeh-item-froid">
                    <div class="aeh-item-icon aeh-item-icon-froid"><i class="fas fa-hourglass-half"></i></div>
                    <div class="flex-grow-1 min-w-0">
                        <div class="aeh-item-title text-truncate">@(i.Formation?.Titre ?? "Formation")</div>
                        <div class="aeh-item-sub">À évaluer</div>
                    </div>
                    <a asp-controller="Formations" asp-action="EvaluationSuivi" asp-route-inscriptionId="@i.Id"
                       asp-route-returnUrl="@returnUrl" class="aeh-froid-btn">
                        Remplir
                    </a>
                </div>
            }
        </div>
    </div>

    <!-- ── RIGHT: Self-evaluation form ─────────────────────────────────────── -->
    <div class="col-lg-8 order-1 order-lg-2">
        <div class="ey-card ey-form-shell p-4 ey-interactive-card">
            <div class="text-uppercase small text-muted fw-semibold mb-2">Auto-évaluation collaborateur</div>
            <h1 class="ey-serif-title mb-2">@Model.CompetenceNom</h1>
            <div class="small text-muted mb-4">
                @Model.CollaborateurNom
                @if (!string.IsNullOrWhiteSpace(Model.Poste))
                {
                    <span> · @Model.Poste</span>
                }
                @if (!string.IsNullOrWhiteSpace(Model.Categorie))
                {
                    <span class="badge bg-secondary">@Model.Categorie</span>
                }
            </div>

            <form asp-action="AutoEvaluation" method="post" class="vstack gap-4">
                @Html.AntiForgeryToken()
                <input asp-for="CompetenceId" type="hidden" />
                <input asp-for="CollaborateurId" type="hidden" />
                <input asp-for="CompetenceNom" type="hidden" />
                <input asp-for="CollaborateurNom" type="hidden" />
                <input asp-for="Poste" type="hidden" />
                <input asp-for="Categorie" type="hidden" />

                <div class="row g-3">
                    <div class="col-md-6">
                        <label asp-for="SeuilRh" class="form-label fw-semibold"></label>
                        <input asp-for="SeuilRh" type="range" min="0" max="100" step="5" class="form-range"
                               oninput="document.getElementById('seuilRhValue').innerText = this.value + '%'; updateGap();" />
                        <div class="d-flex justify-content-between small text-muted">
                            <span>0%</span>
                            <span id="seuilRhValue">@Model.SeuilRh%</span>
                            <span>100%</span>
                        </div>
                        <div class="form-text">Valeur RH cible pour cette compétence.</div>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="AutoEvaluationCollaborateur" class="form-label fw-semibold"></label>
                        <input asp-for="AutoEvaluationCollaborateur" type="range" min="0" max="100" step="5" class="form-range"
                               oninput="document.getElementById('autoEvalValue').innerText = this.value + '%'; updateGap();" />
                        <div class="d-flex justify-content-between small text-muted">
                            <span>0%</span>
                            <span id="autoEvalValue">@Model.AutoEvaluationCollaborateur%</span>
                            <span>100%</span>
                        </div>
                        <div class="form-text">Niveau que vous estimez avoir atteint aujourd'hui.</div>
                    </div>
                </div>

                <div class="row g-3">
                    <div class="col-md-4">
                        <div class="ey-card ey-soft-kpi p-3 h-100">
                            <div class="small text-muted">Objectif RH</div>
                            <div class="display-6 fw-bold" id="resumeSeuil">@Model.SeuilRh%</div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="ey-card ey-soft-kpi p-3 h-100">
                            <div class="small text-muted">Votre estimation</div>
                            <div class="display-6 fw-bold" id="resumeAuto">@Model.AutoEvaluationCollaborateur%</div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="ey-card ey-soft-kpi p-3 h-100">
                            <div class="small text-muted">Écart à l'objectif</div>
                            <div class="display-6 fw-bold @(ecartObjectif >= 0 ? "text-success" : "text-danger")" id="resumeGap">
                                @(ecartObjectif >= 0 ? "+" : "")@ecartObjectif%
                            </div>
                        </div>
                    </div>
                </div>

                <div>
                    <label asp-for="CommentaireCollaborateur" class="form-label fw-semibold"></label>
                    <textarea asp-for="CommentaireCollaborateur" rows="4" class="form-control ey-textarea"
                              placeholder="Ex. : j'applique cette compétence sur les missions X/Y, mais j'ai encore besoin d'appui sur..."></textarea>
                    <span asp-validation-for="CommentaireCollaborateur" class="text-danger small"></span>
                </div>

                @if (Model.EvaluationManager.HasValue)
                {
                    <div class="alert alert-secondary mb-0">
                        <div class="fw-semibold mb-1">Dernier avis manager</div>
                        <div class="small">Évaluation manager : <strong>@Model.EvaluationManager.Value%</strong></div>
                        @if (!string.IsNullOrWhiteSpace(Model.CommentaireManager))
                        {
                            <div class="small mt-1">Commentaire : @Model.CommentaireManager</div>
                        }
                    </div>
                }

                <div class="d-flex flex-wrap gap-2">
                    <button type="submit" class="ey-btn-main">Enregistrer mon auto-évaluation</button>
                    <a asp-action="Index" asp-route-collaborateurId="@Model.CollaborateurId" class="ey-btn-ghost text-decoration-none text-center">Annuler</a>
                </div>
            </form>
        </div>
    </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function updateGap() {
            var seuil = parseInt(document.getElementById('SeuilRh').value || '0');
            var autoEval = parseInt(document.getElementById('AutoEvaluationCollaborateur').value || '0');
            var gap = autoEval - seuil;
            document.getElementById('resumeSeuil').innerText = seuil + '%';
            document.getElementById('resumeAuto').innerText = autoEval + '%';
            document.getElementById('resumeGap').innerText = (gap >= 0 ? '+' : '') + gap + '%';
            document.getElementById('resumeGap').className = 'display-6 fw-bold ' + (gap >= 0 ? 'text-success' : 'text-danger');
        }
    </script>
}
