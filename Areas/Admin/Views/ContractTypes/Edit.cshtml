@model SIRH.EY.Models.ContractType
@{ ViewData["Title"] = "Modifier — " + Model.Name; }

<div class="mb-4"><div class="ey-page-kicker">Référentiel RH</div><h1 class="ey-page-title">Modifier le type de contrat</h1></div>

<div class="row"><div class="col-lg-6"><div class="ey-card p-4">
    <form asp-action="Edit" method="post">
        @Html.AntiForgeryToken()
        <input asp-for="Id" type="hidden" />
        <div class="mb-3">
            <label asp-for="Name" class="form-label fw-semibold"></label>
            <input asp-for="Name" class="form-control" /><span asp-validation-for="Name" class="text-danger small"></span>
        </div>
        <div class="mb-3">
            <label asp-for="Code" class="form-label fw-semibold"></label>
            <input asp-for="Code" class="form-control" maxlength="20" />
        </div>
        <div class="mb-3">
            <label asp-for="MaxDurationMonths" class="form-label fw-semibold"></label>
            <input asp-for="MaxDurationMonths" type="number" class="form-control" min="1" max="240" />
            <div class="form-text">Laisser vide pour illimitée.</div>
        </div>
        <div class="mb-3">
            <label asp-for="Description" class="form-label fw-semibold"></label>
            <textarea asp-for="Description" class="form-control" rows="2"></textarea>
        </div>
        <div class="mb-3 text-muted small">
            <i class="fas fa-info-circle me-1"></i>
            Créé @Model.CreatedAt.ToString("dd/MM/yyyy") @(Model.CreatedBy != null ? $"par {Model.CreatedBy}" : "") ·
            @(Model.UpdatedAt.HasValue ? $"Modifié {Model.UpdatedAt:dd/MM/yyyy} par {Model.UpdatedBy}" : "Jamais modifié")
        </div>
        <div class="mb-4"><div class="form-check form-switch">
            <input asp-for="IsActive" class="form-check-input" type="checkbox" /><label asp-for="IsActive" class="form-check-label">Actif</label>
        </div></div>
        <div class="d-flex gap-2">
            <button type="submit" class="ey-btn-main"><i class="fas fa-save me-1"></i> Enregistrer</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Annuler</a>
        </div>
    </form>
</div></div></div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
