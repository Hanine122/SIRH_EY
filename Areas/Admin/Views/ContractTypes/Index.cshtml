@model IEnumerable<SIRH.EY.Models.ContractType>
@{ ViewData["Title"] = "Types de contrat"; }

<div class="d-flex justify-content-between align-items-start mb-4">
    <div>
        <div class="ey-page-kicker">Référentiel RH</div>
        <h1 class="ey-page-title">Types de contrat</h1>
        <p class="ey-page-lead mb-0">@Model.Count() type(s) de contrat enregistré(s).</p>
    </div>
    <a asp-action="Create" class="ey-btn-main text-decoration-none"><i class="fas fa-plus me-1"></i> Nouveau</a>
</div>

@if (TempData["Success"] != null) { <div class="alert alert-success alert-dismissible fade show"><i class="fas fa-check-circle me-1"></i>@TempData["Success"]<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div> }
@if (TempData["Error"] != null)   { <div class="alert alert-danger alert-dismissible fade show"><i class="fas fa-exclamation-triangle me-1"></i>@TempData["Error"]<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div> }

<div class="ey-card p-3 mb-3">
    <form method="get" class="row g-2">
        <div class="col-md-5"><input name="search" class="form-control" placeholder="Rechercher..." value="@ViewBag.Search" /></div>
        <div class="col-md-2"><button type="submit" class="btn btn-outline-secondary w-100"><i class="fas fa-search me-1"></i>Filtrer</button></div>
    </form>
</div>

<div class="ey-card">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Libellé</th><th>Code</th><th>Durée max</th><th>Créé par</th><th>Modifié le</th><th>Statut</th><th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var ct in Model)
                {
                    <tr>
                        <td class="fw-semibold">@ct.Name</td>
                        <td><code class="text-muted">@(ct.Code ?? "—")</code></td>
                        <td class="text-muted small">@(ct.MaxDurationMonths.HasValue ? $"{ct.MaxDurationMonths} mois" : "Illimitée (CDI)")</td>
                        <td class="text-muted small">@(ct.CreatedBy ?? "—")</td>
                        <td class="text-muted small">@(ct.UpdatedAt?.ToString("dd/MM/yyyy") ?? ct.CreatedAt.ToString("dd/MM/yyyy"))</td>
                        <td>
                            @if (ct.IsActive) { <span class="badge bg-success bg-opacity-10 text-success">Actif</span> }
                            else              { <span class="badge bg-secondary bg-opacity-10 text-secondary">Inactif</span> }
                        </td>
                        <td class="text-end">
                            <a asp-action="Edit" asp-route-id="@ct.Id" class="btn btn-sm btn-outline-secondary me-1"><i class="fas fa-pen"></i></a>
                            <form asp-action="ToggleActive" asp-route-id="@ct.Id" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm @(ct.IsActive ? "btn-outline-warning" : "btn-outline-success")">
                                    <i class="fas @(ct.IsActive ? "fa-toggle-on" : "fa-toggle-off")"></i>
                                </button>
                            </form>
                            <form asp-action="Delete" asp-route-id="@ct.Id" method="post" class="d-inline" onsubmit="return confirm('Supprimer « @ct.Name » ?')">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-outline-danger ms-1"><i class="fas fa-trash"></i></button>
                            </form>
                        </td>
                    </tr>
                }
                @if (!Model.Any()) { <tr><td colspan="7" class="text-center text-muted py-4"><i class="fas fa-inbox fa-2x mb-2 d-block opacity-25"></i>Aucun type de contrat trouvé.</td></tr> }
            </tbody>
        </table>
    </div>
</div>
