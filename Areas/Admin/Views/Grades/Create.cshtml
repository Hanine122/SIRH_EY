@model SIRH.EY.Models.GradeEntity
@{
    ViewData["Title"] = "Nouveau grade";
}

<div class="mb-4">
    <div class="ey-page-kicker">Référentiel RH</div>
    <h1 class="ey-page-title">Nouveau grade</h1>
</div>

<div class="row">
    <div class="col-lg-5">
        <div class="ey-card p-4">
            <form asp-action="Create" method="post">
                @Html.AntiForgeryToken()
                <div class="mb-3">
                    <label asp-for="Name" class="form-label fw-semibold"></label>
                    <input asp-for="Name" class="form-control" placeholder="ex: Senior Manager" />
                    <span asp-validation-for="Name" class="text-danger small"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Level" class="form-label fw-semibold"></label>
                    <input asp-for="Level" type="number" class="form-control" min="1" max="10" />
                    <div class="form-text">1 = Junior · 6 = Partner</div>
                    <span asp-validation-for="Level" class="text-danger small"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Description" class="form-label fw-semibold"></label>
                    <textarea asp-for="Description" class="form-control" rows="2"></textarea>
                </div>
                <div class="mb-4">
                    <div class="form-check form-switch">
                        <input asp-for="IsActive" class="form-check-input" type="checkbox" checked />
                        <label asp-for="IsActive" class="form-check-label">Actif</label>
                    </div>
                </div>
                <div class="d-flex gap-2">
                    <button type="submit" class="ey-btn-main"><i class="fas fa-save me-1"></i> Enregistrer</button>
                    <a asp-action="Index" class="btn btn-outline-secondary">Annuler</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
