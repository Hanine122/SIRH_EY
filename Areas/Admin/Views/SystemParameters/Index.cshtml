@model IEnumerable<SIRH.EY.Models.SystemParameter>
@{
    ViewData["Title"] = "Paramètres système";
}

<div class="d-flex justify-content-between align-items-start mb-4">
    <div>
        <div class="ey-page-kicker">Administration IT</div>
        <h1 class="ey-page-title">Paramètres système</h1>
        <p class="ey-page-lead mb-0">@Model.Count() paramètre(s) configuré(s).</p>
    </div>
    <a asp-action="Create" class="ey-btn-main text-decoration-none"><i class="fas fa-plus me-1"></i> Nouveau</a>
</div>

@if (TempData["Success"] != null) { <div class="alert alert-success alert-dismissible fade show"><i class="fas fa-check-circle me-1"></i>@TempData["Success"]<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div> }
@if (TempData["Error"] != null) { <div class="alert alert-danger alert-dismissible fade show"><i class="fas fa-exclamation-triangle me-1"></i>@TempData["Error"]<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div> }

<div class="ey-card p-3 mb-3">
    <form method="get" class="row g-2 align-items-end">
        <div class="col-md-4">
            <input name="search" class="form-control" placeholder="Rechercher par clé ou valeur..." value="@ViewBag.Search" />
        </div>
        <div class="col-md-3">
            <select name="category" class="form-select">
                <option value="">Toutes les catégories</option>
                @foreach (var cat in (ViewBag.Categories as List<string> ?? new List<string>()))
                {
                    <option value="@cat" selected="@(cat == ViewBag.Category ? "selected" : null)">@cat</option>
                }
            </select>
        </div>
        <div class="col-md-2">
            <button type="submit" class="btn btn-outline-secondary w-100"><i class="fas fa-search me-1"></i>Filtrer</button>
        </div>
    </form>
</div>

<div class="ey-card">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Catégorie</th>
                    <th>Clé</th>
                    <th>Valeur</th>
                    <th>Description</th>
                    <th>Modifié par</th>
                    <th>Modifiable</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var p in Model)
                {
                    <tr>
                        <td>
                            @if (p.Category != null)
                            {
                                <span class="badge bg-info bg-opacity-10 text-info">@p.Category</span>
                            }
                        </td>
                        <td><code class="fw-semibold">@p.Key</code></td>
                        <td>
                            @if (string.IsNullOrEmpty(p.Value))
                            {
                                <span class="text-muted fst-italic">vide</span>
                            }
                            else
                            {
                                <span class="text-truncate d-inline-block" style="max-width:180px" title="@p.Value">@p.Value</span>
                            }
                        </td>
                        <td class="text-muted small">@(p.Description ?? "—")</td>
                        <td class="text-muted small">@(p.ModifiedBy ?? "—")</td>
                        <td>
                            @if (p.IsEditable)
                            {
                                <span class="badge bg-success bg-opacity-10 text-success"><i class="fas fa-lock-open me-1"></i>Oui</span>
                            }
                            else
                            {
                                <span class="badge bg-danger bg-opacity-10 text-danger"><i class="fas fa-lock me-1"></i>Lecture seule</span>
                            }
                        </td>
                        <td class="text-end">
                            @if (p.IsEditable)
                            {
                                <a asp-action="Edit" asp-route-id="@p.Id" class="btn btn-sm btn-outline-secondary me-1"><i class="fas fa-pen"></i></a>
                                <form asp-action="Delete" asp-route-id="@p.Id" method="post" class="d-inline"
                                      onsubmit="return confirm('Supprimer le paramètre « @p.Key » ?')">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-outline-danger"><i class="fas fa-trash"></i></button>
                                </form>
                            }
                            else
                            {
                                <span class="text-muted small"><i class="fas fa-lock"></i></span>
                            }
                        </td>
                    </tr>
                }
                @if (!Model.Any()) { <tr><td colspan="7" class="text-center text-muted py-4"><i class="fas fa-inbox fa-2x mb-2 d-block opacity-25"></i>Aucun paramètre trouvé.</td></tr> }
            </tbody>
        </table>
    </div>
</div>
