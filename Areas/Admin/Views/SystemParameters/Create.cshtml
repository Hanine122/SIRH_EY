@model SIRH.EY.Models.SystemParameter
@{ ViewData["Title"] = "Nouveau paramètre"; }

<div class="mb-4"><div class="ey-page-kicker">Administration IT</div><h1 class="ey-page-title">Nouveau paramètre système</h1></div>

<div class="row"><div class="col-lg-6"><div class="ey-card p-4">
    <form asp-action="Create" method="post">
        @Html.AntiForgeryToken()
        <div class="mb-3">
            <label asp-for="Key" class="form-label fw-semibold"></label>
            <input asp-for="Key" class="form-control font-monospace" placeholder="ex: HR.MaxFormations" />
            <span asp-validation-for="Key" class="text-danger small"></span>
        </div>
        <div class="mb-3">
            <label asp-for="Value" class="form-label fw-semibold"></label>
            <input asp-for="Value" class="form-control" />
            <span asp-validation-for="Value" class="text-danger small"></span>
        </div>
        <div class="mb-3">
            <label asp-for="Category" class="form-label fw-semibold"></label>
            <input asp-for="Category" class="form-control" list="cat-list" placeholder="ex: Formation" />
            <datalist id="cat-list">
                @foreach (var cat in (ViewBag.Categories as List<string> ?? new List<string>()))
                {
                    <option value="@cat"></option>
                }
            </datalist>
        </div>
        <div class="mb-3">
            <label asp-for="Description" class="form-label fw-semibold"></label>
            <textarea asp-for="Description" class="form-control" rows="2"></textarea>
        </div>
        <div class="mb-3 d-flex gap-4">
            <div class="form-check form-switch">
                <input asp-for="IsVisible" class="form-check-input" type="checkbox" checked /><label asp-for="IsVisible" class="form-check-label">Visible</label>
            </div>
            <div class="form-check form-switch">
                <input asp-for="IsEditable" class="form-check-input" type="checkbox" checked /><label asp-for="IsEditable" class="form-check-label">Modifiable</label>
            </div>
        </div>
        <div class="d-flex gap-2">
            <button type="submit" class="ey-btn-main"><i class="fas fa-save me-1"></i> Enregistrer</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Annuler</a>
        </div>
    </form>
</div></div></div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
