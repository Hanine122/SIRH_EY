@model SIRH.EY.Models.SystemParameter
@{ ViewData["Title"] = "Modifier — " + Model.Key; }

<div class="mb-4"><div class="ey-page-kicker">Administration IT</div><h1 class="ey-page-title">Modifier le paramètre</h1></div>

<div class="row"><div class="col-lg-6"><div class="ey-card p-4">
    <form asp-action="Edit" method="post">
        @Html.AntiForgeryToken()
        <input asp-for="Id" type="hidden" />
        <div class="mb-3">
            <label class="form-label fw-semibold">Clé</label>
            <input value="@Model.Key" class="form-control font-monospace bg-light" readonly />
            <div class="form-text">La clé d'un paramètre ne peut pas être modifiée.</div>
        </div>
        <div class="mb-3">
            <label asp-for="Value" class="form-label fw-semibold"></label>
            <input asp-for="Value" class="form-control" /><span asp-validation-for="Value" class="text-danger small"></span>
        </div>
        <div class="mb-3">
            <label asp-for="Category" class="form-label fw-semibold"></label>
            <input asp-for="Category" class="form-control" />
        </div>
        <div class="mb-3">
            <label asp-for="Description" class="form-label fw-semibold"></label>
            <textarea asp-for="Description" class="form-control" rows="2"></textarea>
        </div>
        <div class="mb-3 d-flex gap-4">
            <div class="form-check form-switch">
                <input asp-for="IsVisible" class="form-check-input" type="checkbox" /><label asp-for="IsVisible" class="form-check-label">Visible</label>
            </div>
            <div class="form-check form-switch">
                <input asp-for="IsEditable" class="form-check-input" type="checkbox" /><label asp-for="IsEditable" class="form-check-label">Modifiable</label>
            </div>
        </div>
        <div class="mb-3 text-muted small">
            <i class="fas fa-info-circle me-1"></i>
            Dernière modification : @Model.ModifiedDate.ToString("dd/MM/yyyy HH:mm") @(Model.ModifiedBy != null ? $"par {Model.ModifiedBy}" : "")
        </div>
        <div class="d-flex gap-2">
            <button type="submit" class="ey-btn-main"><i class="fas fa-save me-1"></i> Enregistrer</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Annuler</a>
        </div>
    </form>
</div></div></div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
