@{
    ViewData["Title"] = "Administration IT";
}

<div class="d-flex justify-content-between align-items-start mb-4">
    <div>
        <div class="ey-page-kicker">Espace Administrateur</div>
        <h1 class="ey-page-title">Administration IT</h1>
        <p class="ey-page-lead mb-0">Gestion du référentiel RH et des paramètres système.</p>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-sm-6 col-lg-3">
        <a asp-area="Admin" asp-controller="Departments" asp-action="Index" class="text-decoration-none">
            <div class="ey-card p-4 h-100 admin-stat-card">
                <div class="d-flex align-items-center gap-3">
                    <div class="admin-stat-icon bg-warning bg-opacity-10 text-warning">
                        <i class="fas fa-sitemap"></i>
                    </div>
                    <div>
                        <div class="fs-2 fw-bold">@ViewBag.DepartmentCount</div>
                        <div class="text-muted small">Départements</div>
                    </div>
                </div>
            </div>
        </a>
    </div>
    <div class="col-sm-6 col-lg-3">
        <a asp-area="Admin" asp-controller="SubDepartments" asp-action="Index" class="text-decoration-none">
            <div class="ey-card p-4 h-100 admin-stat-card">
                <div class="d-flex align-items-center gap-3">
                    <div class="admin-stat-icon bg-info bg-opacity-10 text-info">
                        <i class="fas fa-layer-group"></i>
                    </div>
                    <div>
                        <div class="fs-2 fw-bold">@ViewBag.SubDepartmentCount</div>
                        <div class="text-muted small">Sous-départements</div>
                    </div>
                </div>
            </div>
        </a>
    </div>
    <div class="col-sm-6 col-lg-3">
        <a asp-area="Admin" asp-controller="Positions" asp-action="Index" class="text-decoration-none">
            <div class="ey-card p-4 h-100 admin-stat-card">
                <div class="d-flex align-items-center gap-3">
                    <div class="admin-stat-icon bg-primary bg-opacity-10 text-primary">
                        <i class="fas fa-briefcase"></i>
                    </div>
                    <div>
                        <div class="fs-2 fw-bold">@ViewBag.PositionCount</div>
                        <div class="text-muted small">Postes</div>
                    </div>
                </div>
            </div>
        </a>
    </div>
    <div class="col-sm-6 col-lg-3">
        <a asp-area="Admin" asp-controller="Grades" asp-action="Index" class="text-decoration-none">
            <div class="ey-card p-4 h-100 admin-stat-card">
                <div class="d-flex align-items-center gap-3">
                    <div class="admin-stat-icon bg-success bg-opacity-10 text-success">
                        <i class="fas fa-medal"></i>
                    </div>
                    <div>
                        <div class="fs-2 fw-bold">@ViewBag.GradeCount</div>
                        <div class="text-muted small">Grades</div>
                    </div>
                </div>
            </div>
        </a>
    </div>
    <div class="col-sm-6 col-lg-3">
        <a asp-area="Admin" asp-controller="BusinessUnits" asp-action="Index" class="text-decoration-none">
            <div class="ey-card p-4 h-100 admin-stat-card">
                <div class="d-flex align-items-center gap-3">
                    <div class="admin-stat-icon bg-danger bg-opacity-10 text-danger">
                        <i class="fas fa-building"></i>
                    </div>
                    <div>
                        <div class="fs-2 fw-bold">@ViewBag.BusinessUnitCount</div>
                        <div class="text-muted small">Business Units</div>
                    </div>
                </div>
            </div>
        </a>
    </div>
    <div class="col-sm-6 col-lg-3">
        <a asp-area="Admin" asp-controller="Locations" asp-action="Index" class="text-decoration-none">
            <div class="ey-card p-4 h-100 admin-stat-card">
                <div class="d-flex align-items-center gap-3">
                    <div class="admin-stat-icon bg-secondary bg-opacity-10 text-secondary">
                        <i class="fas fa-map-marker-alt"></i>
                    </div>
                    <div>
                        <div class="fs-2 fw-bold">@ViewBag.LocationCount</div>
                        <div class="text-muted small">Localisations</div>
                    </div>
                </div>
            </div>
        </a>
    </div>
    <div class="col-sm-6 col-lg-3">
        <a asp-area="Admin" asp-controller="SystemParameters" asp-action="Index" class="text-decoration-none">
            <div class="ey-card p-4 h-100 admin-stat-card">
                <div class="d-flex align-items-center gap-3">
                    <div class="admin-stat-icon bg-dark bg-opacity-10 text-dark">
                        <i class="fas fa-sliders-h"></i>
                    </div>
                    <div>
                        <div class="fs-2 fw-bold">@ViewBag.ParameterCount</div>
                        <div class="text-muted small">Paramètres</div>
                    </div>
                </div>
            </div>
        </a>
    </div>
    <div class="col-sm-6 col-lg-3">
        <div class="ey-card p-4 h-100 admin-stat-card">
            <div class="d-flex align-items-center gap-3">
                <div class="admin-stat-icon bg-warning bg-opacity-25 text-warning">
                    <i class="fas fa-users"></i>
                </div>
                <div>
                    <div class="fs-2 fw-bold">@ViewBag.CollaborateurCount</div>
                    <div class="text-muted small">Collaborateurs actifs</div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row g-3">
    <div class="col-lg-6">
        <div class="ey-card p-4">
            <h5 class="fw-semibold mb-3"><i class="fas fa-book-open me-2 text-warning"></i>Référentiel organisationnel</h5>
            <div class="list-group list-group-flush">
                <a asp-area="Admin" asp-controller="Departments" asp-action="Index" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center py-2">
                    <span><i class="fas fa-sitemap me-2 text-muted"></i>Départements</span>
                    <i class="fas fa-chevron-right text-muted small"></i>
                </a>
                <a asp-area="Admin" asp-controller="SubDepartments" asp-action="Index" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center py-2">
                    <span><i class="fas fa-layer-group me-2 text-muted"></i>Sous-départements</span>
                    <i class="fas fa-chevron-right text-muted small"></i>
                </a>
                <a asp-area="Admin" asp-controller="Positions" asp-action="Index" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center py-2">
                    <span><i class="fas fa-briefcase me-2 text-muted"></i>Postes</span>
                    <i class="fas fa-chevron-right text-muted small"></i>
                </a>
                <a asp-area="Admin" asp-controller="Grades" asp-action="Index" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center py-2">
                    <span><i class="fas fa-medal me-2 text-muted"></i>Grades</span>
                    <i class="fas fa-chevron-right text-muted small"></i>
                </a>
                <a asp-area="Admin" asp-controller="BusinessUnits" asp-action="Index" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center py-2">
                    <span><i class="fas fa-building me-2 text-muted"></i>Business Units</span>
                    <i class="fas fa-chevron-right text-muted small"></i>
                </a>
                <a asp-area="Admin" asp-controller="Locations" asp-action="Index" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center py-2">
                    <span><i class="fas fa-map-marker-alt me-2 text-muted"></i>Localisations</span>
                    <i class="fas fa-chevron-right text-muted small"></i>
                </a>
            </div>
        </div>
    </div>
    <div class="col-lg-6">
        <div class="ey-card p-4">
            <h5 class="fw-semibold mb-3"><i class="fas fa-cogs me-2 text-warning"></i>Paramètres système</h5>
            <p class="text-muted small mb-3">Configurez les paramètres globaux de l'application SIRH.</p>
            <a asp-area="Admin" asp-controller="SystemParameters" asp-action="Index" class="ey-btn-main text-decoration-none">
                <i class="fas fa-sliders-h me-1"></i> Gérer les paramètres
            </a>
        </div>
    </div>
</div>

@section Styles {
<style>
.admin-stat-card { transition: box-shadow .15s; }
.admin-stat-card:hover { box-shadow: 0 4px 16px rgba(0,0,0,.1); }
.admin-stat-icon { width: 48px; height: 48px; border-radius: 12px; display: flex; align-items: center; justify-content: center; font-size: 1.25rem; flex-shrink: 0; }
</style>
}
