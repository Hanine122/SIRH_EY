@model IEnumerable<SIRH.EY.Models.Department>
@{
    ViewData["Title"] = "Départements";
}

<div class="d-flex justify-content-between align-items-start mb-4">
    <div>
        <div class="ey-page-kicker">Référentiel RH</div>
        <h1 class="ey-page-title">Départements</h1>
        <p class="ey-page-lead mb-0">@Model.Count() département(s) enregistré(s).</p>
    </div>
    <a asp-action="Create" class="ey-btn-main text-decoration-none">
        <i class="fas fa-plus me-1"></i> Nouveau département
    </a>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show"><i class="fas fa-check-circle me-1"></i>@TempData["Success"]<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show"><i class="fas fa-exclamation-triangle me-1"></i>@TempData["Error"]<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
}

<div class="ey-card p-3 mb-3">
    <form method="get" class="row g-2 align-items-end">
        <div class="col-md-6">
            <input name="search" class="form-control" placeholder="Rechercher par nom ou code..." value="@ViewBag.Search" />
        </div>
        <div class="col-md-3">
            <button type="submit" class="btn btn-outline-secondary w-100"><i class="fas fa-search me-1"></i>Filtrer</button>
        </div>
        @if (!string.IsNullOrEmpty(ViewBag.Search as string))
        {
            <div class="col-md-3">
                <a asp-action="Index" class="btn btn-link w-100">Réinitialiser</a>
            </div>
        }
    </form>
</div>

<div class="ey-card">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Nom</th>
                    <th>Code</th>
                    <th>Sous-depts</th>
                    <th>Statut</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var dept in Model)
                {
                    <tr>
                        <td class="fw-semibold">@dept.Name</td>
                        <td><code class="text-muted">@(dept.Code ?? "—")</code></td>
                        <td>
                            <span class="badge bg-secondary bg-opacity-10 text-secondary">@dept.SubDepartments.Count</span>
                        </td>
                        <td>
                            @if (dept.IsActive)
                            {
                                <span class="badge bg-success bg-opacity-10 text-success"><i class="fas fa-circle me-1" style="font-size:.5rem;vertical-align:middle"></i>Actif</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary bg-opacity-10 text-secondary"><i class="fas fa-circle me-1" style="font-size:.5rem;vertical-align:middle"></i>Inactif</span>
                            }
                        </td>
                        <td class="text-end">
                            <a asp-action="Edit" asp-route-id="@dept.Id" class="btn btn-sm btn-outline-secondary me-1" title="Modifier">
                                <i class="fas fa-pen"></i>
                            </a>
                            <form asp-action="ToggleActive" asp-route-id="@dept.Id" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm @(dept.IsActive ? "btn-outline-warning" : "btn-outline-success")" title="@(dept.IsActive ? "Désactiver" : "Activer")">
                                    <i class="fas @(dept.IsActive ? "fa-toggle-on" : "fa-toggle-off")"></i>
                                </button>
                            </form>
                            <form asp-action="Delete" asp-route-id="@dept.Id" method="post" class="d-inline"
                                  onsubmit="return confirm('Supprimer le département « @dept.Name » ?')">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-outline-danger ms-1" title="Supprimer">
                                    <i class="fas fa-trash"></i>
                                </button>
                            </form>
                        </td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="5" class="text-center text-muted py-4">
                            <i class="fas fa-inbox fa-2x mb-2 d-block opacity-25"></i>
                            Aucun département trouvé.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
